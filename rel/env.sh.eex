#!/bin/sh
# Sourced by bin/<%= @release.name %> before every command (ADR 0036).
#
# Releases are built in CI and published, so the cookie `mix release` writes
# into releases/COOKIE is public. Erlang distribution runs only with a cookie
# the server provides (RELEASE_COOKIE; Ansible generates one per server), and
# only on 127.0.0.1.

# A fixed node name on the loopback address, so `remote` and `rpc` reach the
# node on 127.0.0.1 whatever the host name resolves to.
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_DISTRIBUTION
RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@127.0.0.1}"
export RELEASE_NODE

# An epmd this release starts listens on loopback only. (vm.args and
# remote.vm.args bind the distribution port itself to 127.0.0.1.)
ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
export ERL_EPMD_ADDRESS

# Every command that joins the distribution needs a cookie of the server's
# own. `eval` and `version` start no distribution and need none, so the
# deploy's migrations and pre-deploy dump are unaffected.
case $RELEASE_COMMAND in
  start | start_iex | daemon | daemon_iex | remote | rpc | restart | stop | pid)
    if [ "$RELEASE_DISTRIBUTION" != none ]; then
      public_cookie="$(cat "$RELEASE_ROOT/releases/COOKIE" 2>/dev/null || true)"

      if [ -z "${RELEASE_COOKIE:-}" ] || [ "$RELEASE_COOKIE" = "$public_cookie" ]; then
        echo "ERROR: RELEASE_COOKIE must be set to this server's own secret cookie." >&2
        echo "The cookie in releases/COOKIE is published with the release and is not a secret." >&2
        echo "Set RELEASE_COOKIE in the environment file (Ansible generates one per server)," >&2
        echo "or set RELEASE_DISTRIBUTION=none to run without Erlang distribution." >&2
        exit 1
      fi
    fi
    ;;
esac
