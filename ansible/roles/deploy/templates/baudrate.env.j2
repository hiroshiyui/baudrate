# {{ ansible_managed }}
# Baudrate runtime environment — loaded by systemd EnvironmentFile
DATABASE_URL=ecto://{{ postgres_db_user }}:{{ postgres_db_password }}@localhost/{{ postgres_db_name }}
SECRET_KEY_BASE={{ secret_key_base }}
PHX_HOST={{ domain }}
PHX_SERVER=true
DATABASE_SSL=false
PORT={{ app_port }}
POOL_SIZE={{ pool_size | default(10) }}
{% if installation_key is defined and installation_key %}
INSTALLATION_KEY={{ installation_key }}
{% endif %}
{% if trusted_proxies is defined and trusted_proxies %}
# Reverse proxies whose x-forwarded-for may be believed. Defaults to loopback
# only; set this when nginx does not run on the same host as the app.
BAUDRATE_TRUSTED_PROXIES={{ trusted_proxies | join(',') }}
{% endif %}
