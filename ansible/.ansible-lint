# Phase 8A. CI runs ansible-lint from Debian trixie in the CI image
# (ci/image/Dockerfile), with the vars plugin limited to host_group_vars so the
# SOPS-encrypted secrets are never opened.
profile: production
offline: true
# The roles are this project's own, run only from its playbooks, and their
# registered variables read as plain names (`health_check`, `release_timestamp`).
# Prefixing every one with the role name is churn without a reader; the rule
# exists for roles shared between projects.
skip_list:
  - var-naming[no-role-prefix]
