<div id="article-history-page" class="article-history-page mx-auto max-w-2xl">
  <nav
    id="article-history-breadcrumb"
    class="article-history-breadcrumb mb-4"
    aria-label={gettext("Breadcrumb")}
  >
    <.link
      id="article-history-back-link"
      navigate={~p"/articles/#{@article.slug}"}
      class="article-history-back-link text-sm text-base-content/70 hover:text-base-content"
    >
      &larr; {gettext("Back to article")}
    </.link>
  </nav>

  <h1 id="article-history-heading" class="article-history-heading text-2xl font-bold mb-1">
    {gettext("Edit History")}
  </h1>
  <p class="article-history-title text-sm text-base-content/70 mb-6 break-words">
    {@article.title}
  </p>

  <div :if={@revisions == []} class="article-history-empty text-base-content/70 text-center py-8">
    {gettext("No edit history available.")}
  </div>

  <div
    :if={@revisions != []}
    id="article-revisions"
    class="article-history-revisions space-y-6"
    data-focus-target
  >
    <%!-- Revision list --%>
    <div class="overflow-x-auto">
      <table
        id="article-history-table"
        class="article-history-table table table-sm"
        aria-label={gettext("Revision list")}
      >
        <thead>
          <tr>
            <th scope="col">{gettext("Version")}</th>
            <th scope="col">{gettext("Editor")}</th>
            <th scope="col">{gettext("Date")}</th>
            <th scope="col">
              <span class="article-history-actions-label sr-only">{gettext("Actions")}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <%= for {revision, index} <- Enum.with_index(@revisions) do %>
            <tr
              id={"article-history-revision-#{revision.id}"}
              class={["article-history-revision-row", @selected_index == index && "bg-base-200"]}
              aria-current={@selected_index == index && "true"}
            >
              <td>{"##{length(@revisions) - index}"}</td>
              <td>
                <span :if={revision.editor}>
                  <.link
                    navigate={~p"/users/#{revision.editor.username}"}
                    class="article-history-editor-link link link-hover"
                  >
                    {display_name(revision.editor)}
                  </.link>
                </span>
                <span :if={!revision.editor} class="text-base-content/70">
                  {gettext("Unknown")}
                </span>
              </td>
              <td>
                <time datetime={datetime_attr(revision.inserted_at)}>
                  {format_datetime(revision.inserted_at)}
                </time>
              </td>
              <td>
                <button
                  id={"article-history-select-#{revision.id}"}
                  phx-click="select_revision"
                  phx-value-index={index}
                  aria-label={
                    gettext("View version #%{number}", number: length(@revisions) - index)
                  }
                  class={[
                    "article-history-select btn btn-xs",
                    if(@selected_index == index, do: "btn-primary", else: "btn-ghost")
                  ]}
                >
                  {gettext("View")}
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%!-- Diff display --%>
    <div :if={@selected_index != nil} id="revision-diff" class="article-history-diff space-y-4">
      <% selected = Enum.at(@revisions, @selected_index) %>
      <% previous = get_previous_revision(@revisions, @selected_index) %>

      <h2 class="article-history-diff-heading text-lg font-semibold">
        {gettext("Version #%{number}", number: length(@revisions) - @selected_index)}
        <span :if={selected.editor} class="font-normal text-sm text-base-content/70">
          {gettext("by %{editor}", editor: display_name(selected.editor))}
        </span>
      </h2>

      <%!-- Title diff --%>
      <div id="article-history-title-diff" class="article-history-title-diff">
        <h3 class="text-sm font-semibold mb-1">{gettext("Title")}</h3>
        <div class="bg-base-200 rounded-lg p-3 font-mono text-sm overflow-x-auto">
          <%= if previous do %>
            <%= for {tag, text} <- compute_diff(previous.title, selected.title) do %>
              <span :if={tag == :eq}>{text}</span>
              <ins
                :if={tag == :ins}
                class="article-history-diff-ins bg-success/30 text-success-content"
              ><span class="article-history-diff-ins-label sr-only">{gettext("Added:")} </span>{text}</ins>
              <del
                :if={tag == :del}
                class="article-history-diff-del bg-error/30 text-error-content"
              ><span class="article-history-diff-del-label sr-only">{gettext("Removed:")} </span>{text}</del>
            <% end %>
          <% else %>
            {selected.title}
          <% end %>
        </div>
      </div>

      <%!-- Body diff --%>
      <div id="article-history-body-diff" class="article-history-body-diff">
        <h3 class="text-sm font-semibold mb-1">{gettext("Body")}</h3>
        <div class="bg-base-200 rounded-lg p-3 font-mono text-sm overflow-x-auto whitespace-pre-wrap break-words max-h-96 overflow-y-auto">
          <%= if previous do %>
            <%= for {tag, text} <- compute_diff(previous.body, selected.body) do %>
              <span :if={tag == :eq}>{text}</span>
              <ins
                :if={tag == :ins}
                class="article-history-diff-ins bg-success/30 text-success-content"
              ><span class="article-history-diff-ins-label sr-only">{gettext("Added:")} </span>{text}</ins>
              <del
                :if={tag == :del}
                class="article-history-diff-del bg-error/30 text-error-content"
              ><span class="article-history-diff-del-label sr-only">{gettext("Removed:")} </span>{text}</del>
            <% end %>
          <% else %>
            {selected.body}
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
