<div id="article-new-page" class="article-new-page mx-auto max-w-4xl">
  <nav
    id="article-new-breadcrumb"
    class="article-new-breadcrumb mb-4"
    aria-label={gettext("Breadcrumb")}
  >
    <.link
      :if={@board_slug}
      id="article-new-back-board"
      navigate={~p"/boards/#{@board_slug}"}
      class="article-new-back-link text-sm text-base-content/70 hover:text-base-content"
    >
      <span aria-hidden="true">&larr;</span> {gettext("Back to board")}
    </.link>
    <.link
      :if={!@board_slug}
      id="article-new-back-boards"
      navigate={~p"/"}
      class="article-new-back-link text-sm text-base-content/70 hover:text-base-content"
    >
      <span aria-hidden="true">&larr;</span> {gettext("Boards")}
    </.link>
  </nav>

  <h1 id="article-new-heading" class="article-new-heading text-2xl font-bold mb-6">
    {gettext("Create Article")}
  </h1>

  <div
    :if={@draft_restored}
    id="article-new-draft-restored"
    class="article-new-draft-restored alert alert-info mb-4"
    role="status"
  >
    <span>
      {gettext("Picked up where you left off. This draft is saved to your account.")}
    </span>
    <.link navigate={~p"/drafts"} class="article-new-drafts-link link">
      {gettext("All drafts")}
    </.link>
  </div>

  <div
    :if={@draft_quota_reached}
    id="article-new-draft-limit"
    class="article-new-draft-limit alert alert-warning mb-4"
    role="status"
  >
    <span>
      {gettext(
        "You are keeping %{limit} drafts, which is the most your account can hold, so this one is not being saved to your account. It is still saved in this browser. Delete one to make room.",
        limit: @max_drafts_allowed
      )}
    </span>
    <.link navigate={~p"/drafts"} class="article-new-drafts-link link">
      {gettext("All drafts")}
    </.link>
  </div>

  <.form
    for={@form}
    phx-change="validate"
    phx-submit="submit"
    id="article-new-form"
    phx-hook="DraftSaveHook"
    data-draft-key={"draft:u#{@current_user.id}:article:new"}
    data-draft-fields="article[title],article[body]"
    data-draft-indicator="#draft-indicator-new"
    data-draft-saved-text={gettext("Draft saved")}
    data-draft-restored-text={gettext("Draft restored")}
    class="article-new-form space-y-6"
  >
    <.input
      field={@form[:title]}
      label={gettext("Title")}
      label_class="text-lg font-semibold"
      required
    />

    <.input
      field={@form[:body]}
      type="textarea"
      label={gettext("Body")}
      label_class="text-lg font-semibold"
      rows="12"
      toolbar
      required
    />

    <%!-- Attachments toolbar --%>
    <div
      id="article-new-attachments-toolbar"
      class="article-new-attachments-toolbar flex items-center gap-1"
    >
      <.live_file_input
        upload={@uploads.article_images}
        class="article-new-image-input sr-only peer"
      />
      <label
        :if={length(@uploaded_images) < 4}
        id="article-new-add-images"
        for={@uploads.article_images.ref}
        class="article-new-add-images btn btn-sm btn-ghost gap-1 cursor-pointer peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary"
      >
        <.icon name="hero-photo" class="size-5" />
        {gettext("Add Images")}
      </label>
      <button
        id="article-new-toggle-poll"
        type="button"
        phx-click="toggle_poll"
        aria-expanded={to_string(@poll_enabled)}
        aria-controls="article-poll-section"
        class={[
          "article-new-toggle-poll btn btn-sm",
          (@poll_enabled && "btn-error btn-outline") || "btn-ghost"
        ]}
      >
        <.icon name="hero-chart-bar" class="size-4" />
        {if @poll_enabled, do: gettext("Remove Poll"), else: gettext("Add Poll")}
      </button>
    </div>

    <%!-- Image Upload Section --%>
    <div id="article-images-section" class="article-new-images-section">
      <%!-- Uploaded image thumbnails --%>
      <div :if={@uploaded_images != []} class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3">
        <div
          :for={img <- @uploaded_images}
          id={"article-new-image-#{img.id}"}
          class="article-new-image"
        >
          <div class="relative group aspect-square">
            <img
              src={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
              class="w-full h-full object-cover rounded-lg border border-base-300"
              loading="lazy"
              alt={img.alt || gettext("Uploaded image")}
            />
            <button
              type="button"
              phx-click="remove_image"
              phx-value-id={img.id}
              class="article-new-remove-image absolute top-1 right-1 btn btn-circle btn-error min-h-[44px] min-w-[44px] opacity-80 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100 sm:focus-visible:opacity-100 transition-opacity"
              aria-label={gettext("Remove image")}
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          </div>
          <.image_alt_input image={img} />
        </div>
      </div>

      <%!-- Upload progress & errors --%>
      <div
        :for={entry <- @uploads.article_images.entries}
        class="flex items-center gap-2 text-sm"
      >
        <span class="truncate max-w-48">{entry.client_name}</span>
        <progress
          value={entry.progress}
          max="100"
          class="progress progress-primary w-24"
          aria-label={gettext("Upload progress: %{percent}%", percent: entry.progress)}
          aria-valuenow={entry.progress}
          aria-valuemin="0"
          aria-valuemax="100"
        >
          {entry.progress}%
        </progress>
        <button
          type="button"
          phx-click="cancel_image_upload"
          phx-value-ref={entry.ref}
          class="article-new-cancel-upload btn btn-sm btn-ghost text-error"
          aria-label={gettext("Cancel upload")}
        >
          &times;
        </button>
      </div>

      <div
        :for={err <- upload_errors(@uploads.article_images)}
        class="text-sm text-error"
        role="alert"
      >
        {upload_error_to_string(err)}
      </div>

      <div
        :for={entry <- @uploads.article_images.entries}
        :if={upload_errors(@uploads.article_images, entry) != []}
      >
        <div
          :for={err <- upload_errors(@uploads.article_images, entry)}
          class="text-sm text-error"
          role="alert"
        >
          {upload_error_to_string(err)}
        </div>
      </div>
    </div>

    <%!-- Poll Section --%>
    <div id="article-poll-section" class="article-new-poll-section">
      <fieldset :if={@poll_enabled} class="article-new-poll space-y-3">
        <legend class="sr-only">{gettext("Poll")}</legend>

        <div role="group" aria-label={gettext("Poll options")} class="space-y-2">
          <div
            :for={{opt, idx} <- Enum.with_index(@poll_options)}
            class="article-new-poll-option flex items-center gap-2"
          >
            <input
              id={"article-new-poll-option-#{idx}"}
              type="text"
              name={"poll_options[#{idx}]"}
              value={opt}
              placeholder={gettext("Option %{number}", number: idx + 1)}
              class="article-new-poll-option-input input input-bordered input-sm w-full"
              aria-label={gettext("Option %{number}", number: idx + 1)}
              maxlength="200"
            />
            <button
              :if={length(@poll_options) > 2}
              type="button"
              phx-click="remove_poll_option"
              phx-value-index={idx}
              class="article-new-poll-remove-option btn btn-sm btn-ghost text-error"
              aria-label={gettext("Remove option %{number}", number: idx + 1)}
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          </div>
        </div>

        <button
          :if={length(@poll_options) < 4}
          id="article-new-poll-add-option"
          type="button"
          phx-click="add_poll_option"
          class="article-new-poll-add-option btn btn-sm btn-ghost"
        >
          <.icon name="hero-plus" class="size-4" />
          {gettext("Add option")}
        </button>

        <div
          class="flex flex-wrap gap-4"
          role="radiogroup"
          aria-label={gettext("Poll voting mode")}
        >
          <div class="form-control">
            <label class="label cursor-pointer gap-2">
              <input
                id="article-new-poll-mode-single"
                type="radio"
                name="poll_mode"
                value="single"
                checked={@poll_mode == "single"}
                class="article-new-poll-mode radio radio-sm"
              />
              <span class="label-text">{gettext("Single choice")}</span>
            </label>
          </div>
          <div class="form-control">
            <label class="label cursor-pointer gap-2">
              <input
                id="article-new-poll-mode-multiple"
                type="radio"
                name="poll_mode"
                value="multiple"
                checked={@poll_mode == "multiple"}
                class="article-new-poll-mode radio radio-sm"
              />
              <span class="label-text">{gettext("Multiple choice")}</span>
            </label>
          </div>
        </div>

        <div class="form-control w-full max-w-xs">
          <label class="label" for="poll-expires">
            <span class="label-text">{gettext("Expires (optional)")}</span>
          </label>
          <select
            id="poll-expires"
            name="poll_expires"
            class="article-new-poll-expires select select-bordered select-sm"
          >
            <option value="" selected={@poll_expires == ""}>{gettext("No expiry")}</option>
            <option value="1h" selected={@poll_expires == "1h"}>{gettext("1 hour")}</option>
            <option value="6h" selected={@poll_expires == "6h"}>{gettext("6 hours")}</option>
            <option value="1d" selected={@poll_expires == "1d"}>{gettext("1 day")}</option>
            <option value="3d" selected={@poll_expires == "3d"}>{gettext("3 days")}</option>
            <option value="7d" selected={@poll_expires == "7d"}>{gettext("7 days")}</option>
          </select>
        </div>
      </fieldset>
    </div>

    <input :if={@fixed_board} type="hidden" name="board_ids[]" value={@fixed_board.id} />
    <div :if={!@fixed_board} id="article-new-boards" class="article-new-boards fieldset mb-2">
      <span class="label mb-1 text-lg font-semibold">{gettext("Board")}</span>

      <ul
        :if={@selected_boards != []}
        id="selected-boards"
        class="article-new-selected-boards flex flex-wrap gap-2 mb-2"
        aria-label={gettext("Selected boards")}
      >
        <li
          :for={board <- @selected_boards}
          id={"article-new-selected-board-#{board.id}"}
          class="selected-board badge badge-primary badge-lg gap-2"
        >
          <input type="hidden" name="board_ids[]" value={board.id} />
          <span>{board.name}</span>
          <button
            type="button"
            phx-click="remove_board"
            phx-value-board-id={board.id}
            class="article-new-remove-board btn btn-ghost btn-xs btn-circle"
            aria-label={gettext("Remove %{name}", name: board.name)}
          >
            <.icon name="hero-x-mark" class="size-3" />
          </button>
        </li>
      </ul>

      <div class="w-full max-w-md">
        <input
          id="article-new-board-search-input"
          type="text"
          name="board_search_query"
          value={@board_search_query}
          placeholder={gettext("Search boards...")}
          phx-keyup="search_boards"
          phx-debounce="300"
          autocomplete="off"
          class="article-new-board-search-input input input-sm input-bordered w-full"
          aria-label={gettext("Search boards")}
          aria-describedby="article-new-board-search-status"
        />
        <p
          id="article-new-board-search-status"
          class="article-new-board-search-status sr-only"
          role="status"
        >
          {if String.length(String.trim(@board_search_query || "")) >= 2,
            do:
              ngettext(
                "%{count} board found",
                "%{count} boards found",
                length(@board_search_results)
              )}
        </p>
        <ul
          :if={@board_search_results != []}
          id="board-search-results"
          class="article-new-board-search-results menu bg-base-200 rounded-box mt-1 shadow-lg max-h-48 overflow-y-auto"
          aria-label={gettext("Board search results")}
        >
          <li
            :for={board <- @board_search_results}
            id={"article-new-board-result-item-#{board.id}"}
            class="article-new-board-result-item"
          >
            <button
              id={"article-new-board-result-#{board.id}"}
              type="button"
              phx-click="add_board"
              phx-value-board-id={board.id}
              class="article-new-board-result"
            >
              {board.name}
            </button>
          </li>
        </ul>
      </div>

      <p :if={@from_share} class="article-new-share-hint text-sm text-base-content/70 mt-2">
        {gettext("No board selected — this will be a personal article.")}
      </p>
    </div>

    <%!-- A warning is content the reader sees *instead* of the post until they
    ask for it (ADR 0052), so it sits with the post rather than with the
    options below. --%>
    <.input
      id="article-new-content-warning"
      field={@form[:summary]}
      type="text"
      label={gettext("Content warning")}
      placeholder={gettext("Optional — what should a reader know before opening this?")}
      maxlength="512"
      class="content-warning-input"
    />

    <div class="flex flex-wrap items-center gap-3 [&>.fieldset]:mb-0 [&>.fieldset]:p-0 [&_.label]:py-0">
      <.input
        field={@form[:forwardable]}
        type="checkbox"
        label={gettext("Allow forwarding")}
        label_class="text-base"
      />
      <.input
        field={@form[:visibility]}
        type="select"
        label={gettext("Visibility")}
        label_class="text-base"
        options={[
          {gettext("Public"), "public"},
          {gettext("Unlisted"), "unlisted"}
        ]}
      />
      <button
        id="article-new-submit"
        type="submit"
        class="article-new-submit btn btn-primary"
        phx-disable-with={gettext("Creating...")}
      >
        {gettext("Create Article")}
      </button>
      <span
        id="draft-indicator-new"
        class="text-sm text-base-content/70 transition-opacity duration-300 opacity-0"
        aria-live="polite"
        aria-atomic="true"
      ></span>
    </div>
  </.form>
</div>
