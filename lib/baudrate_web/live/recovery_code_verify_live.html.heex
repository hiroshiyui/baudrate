<div id="recovery-code-verify-page" class="recovery-code-verify-page mx-auto max-w-sm mt-10">
  <h1 id="recovery-code-verify-heading" class="text-2xl font-bold text-center mb-2">
    {gettext("Recovery Code")}
  </h1>
  <p
    id="recovery-code-verify-subtitle"
    class="recovery-code-verify-subtitle text-center text-base-content/70 mb-8"
  >
    {gettext("Enter one of your recovery codes to log in.")}
  </p>

  <.form
    for={@form}
    id="recovery-code-form"
    phx-change="validate"
    phx-submit="submit"
    class="space-y-4"
  >
    <div class="form-control">
      <label
        id="recovery-code-verify-code-label"
        class="recovery-code-verify-field-label label"
        for="recovery_code"
      >
        <span class="label-text">{gettext("Recovery Code")}</span>
      </label>
      <input
        type="text"
        id="recovery_code"
        name="recovery[code]"
        value={@form[:code].value}
        class="recovery-code-verify-code-input input input-bordered w-full text-center text-2xl tracking-widest font-mono"
        placeholder={gettext("abcd-ef23")}
        maxlength="9"
        autocomplete="off"
        autofocus
        required
      />
    </div>

    <button
      id="recovery-code-verify-submit"
      type="submit"
      class="recovery-code-verify-submit btn btn-primary w-full"
      phx-disable-with={gettext("Verifying...")}
    >
      {gettext("Verify")}
    </button>
  </.form>

  <form
    id="recovery-verify-form"
    action="/auth/recovery-verify"
    method="post"
    phx-trigger-action={@trigger_action}
  >
    <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
    <input type="hidden" name="code" value={assigns[:code]} />
  </form>

  <nav id="recovery-code-nav" class="text-center mt-4" aria-label={gettext("Recovery code help")}>
    <.link
      id="recovery-code-verify-totp-link"
      navigate="/totp/verify"
      class="recovery-code-verify-totp-link link link-hover text-sm"
    >
      {gettext("Back to TOTP verification")}
    </.link>
  </nav>
</div>
