<div id="password-change-page" class="password-change-page mx-auto max-w-sm mt-10">
  <h1
    id="password-change-heading"
    class="password-change-heading text-2xl font-bold text-center mb-2"
  >
    {gettext("Change Password")}
  </h1>
  <p
    id="password-change-subtitle"
    class="password-change-subtitle text-center text-base-content/70 mb-8"
  >
    <%= if @current_user.totp_enabled do %>
      {gettext(
        "Confirm your current password and authenticator code. All your other sessions will be signed out."
      )}
    <% else %>
      {gettext("Confirm your current password. All your other sessions will be signed out.")}
    <% end %>
  </p>

  <.form
    for={@form}
    id="password-change-form"
    phx-change="validate"
    phx-submit="submit"
    class="space-y-4"
  >
    <div class="form-control">
      <label
        id="password-change-current-password-label"
        class="password-change-field-label label"
        for="password_change_current_password"
      >
        <span class="label-text">{gettext("Current Password")}</span>
      </label>
      <input
        type="password"
        id="password_change_current_password"
        name="password_change[current_password]"
        value={@form[:current_password].value}
        class="password-change-current-password-input input input-bordered w-full"
        autocomplete="current-password"
        required
        aria-required="true"
      />
    </div>

    <div :if={@current_user.totp_enabled} class="form-control">
      <label
        id="password-change-code-label"
        class="password-change-field-label label"
        for="password_change_code"
      >
        <span class="label-text">{gettext("Current TOTP Code")}</span>
      </label>
      <input
        type="text"
        id="password_change_code"
        name="password_change[code]"
        value={@form[:code].value}
        class="password-change-code-input input input-bordered w-full text-center tracking-widest"
        inputmode="numeric"
        pattern="[0-9]{6}"
        maxlength="6"
        autocomplete="one-time-code"
        required
        aria-required="true"
        aria-describedby="password-change-code-hint"
      />
      <.totp_code_hint id="password-change-code-hint" />
    </div>

    <div class="form-control">
      <label
        id="password-change-password-label"
        class="password-change-field-label label"
        for="password_change_password"
      >
        <span class="label-text">{gettext("New Password")}</span>
      </label>
      <input
        type="password"
        id="password_change_password"
        name="password_change[password]"
        value={@form[:password].value}
        class="password-change-password-input input input-bordered w-full"
        autocomplete="new-password"
        required
        aria-required="true"
        aria-invalid={@password_errors != [] && "true"}
        aria-describedby={@password_errors != [] && "password-change-password-errors"}
      />
      <ul
        :if={@password_errors != []}
        id="password-change-password-errors"
        class="password-change-errors text-sm text-error mt-1"
      >
        <li
          :for={{msg, i} <- Enum.with_index(@password_errors)}
          id={"password-change-password-error-#{i}"}
        >
          {msg}
        </li>
      </ul>
    </div>

    <div class="form-control">
      <label
        id="password-change-password-confirmation-label"
        class="password-change-field-label label"
        for="password_change_password_confirmation"
      >
        <span class="label-text">{gettext("Confirm New Password")}</span>
      </label>
      <input
        type="password"
        id="password_change_password_confirmation"
        name="password_change[password_confirmation]"
        value={@form[:password_confirmation].value}
        class="password-change-password-confirmation-input input input-bordered w-full"
        autocomplete="new-password"
        required
        aria-required="true"
        aria-invalid={@confirmation_errors != [] && "true"}
        aria-describedby={@confirmation_errors != [] && "password-change-confirmation-errors"}
      />
      <ul
        :if={@confirmation_errors != []}
        id="password-change-confirmation-errors"
        class="password-change-errors text-sm text-error mt-1"
      >
        <li
          :for={{msg, i} <- Enum.with_index(@confirmation_errors)}
          id={"password-change-confirmation-error-#{i}"}
        >
          {msg}
        </li>
      </ul>
    </div>

    <.password_requirements id="password-change-strength" strength={@password_strength} />

    <button
      id="password-change-submit"
      type="submit"
      class="password-change-submit btn btn-primary w-full"
      phx-disable-with={gettext("Saving...")}
    >
      {gettext("Change Password")}
    </button>
  </.form>

  <nav
    id="password-change-nav"
    class="text-center mt-4"
    aria-label={gettext("Change password navigation")}
  >
    <.link
      id="password-change-profile-link"
      navigate={~p"/profile/security"}
      class="password-change-profile-link link link-hover text-sm"
    >
      {gettext("Back to Security")}
    </.link>
  </nav>
</div>
