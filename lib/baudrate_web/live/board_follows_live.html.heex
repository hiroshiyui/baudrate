<div id="board-follows-page" class="board-follows-page space-y-6">
  <nav
    id="board-follows-breadcrumb"
    class="board-follows-breadcrumb breadcrumbs text-sm"
    aria-label={gettext("Breadcrumb")}
  >
    <ul>
      <li><.link navigate="/">{gettext("Home")}</.link></li>
      <li><.link navigate={~p"/boards/#{@board.slug}"}>{@board.name}</.link></li>
      <li>
        <span
          id="board-follows-breadcrumb-current"
          class="board-follows-breadcrumb-current"
          aria-current="page"
        >
          {gettext("Board Follows")}
        </span>
      </li>
    </ul>
  </nav>

  <h1 id="board-follows-heading" class="board-follows-heading text-2xl font-bold">
    {gettext("Board Follows")} &mdash; {@board.name}
  </h1>

  <%!-- Accept policy section --%>
  <div id="accept-policy-section" class="board-follows-policy-section card bg-base-200 shadow-sm">
    <div class="card-body p-4">
      <h2 class="board-follows-policy-heading card-title text-lg">{gettext("Accept Policy")}</h2>
      <p class="board-follows-policy-description text-sm text-base-content/70 mb-3">
        <%= if @board.ap_accept_policy == "open" do %>
          {gettext("Anyone can post to this board")}
        <% else %>
          {gettext("Only followed actors can post to this board")}
        <% end %>
      </p>
      <div class="flex gap-2">
        <button
          id="board-follows-policy-followers-only"
          phx-click="update_policy"
          phx-value-policy="followers_only"
          aria-pressed={to_string(@board.ap_accept_policy == "followers_only")}
          class={[
            "board-follows-policy-option btn btn-sm",
            @board.ap_accept_policy == "followers_only" && "btn-primary",
            @board.ap_accept_policy != "followers_only" && "btn-ghost"
          ]}
        >
          {gettext("Followers only")}
        </button>
        <button
          id="board-follows-policy-open"
          phx-click="update_policy"
          phx-value-policy="open"
          aria-pressed={to_string(@board.ap_accept_policy == "open")}
          class={[
            "board-follows-policy-option btn btn-sm",
            @board.ap_accept_policy == "open" && "btn-primary",
            @board.ap_accept_policy != "open" && "btn-ghost"
          ]}
        >
          {gettext("Open")}
        </button>
      </div>
    </div>
  </div>

  <%!-- Search for remote actor --%>
  <div id="follow-search-section" class="board-follows-search-section card bg-base-200 shadow-sm">
    <div class="card-body p-4">
      <h2 class="board-follows-search-heading card-title text-lg">
        {gettext("Follow Remote Actor")}
      </h2>
      <form
        id="board-follows-search-form"
        phx-submit="search"
        class="board-follows-search-form flex gap-2"
      >
        <input
          id="board-follows-search-input"
          type="text"
          name="query"
          value={@search_query}
          placeholder={gettext("Search for a remote actor to follow (e.g. @user@domain)")}
          class="board-follows-search-input input input-bordered flex-1"
          autocomplete="off"
          aria-label={gettext("Search for a remote actor to follow (e.g. @user@domain)")}
        />
        <button
          id="board-follows-search-submit"
          type="submit"
          class="board-follows-search-submit btn btn-primary"
          disabled={@search_loading}
          phx-disable-with={gettext("Searching...")}
        >
          <%= if @search_loading do %>
            <span class="loading loading-spinner loading-sm"></span>
          <% else %>
            {gettext("Search")}
          <% end %>
        </button>
      </form>

      <div
        :if={@search_error}
        id="board-follows-search-error"
        class="board-follows-search-error text-error text-sm mt-2"
        role="alert"
      >
        {@search_error}
      </div>

      <div id="board-follows-search-status" class="board-follows-search-status" role="status">
        <div
          :if={@search_result}
          id="board-follows-search-result"
          class="board-follows-search-result mt-4 card bg-base-100 shadow-sm"
        >
          <div class="card-body p-4 flex flex-row items-center gap-4">
            <div class="avatar">
              <div class="w-12 h-12 rounded-full bg-base-300 flex items-center justify-center">
                <img
                  :if={@search_result.avatar_url}
                  src={Baudrate.Media.Proxy.url(@search_result.avatar_url)}
                  alt={@search_result.display_name || @search_result.username}
                  class="rounded-full"
                />
                <.icon
                  :if={!@search_result.avatar_url}
                  name="hero-user-circle"
                  class="size-8 opacity-50"
                />
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-bold truncate">
                {@search_result.display_name || @search_result.username}
              </div>
              <div class="text-sm text-base-content/70 truncate">
                @{@search_result.username}@{@search_result.domain}
              </div>
              <div
                :if={@search_result.summary && @search_result.summary != ""}
                class="text-sm text-base-content/70 mt-1 line-clamp-2"
              >
                {Baudrate.Sanitizer.Native.strip_tags(@search_result.summary)}
              </div>
            </div>
            <%= if already_following?(@follows, @search_result.id) do %>
              <span class="board-follows-already-following badge badge-ghost">
                {gettext("Already following")}
              </span>
            <% else %>
              <button
                id="board-follows-follow-submit"
                phx-click="follow"
                phx-value-id={@search_result.id}
                class="board-follows-follow-submit btn btn-sm btn-primary"
              >
                {gettext("Follow")}
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Current follows list --%>
  <div id="current-follows-section" class="board-follows-list-section">
    <h2 id="current-follows-heading" class="board-follows-list-heading text-lg font-semibold mb-3">
      {gettext("Current Follows")}
      <span :if={@follows != []} class="badge badge-neutral ml-2">{length(@follows)}</span>
    </h2>

    <div :if={@follows == []} class="board-follows-empty text-base-content/70 text-center py-8">
      {gettext("No follows yet.")}
    </div>

    <div :if={@follows != []} id="board-follows-list" class="board-follows-list space-y-2">
      <div
        :for={follow <- @follows}
        id={"board-follow-#{follow.remote_actor.id}"}
        class="board-follow card bg-base-200 shadow-sm"
      >
        <div class="card-body p-4 flex flex-row items-center gap-4">
          <div class="avatar">
            <div class="w-12 h-12 rounded-full bg-base-300 flex items-center justify-center">
              <img
                :if={follow.remote_actor.avatar_url}
                src={Baudrate.Media.Proxy.url(follow.remote_actor.avatar_url)}
                alt={follow.remote_actor.display_name || follow.remote_actor.username}
                class="rounded-full"
              />
              <.icon
                :if={!follow.remote_actor.avatar_url}
                name="hero-user-circle"
                class="size-8 opacity-50"
              />
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <a
              href={remote_actor_profile_url(follow.remote_actor)}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="board-follow-actor-link link link-hover"
            >
              <div class="font-bold truncate">
                {follow.remote_actor.display_name || follow.remote_actor.username}
              </div>
              <div class="text-sm text-base-content/70 truncate">
                @{follow.remote_actor.username}@{follow.remote_actor.domain}
              </div>
            </a>
            <div
              :if={follow.remote_actor.summary && follow.remote_actor.summary != ""}
              class="text-sm text-base-content/70 mt-1 line-clamp-2"
            >
              {Baudrate.Sanitizer.Native.strip_tags(follow.remote_actor.summary)}
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class={[
              "badge badge-sm",
              follow.state == "accepted" && "badge-success",
              follow.state == "pending" && "badge-warning",
              follow.state == "rejected" && "badge-error"
            ]}>
              {case follow.state do
                "accepted" -> gettext("Accepted")
                "pending" -> gettext("Pending")
                "rejected" -> gettext("Rejected")
              end}
            </span>
            <button
              id={"board-follow-unfollow-#{follow.remote_actor.id}"}
              phx-click="unfollow"
              phx-value-id={follow.remote_actor.id}
              data-confirm={gettext("Unfollow this actor?")}
              class="board-follow-unfollow btn btn-sm btn-ghost text-error"
            >
              {gettext("Unfollow")}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
