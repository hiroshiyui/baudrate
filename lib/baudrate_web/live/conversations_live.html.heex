<section
  id="conversations-page"
  aria-labelledby="conversations-heading"
  class="conversations-page space-y-4"
  data-focus-target
>
  <div class="flex items-center justify-between">
    <h1 id="conversations-heading" class="conversations-heading text-2xl font-bold">
      {gettext("Messages")}
    </h1>
    <.link
      id="conversations-new-link"
      navigate="/messages/new"
      class="conversations-new-link btn btn-primary btn-sm"
    >
      <.icon name="hero-pencil-square" class="size-4" />
      {gettext("New Message")}
    </.link>
  </div>

  <form
    id="messages-search-form"
    role="search"
    phx-submit="search"
    class="messages-search-form flex gap-2"
  >
    <input
      id="messages-search-input"
      type="search"
      name="q"
      value={@query}
      class="messages-search-input input input-bordered input-sm flex-1"
      placeholder={gettext("Search your messages")}
      aria-label={gettext("Search your messages")}
      maxlength="200"
      autocomplete="off"
    />
    <button id="messages-search-submit" type="submit" class="messages-search-submit btn btn-sm">
      <.icon name="hero-magnifying-glass" class="size-4" />
      {gettext("Search")}
    </button>
    <.link
      :if={@query != ""}
      id="messages-search-clear"
      patch={~p"/messages"}
      class="btn btn-sm btn-ghost"
    >
      {gettext("Clear")}
    </.link>
  </form>

  <p id="messages-search-status" class="messages-search-status sr-only" role="status">
    {@search_status}
  </p>

  <section
    :if={@results}
    id="messages-search-results"
    class="messages-search-results space-y-2"
    aria-labelledby="messages-search-heading"
  >
    <h2 id="messages-search-heading" class="messages-search-heading text-lg font-semibold">
      {gettext("Messages matching “%{query}”", query: @query)}
    </h2>
    <p
      :if={@results.messages == []}
      id="messages-search-empty"
      class="messages-search-empty text-base-content/70"
    >
      {if String.length(@query) < Baudrate.Messaging.Search.min_length(),
        do: gettext("Type at least two characters."),
        else: gettext("No message matches.")}
    </p>
    <ul
      :if={@results.messages != []}
      id="messages-search-list"
      class="space-y-2"
      data-focus-target
    >
      <li
        :for={msg <- @results.messages}
        id={"messages-search-result-#{msg.id}"}
        class="messages-search-result card bg-base-200 shadow-sm"
      >
        <.link
          navigate={~p"/messages/#{msg.conversation_id}?#{[around: msg.id]}" <> "#message-#{msg.id}"}
          class="card-body p-3 block min-w-0"
        >
          <span class="flex flex-wrap items-baseline gap-2 text-sm">
            <span class="messages-search-with font-semibold">
              {participant_name(other_participant(msg.conversation, @current_user))}
            </span>
            <span class="messages-search-sender text-base-content/70">
              {sender_label(msg, @current_user)}
            </span>
            <time
              class="messages-search-time text-xs text-base-content/70"
              datetime={DateTime.to_iso8601(msg.inserted_at)}
            >
              {format_relative_time(msg.inserted_at)}
            </time>
          </span>
          <span class="messages-search-excerpt block text-sm break-words mt-1">
            {excerpt(msg.body, @query)}
          </span>
        </.link>
      </li>
    </ul>
    <.pagination
      :if={@results.messages != []}
      page={@results.page}
      total_pages={@results.total_pages}
      path={~p"/messages"}
      params={%{"q" => @query}}
    />
  </section>

  <p id="conversations-live-status" class="conversations-live-status sr-only" role="status">
    {@live_status}
  </p>

  <div
    :if={@conversations == []}
    id="conversations-empty"
    class="conversations-empty text-center py-12 text-base-content/70"
  >
    <.icon name="hero-chat-bubble-left-right" class="size-12 mx-auto mb-4 opacity-50" />
    <p class="text-lg">{gettext("No messages yet.")}</p>
    <p class="text-sm">{gettext("Start a conversation from a user's profile page.")}</p>
  </div>

  <div :if={@conversations != []} id="conversations" class="space-y-2">
    <.link
      :for={conv <- @conversations}
      id={"conversation-#{conv.id}"}
      navigate={~p"/messages/#{conv.id}"}
      class={[
        "conversation card bg-base-200 shadow-sm hover:bg-base-300 transition-colors cursor-pointer block",
        Map.get(@muted_conversations, conv.id, false) && "opacity-50"
      ]}
    >
      <div class="card-body p-4 flex flex-row items-center gap-3">
        <% other = other_participant(conv, @current_user) %>
        <%= case other do %>
          <% %Baudrate.Setup.User{} = user -> %>
            <.avatar user={user} size={36} />
          <% _ -> %>
            <div class="avatar avatar-placeholder">
              <div
                class="bg-neutral text-neutral-content rounded-full"
                style="width: 36px; height: 36px"
              >
                <span class="text-sm">
                  {String.first(participant_name(other)) |> String.upcase()}
                </span>
              </div>
            </div>
        <% end %>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between">
            <span class="conversation-participant-name font-semibold truncate">
              {participant_name(other)}
            </span>
            <span
              :if={Map.get(@muted_conversations, conv.id, false)}
              id={"conversation-muted-label-#{conv.id}"}
              class="conversation-muted-label badge badge-ghost badge-sm shrink-0 ml-2"
            >
              {gettext("Muted")}
            </span>
            <span :if={conv.last_message_at} class="text-xs text-base-content/70 shrink-0 ml-2">
              {format_relative_time(conv.last_message_at)}
            </span>
          </div>
        </div>
        <div
          :if={
            Map.get(@unread_counts, conv.id, 0) > 0 and
              not Map.get(@muted_conversations, conv.id, false)
          }
          class="badge badge-primary badge-sm"
          aria-label={
            ngettext(
              "%{count} unread message",
              "%{count} unread messages",
              Map.get(@unread_counts, conv.id, 0),
              count: Map.get(@unread_counts, conv.id, 0)
            )
          }
        >
          {Map.get(@unread_counts, conv.id, 0)}
        </div>
      </div>
    </.link>
  </div>
</section>
