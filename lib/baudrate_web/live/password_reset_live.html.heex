<div id="password-reset-page" class="password-reset-page mx-auto max-w-sm mt-10">
  <h1 id="password-reset-heading" class="text-2xl font-bold text-center mb-2">
    {gettext("Reset Password")}
  </h1>
  <p
    id="password-reset-subtitle"
    class="password-reset-subtitle text-center text-base-content/70 mb-8"
  >
    {gettext("Enter your username and a recovery code to reset your password.")}
  </p>

  <.form
    for={@form}
    id="password-reset-form"
    phx-change="validate"
    phx-submit="submit"
    class="space-y-4"
  >
    <div class="form-control">
      <label
        id="password-reset-username-label"
        class="password-reset-field-label label"
        for="reset_username"
      >
        <span class="label-text">{gettext("Username")}</span>
      </label>
      <input
        type="text"
        id="reset_username"
        name="reset[username]"
        value={@form[:username].value}
        class="password-reset-username-input input input-bordered w-full"
        autocomplete="username"
        required
        aria-required="true"
      />
    </div>

    <div class="form-control">
      <label
        id="password-reset-recovery-code-label"
        class="password-reset-field-label label"
        for="reset_recovery_code"
      >
        <span class="label-text">{gettext("Recovery Code")}</span>
      </label>
      <input
        type="text"
        id="reset_recovery_code"
        name="reset[recovery_code]"
        value={@form[:recovery_code].value}
        class="password-reset-recovery-code-input input input-bordered w-full font-mono"
        placeholder={gettext("abcd-ef23")}
        autocomplete="off"
        required
        aria-required="true"
      />
    </div>

    <div class="form-control">
      <label
        id="password-reset-new-password-label"
        class="password-reset-field-label label"
        for="reset_new_password"
      >
        <span class="label-text">{gettext("New Password")}</span>
      </label>
      <input
        type="password"
        id="reset_new_password"
        name="reset[new_password]"
        class="password-reset-new-password-input input input-bordered w-full"
        autocomplete="new-password"
        required
        aria-required="true"
      />
    </div>

    <div class="form-control">
      <label
        id="password-reset-new-password-confirmation-label"
        class="password-reset-field-label label"
        for="reset_new_password_confirmation"
      >
        <span class="label-text">{gettext("Confirm New Password")}</span>
      </label>
      <input
        type="password"
        id="reset_new_password_confirmation"
        name="reset[new_password_confirmation]"
        class="password-reset-new-password-confirmation-input input input-bordered w-full"
        autocomplete="new-password"
        required
        aria-required="true"
      />
    </div>

    <%!-- Password strength checklist --%>
    <.password_requirements id="password-strength" strength={@password_strength} />

    <button
      id="password-reset-submit"
      type="submit"
      class="password-reset-submit btn btn-primary w-full"
      phx-disable-with={gettext("Resetting...")}
    >
      {gettext("Reset Password")}
    </button>
  </.form>

  <nav id="password-reset-nav" aria-label={gettext("Password reset help")}>
    <p class="text-center text-sm mt-4">
      <.link
        id="password-reset-login-link"
        navigate="/login"
        class="password-reset-login-link link link-primary"
      >
        {gettext("Back to Sign In")}
      </.link>
    </p>
  </nav>
</div>
