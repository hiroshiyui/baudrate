<nav
  id="board-breadcrumb"
  class="board-breadcrumb breadcrumbs text-sm mb-4"
  aria-label={gettext("Breadcrumb")}
>
  <ul>
    <li><.link navigate="/">{gettext("Home")}</.link></li>
    <%= for ancestor <- @ancestors do %>
      <%= if ancestor.id == @board.id do %>
        <li>
          <span id="board-breadcrumb-current" class="board-breadcrumb-current" aria-current="page">
            {ancestor.name}
          </span>
        </li>
      <% else %>
        <li><.link navigate={~p"/boards/#{ancestor.slug}"}>{ancestor.name}</.link></li>
      <% end %>
    <% end %>
  </ul>
</nav>

<h1 id="board-heading" class="board-heading text-2xl font-bold mb-2">{@board.name}</h1>
<p :if={@board.description} class="board-description text-base-content/70 mb-2">
  {@board.description}
</p>
<div
  :if={@board.ap_enabled}
  class="board-fediverse-handle text-sm text-base-content/70 flex items-center gap-1 mb-4"
>
  <.icon name="hero-identification" class="size-6 shrink-0" />
  <span title={gettext("Fediverse handle")}>{fediverse_handle(@board)}</span>
</div>

<div id="board-actions" class="board-actions flex flex-wrap gap-2 mb-6">
  <.link
    :if={@can_create}
    id="board-new-article"
    navigate={~p"/boards/#{@board.slug}/articles/new"}
    class="board-action btn btn-sm btn-primary"
  >
    {gettext("New Article")}
  </.link>
  <.link
    :if={@can_moderate}
    id="board-reports"
    navigate={~p"/moderation"}
    class="board-action btn btn-sm btn-ghost"
  >
    <.icon name="hero-flag" class="size-4" />
    {gettext("Reports")}
  </.link>
  <.link
    :if={@can_manage_follows}
    id="board-manage-follows"
    navigate={~p"/boards/#{@board.slug}/follows"}
    class="board-action btn btn-sm btn-ghost"
  >
    {gettext("Manage Follows")}
  </.link>
  <button
    :if={@current_user && MapSet.size(@unread_article_ids) > 0}
    id="board-mark-all-read"
    type="button"
    phx-click="mark_all_read"
    class="board-action btn btn-sm btn-ghost"
  >
    <.icon name="hero-check" class="size-4" />
    {gettext("Mark all as read")}
  </button>
</div>

<aside
  :if={@board_moderators != []}
  id="board-moderators"
  class="board-moderators flex flex-wrap items-center gap-2 text-sm text-base-content/70 mb-6"
  aria-label={gettext("Board moderators")}
>
  <span>{gettext("Moderated by")}</span>
  <.link
    :for={bm <- @board_moderators}
    id={"board-moderator-#{bm.user.username}"}
    navigate={~p"/users/#{bm.user.username}"}
    class="board-moderator inline-flex items-center gap-1 link link-hover"
  >
    <.avatar user={bm.user} size={24} />
    {display_name(bm.user)}
  </.link>
</aside>

<section
  :if={@sub_boards != []}
  id="sub-boards-section"
  class="board-sub-boards-section mb-6"
  aria-labelledby="sub-boards-heading"
>
  <h2 id="sub-boards-heading" class="board-sub-boards-heading text-lg font-semibold mb-3">
    {gettext("Sub-boards")}
  </h2>
  <div id="sub-boards" class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-focus-target>
    <.link
      :for={sub <- @sub_boards}
      id={"sub-board-#{sub.slug}"}
      navigate={~p"/boards/#{sub.slug}"}
      class="board sub-board card bg-base-200 shadow-sm hover:bg-base-300 transition-colors"
    >
      <div class="card-body p-4">
        <h3 class="sub-board-title card-title text-base">
          {sub.name}
          <span
            :if={@current_user && MapSet.member?(@unread_sub_board_ids, sub.id)}
            class="sub-board-unread-dot inline-block w-2 h-2 flex-shrink-0 rounded-full bg-primary"
            role="img"
            aria-label={gettext("Unread")}
          >
            <span class="sr-only">{gettext("Unread")}</span>
          </span>
        </h3>
        <p :if={sub.description} class="sub-board-description text-sm text-base-content/70">
          {sub.description}
        </p>
      </div>
    </.link>
  </div>
</section>

<div :if={@articles == []} class="board-articles-empty text-base-content/70 text-center py-8">
  {gettext("No articles yet.")}
</div>

<div :if={@articles != []} id="articles" class="board-articles space-y-2" data-focus-target>
  <article
    :for={article <- @articles}
    id={"article-#{article.slug}"}
    aria-labelledby={"article-title-#{article.slug}"}
    class="article card bg-base-200 shadow-sm hover:bg-base-300 transition-colors relative"
  >
    <div class="card-body p-4">
      <.link
        navigate={~p"/articles/#{article.slug}"}
        id={"article-title-#{article.slug}"}
        class="board-article-title card-title text-base link link-hover stretched-link"
      >
        <span :if={article.pinned} class="badge badge-sm badge-accent">{gettext("Pinned")}</span>
        {article.title}
        <span
          :if={@current_user && MapSet.member?(@unread_article_ids, article.id)}
          class="inline-block w-2 h-2 flex-shrink-0 rounded-full bg-primary"
          role="img"
          aria-label={gettext("Unread")}
        >
          <span class="sr-only">{gettext("Unread")}</span>
        </span>
      </.link>
      <p
        :if={article.body}
        class="board-article-digest text-sm text-base-content/80 line-clamp-3 mt-1"
      >
        {digest(article.body)}
      </p>
      <div
        :if={article.article_images != []}
        class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2"
      >
        <img
          :for={img <- article.article_images}
          src={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
          width={img.width}
          height={img.height}
          class="w-full aspect-square object-cover rounded-lg border border-base-300"
          loading="lazy"
          alt={article.title}
        />
      </div>
      <div class="board-article-meta flex flex-wrap items-center gap-1 text-sm text-base-content/70 mt-1">
        <span :if={article.user} class="inline-flex items-center gap-1">
          {gettext("by")}
          <.link
            navigate={~p"/users/#{article.user.username}"}
            class="board-article-author inline-flex items-center gap-1 link link-hover font-semibold relative z-10"
          >
            <.avatar user={article.user} size={24} />
            {display_name(article.user)}
          </.link>
          <span
            :if={article.user.is_bot}
            class="badge badge-sm badge-ghost ml-1"
            role="img"
            aria-label={gettext("Bot account")}
          >
            {gettext("Bot")}
          </span>
          &middot;
        </span>
        <span :if={article.remote_actor} class="inline-flex items-center gap-1">
          {gettext("by")}
          <a
            href={remote_actor_profile_url(article.remote_actor)}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="board-article-remote-author inline-flex items-center gap-1 font-semibold link link-hover relative z-10"
          >
            <span class="w-6 h-6 rounded-full bg-base-300 inline-flex items-center justify-center shrink-0">
              <img
                :if={article.remote_actor.avatar_url}
                src={Baudrate.Media.Proxy.url(article.remote_actor.avatar_url)}
                alt={display_name(article.remote_actor)}
                class="w-6 h-6 rounded-full"
              />
              <.icon
                :if={!article.remote_actor.avatar_url}
                name="hero-user-circle"
                class="size-5 opacity-50"
              />
            </span>
            {display_name(article.remote_actor)}<span class="text-base-content/50">@{article.remote_actor.domain}</span>
          </a>
          &middot;
        </span>
        <a
          :if={article.ap_id}
          href={article.url || article.ap_id}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="board-article-original-link link link-hover relative z-10"
          title={gettext("View original")}
        >
          <time datetime={datetime_attr(article_datetime(article))}>
            {format_datetime(article_datetime(article))}
          </time>
        </a>
        <.link
          :if={!article.ap_id}
          navigate={~p"/articles/#{article.slug}"}
          class="board-article-time-link link link-hover"
        >
          <time datetime={datetime_attr(article_datetime(article))}>
            {format_datetime(article_datetime(article))}
          </time>
        </.link>
        <.link
          :if={Map.get(@comment_counts, article.id, 0) > 0}
          navigate={~p"/articles/#{article.slug}"}
          class="board-article-comment-link inline-flex items-center gap-1 text-base-content/60 hover:text-base-content"
          aria-label={
            ngettext("1 comment", "%{count} comments", Map.get(@comment_counts, article.id, 0))
          }
        >
          &middot; <.icon name="hero-chat-bubble-left-ellipsis" class="size-4" />
          {Map.get(@comment_counts, article.id, 0)}
        </.link>
        <%!-- Like button --%>
        <button
          :if={
            interaction_toggle?(
              @current_user,
              article.user_id,
              MapSet.member?(@article_liked_ids, article.id)
            )
          }
          id={"board-article-like-#{article.id}"}
          phx-click="toggle_article_like"
          phx-value-id={article.id}
          class="board-article-like relative z-10 inline-flex items-center gap-1 text-base-content/60 hover:text-error cursor-pointer"
          aria-pressed={to_string(MapSet.member?(@article_liked_ids, article.id))}
          aria-label={
            ngettext(
              "Like, %{count} like",
              "Like, %{count} likes",
              Map.get(@article_like_counts, article.id, 0),
              count: Map.get(@article_like_counts, article.id, 0)
            )
          }
        >
          &middot;
          <.icon
            name={
              if MapSet.member?(@article_liked_ids, article.id),
                do: "hero-heart-solid",
                else: "hero-heart"
            }
            class={[
              "size-4",
              MapSet.member?(@article_liked_ids, article.id) && "text-error"
            ]}
          />
          <span :if={Map.get(@article_like_counts, article.id, 0) > 0}>
            {Map.get(@article_like_counts, article.id, 0)}
          </span>
        </button>
        <%!-- Boost button --%>
        <button
          :if={
            interaction_toggle?(
              @current_user,
              article.user_id,
              MapSet.member?(@article_boosted_ids, article.id)
            )
          }
          id={"board-article-boost-#{article.id}"}
          phx-click="toggle_article_boost"
          phx-value-id={article.id}
          class="board-article-boost relative z-10 inline-flex items-center gap-1 text-base-content/60 hover:text-success cursor-pointer"
          aria-pressed={to_string(MapSet.member?(@article_boosted_ids, article.id))}
          aria-label={
            ngettext(
              "Boost, %{count} boost",
              "Boost, %{count} boosts",
              Map.get(@article_boost_counts, article.id, 0),
              count: Map.get(@article_boost_counts, article.id, 0)
            )
          }
        >
          &middot;
          <.icon
            name={
              if MapSet.member?(@article_boosted_ids, article.id),
                do: "hero-arrow-path-rounded-square-solid",
                else: "hero-arrow-path-rounded-square"
            }
            class={[
              "size-4",
              MapSet.member?(@article_boosted_ids, article.id) && "text-success"
            ]}
          />
          <span :if={Map.get(@article_boost_counts, article.id, 0) > 0}>
            {Map.get(@article_boost_counts, article.id, 0)}
          </span>
        </button>
      </div>
    </div>
  </article>
</div>

<.pagination
  :if={@articles != []}
  page={@page}
  total_pages={@total_pages}
  path={~p"/boards/#{@board.slug}"}
/>
