<section
  id="following-page"
  aria-labelledby="following-heading"
  class="following-page space-y-6"
  data-focus-target
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 id="following-heading" class="following-heading text-2xl font-bold">
      {gettext("Following")}
      <span
        :if={@follows != []}
        class="following-count badge badge-neutral ml-2"
      >{length(@follows)}</span>
    </h1>
    <.link
      id="following-followers-link"
      navigate={~p"/followers"}
      class="link link-primary text-sm"
    >
      {gettext("Your followers")}
    </.link>
  </div>

  <div
    :if={@follows == []}
    id="following-empty"
    class="following-empty text-base-content/70 text-center py-8"
  >
    {gettext("You haven't followed anyone yet.")}
    <div class="mt-2">
      <.link id="following-empty-search-link" navigate="/search" class="link link-primary">
        {gettext("Search for users or remote actors to follow")}
      </.link>
    </div>
  </div>

  <div :if={@follows != []} id="follows" class="space-y-2">
    <div
      :for={follow <- @follows}
      id={"follow-#{follow.id}"}
      class="follow card bg-base-200 shadow-sm"
    >
      <%!-- Local user follow --%>
      <div :if={follow.followed_user} class="card-body p-4 flex flex-row items-center gap-4">
        <.avatar user={follow.followed_user} size={48} />
        <div class="flex-1 min-w-0">
          <.link
            id={"follow-user-link-#{follow.id}"}
            navigate={~p"/users/#{follow.followed_user.username}"}
            class="follow-name font-bold truncate link link-hover"
          >
            {follow.followed_user.username}
          </.link>
          <div class="flex items-center gap-2 mt-1">
            <span class="badge badge-outline badge-xs">
              {translate_role(follow.followed_user.role.name)}
            </span>
            <span class="badge badge-info badge-xs">{gettext("Local")}</span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="badge badge-sm badge-success">{gettext("Accepted")}</span>
          <button
            id={"follow-unfollow-user-#{follow.id}"}
            phx-click="unfollow_user"
            phx-value-id={follow.followed_user.id}
            data-confirm={gettext("Unfollow this user?")}
            class="follow-unfollow btn btn-sm btn-ghost text-error"
          >
            {gettext("Unfollow")}
          </button>
        </div>
      </div>
      <%!-- Remote actor follow --%>
      <div :if={follow.remote_actor} class="card-body p-4 flex flex-row items-center gap-4">
        <div class="avatar">
          <div class="w-12 h-12 rounded-full bg-base-300 flex items-center justify-center">
            <img
              :if={follow.remote_actor.avatar_url}
              src={Baudrate.Media.Proxy.url(follow.remote_actor.avatar_url)}
              alt={follow.remote_actor.display_name || follow.remote_actor.username}
              class="rounded-full"
            />
            <.icon
              :if={!follow.remote_actor.avatar_url}
              name="hero-user-circle"
              class="size-8 opacity-50"
            />
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <a
            id={"follow-actor-link-#{follow.id}"}
            href={remote_actor_profile_url(follow.remote_actor)}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="follow-name link link-hover"
          >
            <div class="font-bold truncate">
              {follow.remote_actor.display_name || follow.remote_actor.username}
            </div>
            <div class="text-sm text-base-content/70 truncate">
              @{follow.remote_actor.username}@{follow.remote_actor.domain}
            </div>
          </a>
          <div
            :if={follow.remote_actor.summary && follow.remote_actor.summary != ""}
            class="text-sm text-base-content/70 mt-1 line-clamp-2"
          >
            {Baudrate.Sanitizer.Native.strip_tags(follow.remote_actor.summary)}
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class={[
            "badge badge-sm",
            follow.state == "accepted" && "badge-success",
            follow.state == "pending" && "badge-warning",
            follow.state == "rejected" && "badge-error"
          ]}>
            {case follow.state do
              "accepted" -> gettext("Accepted")
              "pending" -> gettext("Pending")
              "rejected" -> gettext("Rejected")
            end}
          </span>
          <button
            id={"follow-unfollow-actor-#{follow.id}"}
            phx-click="unfollow"
            phx-value-id={follow.remote_actor.id}
            data-confirm={gettext("Unfollow this actor?")}
            class="follow-unfollow btn btn-sm btn-ghost text-error"
          >
            {gettext("Unfollow")}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
