<div id="user-content-page" class="user-content-page space-y-6">
  <nav
    id="user-content-breadcrumb"
    class="user-content-breadcrumb text-sm breadcrumbs"
    aria-label={gettext("Breadcrumb")}
  >
    <ul>
      <li>
        <.link id="user-content-back-link" navigate={~p"/users/#{@profile_user.username}"}>
          {gettext("Back to profile")}
        </.link>
      </li>
      <li>{@page_title}</li>
    </ul>
  </nav>

  <h1 id="user-content-heading" class="text-2xl font-bold">{@page_title}</h1>

  <div
    :if={@content_type == :articles}
    id="articles"
    class="space-y-2"
    data-focus-target
  >
    <article
      :for={article <- @articles}
      id={"article-#{article.slug}"}
      class="article card bg-base-200 shadow-sm"
    >
      <div class="card-body p-4">
        <.link
          navigate={~p"/articles/#{article.slug}"}
          class="article-title card-title text-base link link-hover"
        >
          {article.title}
        </.link>
        <div class="article-meta text-sm text-base-content/70">
          <time datetime={datetime_attr(article_datetime(article))}>
            {format_datetime(article_datetime(article))}
          </time>
          <span :if={article.boards != []}>
            &middot;
            <span :for={board <- article.boards}>
              <.link navigate={~p"/boards/#{board.slug}"} class="link link-hover">
                {board.name}
              </.link>
            </span>
          </span>
        </div>
      </div>
    </article>

    <div
      :if={@articles == []}
      id="user-content-articles-empty"
      class="user-content-empty text-base-content/70 text-center py-4"
    >
      {gettext("No articles yet.")}
    </div>
  </div>

  <div
    :if={@content_type == :comments}
    id="comments"
    class="space-y-2"
    data-focus-target
  >
    <div
      :for={comment <- @comments}
      id={"comment-#{comment.id}"}
      class="comment card bg-base-200 shadow-sm"
    >
      <div class="card-body p-4">
        <.muted_collapse
          id={"user-content-comment-#{comment.id}-muted"}
          matchers={@muted_matchers}
          own={@current_user && comment.user_id == @current_user.id}
          texts={[
            comment.summary,
            Baudrate.Moderation.PatternMatcher.text_of(comment.body_html || comment.body)
          ]}
        >
          <div :if={comment.body_html} class="comment-body prose prose-sm max-w-none line-clamp-3">
            {BaudrateWeb.SafeHTML.body_html(comment.body_html)}
          </div>
          <div
            :if={!comment.body_html}
            class="comment-body prose prose-sm max-w-none line-clamp-3"
          >
            {BaudrateWeb.SafeHTML.markdown(comment.body)}
          </div>
        </.muted_collapse>
        <div class="comment-meta text-sm text-base-content/70 mt-1">
          <time datetime={datetime_attr(comment.inserted_at)}>
            {format_datetime(comment.inserted_at)}
          </time>
          <span :if={comment.article}>
            &middot; {raw(
              gettext("in %{article}",
                article:
                  "<a href=\"#{~p"/articles/#{comment.article.slug}"}\" class=\"link link-hover\">" <>
                    Phoenix.HTML.safe_to_string(Phoenix.HTML.html_escape(comment.article.title)) <>
                    "</a>"
              )
            )}
          </span>
        </div>
      </div>
    </div>

    <div
      :if={@comments == []}
      id="user-content-comments-empty"
      class="user-content-empty text-base-content/70 text-center py-4"
    >
      {gettext("No comments yet.")}
    </div>
  </div>

  <.pagination
    :if={@total_pages > 1}
    page={@page}
    total_pages={@total_pages}
    path={
      if @content_type == :articles,
        do: ~p"/users/#{@profile_user.username}/articles",
        else: ~p"/users/#{@profile_user.username}/comments"
    }
  />
</div>
