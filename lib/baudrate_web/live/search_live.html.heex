<section id="search-page" aria-labelledby="search-heading" class="search-page mx-auto max-w-2xl">
  <h1 id="search-heading" class="search-heading text-2xl font-bold mb-6">{gettext("Search")}</h1>

  <form id="search-form" phx-submit="search" class="search-form mb-6">
    <div class="join w-full">
      <input
        type="text"
        id="search-query-input"
        name="q"
        value={@query}
        placeholder={
          if @tab == "articles",
            do: gettext("Search... (try author:, board:, tag:)"),
            else: gettext("Search...")
        }
        class="search-query-input input input-bordered join-item flex-1"
        aria-label={gettext("Search query")}
        autofocus
      />
      <button
        type="submit"
        id="search-submit"
        class="search-submit btn btn-primary join-item"
        aria-label={gettext("Search")}
        phx-disable-with={gettext("Searching...")}
      >
        <.icon name="hero-magnifying-glass" class="size-5" />
      </button>
    </div>
    <%!--
      The filters sit inside the form on purpose, so the Search button applies
      them: one submission is one search is one rate-limit hit. They write
      `board:`, `after:` and `before:` into the query string rather than
      carrying parameters of their own, so the box above is always the whole
      description of what is being searched.
    --%>
    <fieldset
      :if={@tab in ["articles", "comments"]}
      id="search-filters"
      class="search-filters mt-3 grid gap-3 sm:grid-cols-2"
    >
      <legend class="search-filters-legend sr-only">{gettext("Refine this search")}</legend>
      <div class="search-filter min-w-0">
        <label for="search-sort" class="search-filter-label label label-text py-1">
          {gettext("Sort by")}
        </label>
        <select
          id="search-sort"
          name="sort"
          class="search-sort select select-bordered select-sm w-full"
        >
          <option
            :for={sort <- sort_options()}
            id={"search-sort-#{sort}"}
            class="search-sort-option"
            value={sort}
            selected={@sort == sort}
          >
            {sort_label(sort)}
          </option>
        </select>
      </div>
      <div class="search-filter min-w-0">
        <label for="search-filter-board" class="search-filter-label label label-text py-1">
          {gettext("Board")}
        </label>
        <select
          id="search-filter-board"
          name="filter_board"
          class="search-filter-board select select-bordered select-sm w-full"
        >
          <option value="" selected={is_nil(@filter_board)}>{gettext("All boards")}</option>
          <option
            :for={{label, slug} <- @filter_board_options}
            id={"search-filter-board-#{slug}"}
            class="search-filter-board-option"
            value={slug}
            selected={@filter_board == slug}
          >
            {label}
          </option>
        </select>
      </div>
      <div class="search-filter min-w-0">
        <label for="search-filter-from" class="search-filter-label label label-text py-1">
          {gettext("Written on or after")}
        </label>
        <input
          type="date"
          id="search-filter-from"
          name="filter_from"
          value={@filter_from}
          class="search-filter-from input input-bordered input-sm w-full"
        />
      </div>
      <div class="search-filter min-w-0">
        <label for="search-filter-to" class="search-filter-label label label-text py-1">
          {gettext("Written on or before")}
        </label>
        <input
          type="date"
          id="search-filter-to"
          name="filter_to"
          value={@filter_to}
          class="search-filter-to input input-bordered input-sm w-full"
        />
      </div>
    </fieldset>
  </form>

  <details
    :if={@tab in ["articles", "comments"]}
    id="search-operators"
    class="search-operators collapse collapse-arrow bg-base-200 mb-4"
  >
    <summary class="search-operators-summary collapse-title text-base font-medium">
      {gettext("Search operators")}
    </summary>
    <div class="collapse-content">
      <div class="overflow-x-auto">
        <table class="table table-sm" role="table">
          <thead>
            <tr>
              <th>{gettext("Operator")}</th>
              <th>{gettext("Description")}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>author:username</code></td>
              <td>
                {if @tab == "comments",
                  do: gettext("Filter by comment author"),
                  else: gettext("Filter by article author")}
              </td>
            </tr>
            <tr>
              <td><code>board:slug</code></td>
              <td>
                {if @tab == "comments",
                  do: gettext("Filter by the board the article is in"),
                  else: gettext("Filter by board")}
              </td>
            </tr>
            <tr>
              <td><code>tag:tagname</code></td>
              <td>
                {if @tab == "comments",
                  do: gettext("Filter by a tag on the article"),
                  else: gettext("Filter by tag")}
              </td>
            </tr>
            <tr>
              <td><code>has:images</code></td>
              <td>
                {if @tab == "comments",
                  do: gettext("Comments with attached images"),
                  else: gettext("Articles with attached images")}
              </td>
            </tr>
            <tr>
              <td><code>before:YYYY-MM-DD</code></td>
              <td>
                {if @tab == "comments",
                  do: gettext("Comments before a date"),
                  else: gettext("Articles before a date")}
              </td>
            </tr>
            <tr>
              <td><code>after:YYYY-MM-DD</code></td>
              <td>
                {if @tab == "comments",
                  do: gettext("Comments after a date"),
                  else: gettext("Articles after a date")}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-base-content/70 mt-2">
        {gettext("Example: %{example}", example: "author:alice tag:elixir phoenix tutorial")}
      </p>
    </div>
  </details>

  <%!-- Remote actor loading indicator --%>
  <div
    :if={@remote_actor_loading}
    class="card bg-base-200 shadow-sm mb-4"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="card-body p-4 flex flex-row items-center gap-3">
      <span class="loading loading-spinner loading-sm"></span>
      <span class="text-base-content/70">{gettext("Looking up remote actor...")}</span>
    </div>
  </div>

  <%!-- Remote actor result card --%>
  <div
    :if={@remote_actor && !@remote_actor_loading}
    id="search-remote-actor"
    class="search-remote-actor card bg-base-200 shadow-sm mb-4"
    role="region"
    aria-label={gettext("Remote actor")}
  >
    <div class="card-body p-4 flex flex-row items-center gap-4">
      <div class="avatar">
        <div class="w-12 h-12 rounded-full bg-base-300 flex items-center justify-center">
          <img
            :if={@remote_actor.avatar_url}
            src={Baudrate.Media.Proxy.url(@remote_actor.avatar_url)}
            alt={@remote_actor.display_name || @remote_actor.username}
            class="rounded-full"
          />
          <.icon
            :if={!@remote_actor.avatar_url}
            name="hero-user-circle"
            class="size-8 opacity-50"
          />
        </div>
      </div>
      <div class="flex-1 min-w-0">
        <a
          id="search-remote-actor-link"
          href={remote_actor_profile_url(@remote_actor)}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="search-remote-actor-link link link-hover"
        >
          <div class="font-bold truncate">
            {display_name(@remote_actor)}
          </div>
          <div class="text-sm text-base-content/70 truncate">
            @{@remote_actor.username}@{@remote_actor.domain}
          </div>
        </a>
        <div
          :if={@remote_actor.summary && @remote_actor.summary != ""}
          class="text-sm text-base-content/70 mt-1 line-clamp-2"
        >
          {Baudrate.Sanitizer.Native.strip_tags(@remote_actor.summary)}
        </div>
        <span
          id="search-remote-actor-type"
          class="search-remote-actor-type badge badge-outline badge-xs mt-1"
        >
          {translate_actor_type(@remote_actor.actor_type)}
        </span>
      </div>
      <div class="flex-none">
        <%= cond do %>
          <% !@current_user -> %>
            <.link id="search-actor-signin" navigate="/login" class="btn btn-sm btn-outline">
              {gettext("Sign in to follow")}
            </.link>
          <% @follow_state == "pending" -> %>
            <button
              id="search-actor-pending"
              phx-click="unfollow"
              phx-value-id={@remote_actor.id}
              aria-label={gettext("Pending — cancel follow request")}
              data-confirm={gettext("Cancel this follow request?")}
              class="search-actor-follow-btn btn btn-sm btn-warning btn-outline"
            >
              {gettext("Pending")}
            </button>
          <% @follow_state == "accepted" -> %>
            <button
              id="search-actor-unfollow"
              phx-click="unfollow"
              phx-value-id={@remote_actor.id}
              data-confirm={gettext("Unfollow this actor?")}
              class="search-actor-follow-btn btn btn-sm btn-outline"
            >
              {gettext("Unfollow")}
            </button>
          <% @follow_state == "rejected" -> %>
            <button
              id="search-actor-follow"
              phx-click="follow"
              phx-value-id={@remote_actor.id}
              class="search-actor-follow-btn btn btn-sm btn-primary"
            >
              {gettext("Follow")}
            </button>
          <% true -> %>
            <button
              id="search-actor-follow"
              phx-click="follow"
              phx-value-id={@remote_actor.id}
              class="search-actor-follow-btn btn btn-sm btn-primary"
            >
              {gettext("Follow")}
            </button>
        <% end %>
      </div>
    </div>
  </div>

  <%!-- Remote object loading indicator --%>
  <div
    :if={@remote_object_loading}
    class="card bg-base-200 shadow-sm mb-4"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="card-body p-4 flex flex-row items-center gap-3">
      <span class="loading loading-spinner loading-sm"></span>
      <span class="text-base-content/70">{gettext("Looking up remote post...")}</span>
    </div>
  </div>

  <%!-- Remote object: already stored locally --%>
  <%= if match?({:existing, _}, @remote_object) && !@remote_object_loading do %>
    <% {:existing, article} = @remote_object %>
    <div
      id="search-remote-object-existing"
      class="search-remote-object card bg-base-200 shadow-sm mb-4"
      role="region"
      aria-label={gettext("Remote post")}
    >
      <div class="card-body p-4">
        <div class="flex items-start gap-3">
          <div :if={article.remote_actor} class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center">
              <img
                :if={article.remote_actor.avatar_url}
                src={Baudrate.Media.Proxy.url(article.remote_actor.avatar_url)}
                alt={display_name(article.remote_actor)}
                class="w-10 h-10 rounded-full"
              />
              <.icon
                :if={!article.remote_actor.avatar_url}
                name="hero-user-circle"
                class="size-7 opacity-50"
              />
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div :if={article.remote_actor} class="text-sm text-base-content/70 mb-1">
              <a
                href={remote_actor_profile_url(article.remote_actor)}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="font-semibold text-base-content link link-hover"
              >
                {display_name(article.remote_actor)}
              </a>
              <span class="text-base-content/70">
                @{article.remote_actor.username}@{article.remote_actor.domain}
              </span>
            </div>
            <.link
              id="search-remote-object-title"
              navigate={~p"/articles/#{article.slug}"}
              class="search-remote-object-title font-bold text-base link link-hover"
            >
              {article.title}
            </.link>
            <p class="text-sm mt-1 line-clamp-3">{String.slice(article.body || "", 0..300)}</p>
            <div class="flex items-center gap-2 mt-2 text-xs text-base-content/70">
              <span class="badge badge-outline badge-xs">{gettext("Remote post")}</span>
              <span class="badge badge-outline badge-xs">{translate_visibility(article.visibility)}</span>
              <time :if={article.inserted_at} datetime={datetime_attr(article_datetime(article))}>
                {format_datetime(article_datetime(article))}
              </time>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2 mt-3 pt-3 border-t border-base-300">
          <.link
            id="search-remote-object-view"
            navigate={~p"/articles/#{article.slug}"}
            class="search-remote-object-view btn btn-sm btn-primary"
          >
            <.icon name="hero-arrow-top-right-on-square" class="size-4" />
            {gettext("View article")}
          </.link>
          <a
            :if={article.url}
            id="search-remote-object-original"
            href={article.url}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="search-remote-object-original btn btn-sm btn-ghost"
          >
            <.icon name="hero-globe-alt" class="size-4" />
            {gettext("View original")}
          </a>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Remote object: preview (not yet stored) --%>
  <%= if match?({:preview, _}, @remote_object) && !@remote_object_loading do %>
    <% {:preview, preview} = @remote_object %>
    <div
      id="search-remote-object-preview"
      class="search-remote-object card bg-base-200 shadow-sm mb-4"
      role="region"
      aria-label={gettext("Remote post")}
    >
      <div class="card-body p-4">
        <div class="flex items-start gap-3">
          <div :if={preview.remote_actor} class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center">
              <img
                :if={preview.remote_actor.avatar_url}
                src={Baudrate.Media.Proxy.url(preview.remote_actor.avatar_url)}
                alt={display_name(preview.remote_actor)}
                class="w-10 h-10 rounded-full"
              />
              <.icon
                :if={!preview.remote_actor.avatar_url}
                name="hero-user-circle"
                class="size-7 opacity-50"
              />
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div :if={preview.remote_actor} class="text-sm text-base-content/70 mb-1">
              <a
                href={remote_actor_profile_url(preview.remote_actor)}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="font-semibold text-base-content link link-hover"
              >
                {display_name(preview.remote_actor)}
              </a>
              <span class="text-base-content/70">
                @{preview.remote_actor.username}@{preview.remote_actor.domain}
              </span>
            </div>
            <h3 class="search-remote-object-title font-bold text-base">{preview.title}</h3>
            <p class="text-sm mt-1 line-clamp-3">{String.slice(preview.body || "", 0..300)}</p>
            <div class="flex items-center gap-2 mt-2 text-xs text-base-content/70">
              <span class="badge badge-outline badge-xs">{gettext("Remote post")}</span>
              <span class="badge badge-outline badge-xs">{translate_visibility(preview.visibility)}</span>
              <time :if={preview.published_at} datetime={datetime_attr(preview.published_at)}>
                {format_datetime(preview.published_at)}
              </time>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2 mt-3 pt-3 border-t border-base-300">
          <%= if @current_user do %>
            <button
              id="search-remote-object-import"
              phx-click="import_remote_object"
              phx-value-url={preview.ap_id}
              class="search-remote-object-import btn btn-sm btn-primary"
              phx-disable-with={gettext("Importing...")}
            >
              <.icon name="hero-arrow-down-tray" class="size-4" />
              {gettext("Import & interact")}
            </button>
          <% else %>
            <.link
              id="search-remote-object-signin"
              navigate="/login"
              class="btn btn-sm btn-outline"
            >
              {gettext("Sign in to interact")}
            </.link>
          <% end %>
          <a
            :if={preview.url}
            id="search-remote-object-preview-original"
            href={preview.url}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="search-remote-object-original btn btn-sm btn-ghost"
          >
            <.icon name="hero-globe-alt" class="size-4" />
            {gettext("View original")}
          </a>
        </div>
      </div>
    </div>
  <% end %>

  <div
    :if={@query != ""}
    id="search-tabs"
    role="tablist"
    aria-label={gettext("Search results")}
    class="search-tabs tabs tabs-bordered mb-4"
  >
    <.link
      id="tab-articles"
      patch={~p"/search?#{%{q: @query, tab: "articles", sort: @sort}}"}
      role="tab"
      aria-selected={to_string(@tab == "articles")}
      class={"search-tab tab #{if @tab == "articles", do: "tab-active"}"}
    >
      {gettext("Articles")}
    </.link>
    <.link
      id="tab-comments"
      patch={~p"/search?#{%{q: @query, tab: "comments", sort: @sort}}"}
      role="tab"
      aria-selected={to_string(@tab == "comments")}
      class={"search-tab tab #{if @tab == "comments", do: "tab-active"}"}
    >
      {gettext("Comments")}
    </.link>
    <.link
      id="tab-boards"
      patch={~p"/search?#{%{q: @query, tab: "boards", sort: @sort}}"}
      role="tab"
      aria-selected={to_string(@tab == "boards")}
      class={"search-tab tab #{if @tab == "boards", do: "tab-active"}"}
    >
      {gettext("Boards")}
    </.link>
    <.link
      id="tab-users"
      patch={~p"/search?#{%{q: @query, tab: "users", sort: @sort}}"}
      role="tab"
      aria-selected={to_string(@tab == "users")}
      class={"search-tab tab #{if @tab == "users", do: "tab-active"}"}
    >
      {gettext("Users")}
    </.link>
  </div>

  <%!--
    A query that names nothing to search within is refused rather than
    answered with everything the viewer can see — see ADR 0055 and
    `Baudrate.Content.SearchQuery`. The message has to say what to add, or it
    reads as "no results" for a query that plainly matches things.
  --%>
  <div
    :if={@no_scope}
    id="search-no-scope"
    role="status"
    class="search-no-scope alert alert-info"
  >
    <.icon name="hero-information-circle" class="size-5 shrink-0" />
    <span class="search-no-scope-text">
      {gettext(
        "A search needs something to search within. Add a word, or an author:, board: or tag: — a date range on its own would list everything."
      )}
    </span>
  </div>

  <div
    :if={@query != "" && !@no_scope && @tab == "articles" && @articles == []}
    id="search-empty-articles"
    role="tabpanel"
    aria-labelledby="tab-articles"
    class="search-empty text-base-content/70 text-center py-8"
  >
    {gettext("No articles found for \"%{query}\".", query: @query)}
  </div>

  <div
    :if={@query != "" && !@no_scope && @tab == "comments" && @comments == []}
    id="search-empty-comments"
    role="tabpanel"
    aria-labelledby="tab-comments"
    class="search-empty text-base-content/70 text-center py-8"
  >
    {gettext("No comments found for \"%{query}\".", query: @query)}
  </div>

  <div
    :if={@query != "" && @tab == "boards" && @boards == []}
    id="search-empty-boards"
    role="tabpanel"
    aria-labelledby="tab-boards"
    class="search-empty text-base-content/70 text-center py-8"
  >
    {gettext("No boards found for \"%{query}\".", query: @query)}
  </div>

  <div
    :if={@query != "" && @tab == "users" && @local_users == []}
    id="search-empty-users"
    role="tabpanel"
    aria-labelledby="tab-users"
    class="search-empty text-base-content/70 text-center py-8"
  >
    {gettext("No users found for \"%{query}\".", query: @query)}
  </div>

  <div
    :if={@query != "" && @total > 0}
    id="search-result-count"
    class="search-result-count text-sm text-base-content/70 mb-4"
    aria-live="polite"
    role="status"
  >
    <%= if @total_pages > 1 do %>
      {gettext("Page %{page} of %{total_pages} — %{count} results total",
        page: @page,
        total_pages: @total_pages,
        count: @total
      )}
    <% else %>
      {ngettext("%{count} result", "%{count} results", @total, count: @total)}
    <% end %>
  </div>

  <div
    :if={@tab == "articles" && @articles != []}
    id="search-results-articles"
    role="tabpanel"
    aria-labelledby="tab-articles"
    class="space-y-2"
    data-focus-target
  >
    <article
      :for={article <- @articles}
      id={"search-article-#{article.slug}"}
      aria-labelledby={"search-article-title-#{article.slug}"}
      class="article card bg-base-200 shadow-sm"
    >
      <div class="card-body p-4">
        <.link
          navigate={~p"/articles/#{article.slug}"}
          id={"search-article-title-#{article.slug}"}
          class="search-result-title card-title text-base link link-hover"
        >
          {article.title}
        </.link>
        <div class="text-sm text-base-content/70">
          <span :if={article.user}>
            {gettext("by %{author}", author: display_name(article.user))} &middot;
          </span>
          <span :if={article.remote_actor} class="inline-flex items-center gap-1">
            {gettext("by")}
            <a
              href={remote_actor_profile_url(article.remote_actor)}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="inline-flex items-center gap-1 font-semibold link link-hover"
            >
              <span class="w-6 h-6 rounded-full bg-base-300 inline-flex items-center justify-center shrink-0">
                <img
                  :if={article.remote_actor.avatar_url}
                  src={Baudrate.Media.Proxy.url(article.remote_actor.avatar_url)}
                  alt={display_name(article.remote_actor)}
                  class="w-6 h-6 rounded-full"
                />
                <.icon
                  :if={!article.remote_actor.avatar_url}
                  name="hero-user-circle"
                  class="size-5 opacity-50"
                />
              </span>
              {display_name(article.remote_actor)}<span class="text-base-content/70">@{article.remote_actor.domain}</span>
            </a>
            &middot;
          </span>
          <time datetime={datetime_attr(article_datetime(article))}>
            {format_datetime(article_datetime(article))}
          </time>
          <span :if={article.boards != []}>&middot;</span>
          <span :for={board <- article.boards} class="badge badge-outline badge-sm ml-1">
            {board.name}
          </span>
        </div>
      </div>
    </article>
  </div>

  <div
    :if={@tab == "comments" && @comments != []}
    id="search-results-comments"
    role="tabpanel"
    aria-labelledby="tab-comments"
    class="space-y-2"
    data-focus-target
  >
    <div
      :for={comment <- @comments}
      id={"search-comment-#{comment.id}"}
      class="comment card bg-base-200 shadow-sm"
    >
      <div class="card-body p-4">
        <.link
          id={"search-comment-title-#{comment.id}"}
          navigate={~p"/articles/#{comment.article.slug}"}
          class="search-result-title card-title text-base link link-hover"
        >
          {comment.article.title}
        </.link>
        <p class="text-sm line-clamp-2">{String.slice(comment.body, 0..200)}</p>
        <div class="text-sm text-base-content/70">
          <span :if={comment.user}>
            {gettext("by %{author}", author: display_name(comment.user))} &middot;
          </span>
          <a
            :if={comment.remote_actor}
            href={remote_actor_profile_url(comment.remote_actor)}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="inline-flex items-center gap-1 link link-hover"
          >
            <span class="w-6 h-6 rounded-full bg-base-300 inline-flex items-center justify-center shrink-0">
              <img
                :if={comment.remote_actor.avatar_url}
                src={Baudrate.Media.Proxy.url(comment.remote_actor.avatar_url)}
                alt={display_name(comment.remote_actor)}
                class="w-6 h-6 rounded-full"
              />
              <.icon
                :if={!comment.remote_actor.avatar_url}
                name="hero-user-circle"
                class="size-5 opacity-50"
              />
            </span>
            {display_name(comment.remote_actor)}
          </a>
          <span :if={comment.remote_actor}>&middot;</span>
          <time datetime={datetime_attr(comment.inserted_at)}>
            {format_datetime(comment.inserted_at)}
          </time>
        </div>
      </div>
    </div>
  </div>

  <div
    :if={@tab == "boards" && @boards != []}
    id="search-results-boards"
    role="tabpanel"
    aria-labelledby="tab-boards"
    class="space-y-2"
    data-focus-target
  >
    <div
      :for={board <- @boards}
      id={"search-board-#{board.slug}"}
      class="board card bg-base-200 shadow-sm"
    >
      <div class="card-body p-4">
        <.link
          id={"search-board-title-#{board.slug}"}
          navigate={~p"/boards/#{board.slug}"}
          class="search-result-title card-title text-base link link-hover"
        >
          {board.name}
        </.link>
        <p :if={board.description && board.description != ""} class="text-sm line-clamp-2">
          {board.description}
        </p>
        <div :if={board.parent} class="text-sm text-base-content/70">
          <span class="badge badge-outline badge-sm">
            {board.parent.name}
          </span>
        </div>
      </div>
    </div>
  </div>

  <%!-- Local users results --%>
  <div
    :if={@tab == "users" && @local_users != []}
    id="search-results-users"
    role="tabpanel"
    aria-labelledby="tab-users"
    class="space-y-2"
    data-focus-target
  >
    <div
      :for={user <- @local_users}
      id={"search-user-#{user.username}"}
      class="user card bg-base-200 shadow-sm"
    >
      <div class="card-body p-4 flex flex-row items-center gap-4">
        <.avatar user={user} size={48} />
        <div class="flex-1 min-w-0">
          <.link
            id={"search-user-link-#{user.username}"}
            navigate={~p"/users/#{user.username}"}
            class="search-result-title font-bold truncate link link-hover"
          >
            {display_name(user)}
          </.link>
          <div
            :if={user.bio && user.bio != ""}
            class="text-sm text-base-content/70 mt-1 line-clamp-2"
          >
            {user.bio}
          </div>
          <div class="flex items-center gap-2 mt-1">
            <span class="badge badge-outline badge-xs">{translate_role(user.role.name)}</span>
            <span class="badge badge-info badge-xs">{gettext("Local")}</span>
          </div>
        </div>
        <div class="flex-none">
          <%= cond do %>
            <% !@current_user -> %>
              <.link
                id={"search-user-signin-#{user.username}"}
                navigate="/login"
                class="btn btn-sm btn-outline"
              >
                {gettext("Sign in to follow")}
              </.link>
            <% @local_user_follow_states[user.id] == "accepted" -> %>
              <button
                id={"search-user-unfollow-#{user.username}"}
                phx-click="unfollow_user"
                phx-value-id={user.id}
                data-confirm={gettext("Unfollow this user?")}
                class="search-user-follow-btn btn btn-sm btn-outline"
              >
                {gettext("Unfollow")}
              </button>
            <% @local_user_follow_states[user.id] == "pending" -> %>
              <button
                id={"search-user-requested-#{user.username}"}
                phx-click="unfollow_user"
                phx-value-id={user.id}
                data-confirm={gettext("Withdraw your follow request?")}
                class="search-user-follow-btn btn btn-sm btn-outline"
              >
                {gettext("Follow Requested")}
              </button>
            <% true -> %>
              <button
                id={"search-user-follow-#{user.username}"}
                phx-click="follow_user"
                phx-value-id={user.id}
                class="search-user-follow-btn btn btn-sm btn-primary"
              >
                {gettext("Follow")}
              </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%!--
    The member list is paged but not walkable: ADR 0057 keeps profiles public
    and linked from every byline while refusing to enumerate them.
  --%>
  <div
    :if={@users_capped}
    id="search-users-capped"
    role="status"
    class="search-users-capped text-base-content/70 text-center text-sm py-4"
  >
    {gettext("More people match than are shown here. Try a more specific name.")}
  </div>

  <.pagination
    :if={@total_pages > 1}
    page={@page}
    total_pages={@total_pages}
    path={~p"/search"}
    params={%{"q" => @query, "tab" => @tab, "sort" => to_string(@sort)}}
  />
</section>
