<div id="drafts-page" class="drafts-page space-y-6">
  <div class="flex items-center justify-between gap-4">
    <h1 id="drafts-heading" class="drafts-heading text-2xl font-bold">{gettext("Drafts")}</h1>
    <.link id="drafts-new-article" navigate={~p"/articles/new"} class="btn btn-primary btn-sm">
      {gettext("New Article")}
    </.link>
  </div>

  <p id="drafts-explainer" class="drafts-explainer text-sm text-base-content/70">
    {gettext(
      "An unfinished article is saved here as you write, so you can pick it up on another device. Drafts are private to you, and one untouched for %{days} days is removed.",
      days: Baudrate.Content.Drafts.stale_after_days()
    )}
  </p>

  <div
    :if={@drafts == []}
    id="drafts-empty"
    class="drafts-empty text-base-content/70 text-center py-8"
  >
    {gettext("You have no drafts. Anything you start writing will appear here.")}
  </div>

  <ul :if={@drafts != []} id="drafts-list" class="drafts-list space-y-3 list-none pl-0">
    <li
      :for={draft <- @drafts}
      id={"draft-#{draft.id}"}
      class="draft-item card bg-base-100 border border-base-300"
    >
      <div class="card-body p-4 gap-2">
        <h2 class="draft-item-heading font-semibold break-words">
          {BaudrateWeb.DraftsLive.draft_heading(draft)}
        </h2>

        <p class="draft-item-meta text-sm text-base-content/70">
          {gettext("Last saved %{at}", at: format_datetime(draft.updated_at))}
          <span :if={draft.board_ids != []} class="draft-item-boards">
            &middot; {ngettext(
              "%{count} board selected",
              "%{count} boards selected",
              length(draft.board_ids)
            )}
          </span>
          <span :if={draft.image_ids != []} class="draft-item-images">
            &middot; {ngettext(
              "%{count} image",
              "%{count} images",
              length(draft.image_ids)
            )}
          </span>
        </p>

        <div class="draft-item-actions flex gap-2 justify-end">
          <.link
            id={"draft-resume-#{draft.id}"}
            navigate={~p"/articles/new?draft=#{draft.id}"}
            class="draft-resume btn btn-sm btn-primary"
          >
            {gettext("Resume")}
          </.link>
          <button
            id={"draft-delete-#{draft.id}"}
            phx-click="delete"
            phx-value-id={draft.id}
            data-confirm={gettext("Delete this draft? This cannot be undone.")}
            class="draft-delete btn btn-sm btn-ghost"
          >
            {gettext("Delete")}
          </button>
        </div>
      </div>
    </li>
  </ul>

  <section
    :if={@held_posts != []}
    id="drafts-held"
    class="drafts-held space-y-3"
    aria-labelledby="drafts-held-heading"
  >
    <h2 id="drafts-held-heading" class="drafts-held-heading text-lg font-semibold">
      {gettext("Waiting for review")}
    </h2>
    <p id="drafts-held-explainer" class="drafts-held-explainer text-sm text-base-content/70">
      {gettext(
        "A moderator looks at these before anyone else can see them. You'll get a notification either way."
      )}
    </p>

    <ul id="drafts-held-list" class="drafts-held-list space-y-3 list-none pl-0">
      <li
        :for={held <- @held_posts}
        id={"held-#{held.id}"}
        class="drafts-held-item card bg-base-100 border border-base-300"
      >
        <div class="card-body p-4 gap-2">
          <h3 class="drafts-held-item-heading font-semibold break-words">
            {BaudrateWeb.DraftsLive.held_heading(held)}
          </h3>
          <p class="drafts-held-item-meta text-sm text-base-content/70">
            <span
              :if={held.status == "pending"}
              id={"held-status-#{held.id}"}
              class="drafts-held-status badge badge-sm badge-warning"
            >
              {gettext("Awaiting review")}
            </span>
            <span
              :if={held.status == "rejected"}
              id={"held-status-#{held.id}"}
              class="drafts-held-status badge badge-sm badge-ghost"
            >
              {gettext("Declined")}
            </span>
            {gettext("Sent %{at}", at: format_datetime(held.inserted_at))}
          </p>
          <p
            :if={held.status == "rejected" && held.review_note}
            id={"held-note-#{held.id}"}
            class="drafts-held-note text-sm break-words"
          >
            {gettext("The moderator's note: %{note}", note: held.review_note)}
          </p>
          <details id={"held-text-#{held.id}"} class="drafts-held-text">
            <summary class="drafts-held-text-summary text-sm cursor-pointer">
              {gettext("What you wrote")}
            </summary>
            <div class="drafts-held-text-body text-sm whitespace-pre-wrap break-words mt-2 max-h-64 overflow-y-auto">
              {held.body}
            </div>
          </details>
          <div :if={held.status == "pending"} class="drafts-held-actions flex justify-end">
            <button
              id={"held-withdraw-#{held.id}"}
              type="button"
              phx-click="withdraw_held"
              phx-value-id={held.id}
              data-confirm={gettext("Withdraw this post? It will not be published.")}
              class="drafts-held-withdraw btn btn-sm btn-ghost"
            >
              {gettext("Withdraw")}
            </button>
          </div>
        </div>
      </li>
    </ul>
  </section>

  <p id="drafts-quota" class="drafts-quota text-sm text-base-content/70">
    {gettext("%{count} of %{limit} drafts kept", count: @draft_count, limit: @max_drafts)}
  </p>
</div>
