<div id="login-page" class="login-page mx-auto max-w-sm mt-10">
  <h1 id="login-heading" class="text-2xl font-bold text-center mb-2">{gettext("Sign In")}</h1>
  <p id="login-subtitle" class="login-subtitle text-center text-base-content/70 mb-8">
    {gettext("Enter your credentials to continue.")}
  </p>

  <.form for={@form} id="login-form" phx-change="validate" phx-submit="submit" class="space-y-4">
    <div class="form-control">
      <label id="login-username-label" class="login-field-label label" for="login_username">
        <span class="label-text">{gettext("Username")}</span>
      </label>
      <input
        type="text"
        id="login_username"
        name="login[username]"
        value={@form[:username].value}
        class="login-username-input input input-bordered w-full"
        autocomplete="username"
        required
        aria-required="true"
      />
    </div>

    <div class="form-control">
      <label id="login-password-label" class="login-field-label label" for="login_password">
        <span class="label-text">{gettext("Password")}</span>
      </label>
      <input
        type="password"
        id="login_password"
        name="login[password]"
        value={@form[:password].value}
        class="login-password-input input input-bordered w-full"
        autocomplete="current-password"
        required
        aria-required="true"
      />
    </div>

    <button
      id="login-submit"
      type="submit"
      class="login-submit btn btn-primary w-full"
      phx-disable-with={gettext("Signing in...")}
    >
      {gettext("Sign In")}
    </button>
  </.form>

  <form
    id="session-form"
    action="/auth/session"
    method="post"
    phx-trigger-action={@trigger_action}
  >
    <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
    <input type="hidden" name="token" value={@token} />
    <input :if={@return_to} type="hidden" name="return_to" value={@return_to} />
  </form>

  <nav id="login-help-nav" aria-label={gettext("Login help")}>
    <p class="text-center text-sm mt-4">
      <.link
        id="login-forgot-password-link"
        navigate="/password-reset"
        class="login-forgot-password-link link link-hover text-base-content/70"
      >
        {gettext("Forgot your password?")}
      </.link>
    </p>

    <p class="text-center text-sm mt-2">
      {gettext("Don't have an account?")}
      <.link
        id="login-register-link"
        navigate="/register"
        class="login-register-link link link-primary"
      >
        {gettext("Sign Up")}
      </.link>
    </p>
  </nav>
</div>
