<.profile_page current={:account} id="profile-account-page" title={gettext("Account")}>
  <%!-- Preferred Languages section --%>
  <section id="profile-languages" aria-labelledby="profile-languages-heading">
    <h2
      id="profile-languages-heading"
      class="profile-field-label profile-section-heading text-sm text-base-content/70 mb-2"
    >
      {gettext("Preferred Languages")}
    </h2>
    <%= if @preferred_locales == [] do %>
      <div class="profile-languages-empty text-sm text-base-content/70 italic">
        {gettext("Using browser language settings.")}
      </div>
    <% else %>
      <div class="space-y-1">
        <%= for {locale, idx} <- Enum.with_index(@preferred_locales) do %>
          <div
            id={"profile-locale-#{locale}"}
            class="profile-locale-row flex items-center gap-2"
          >
            <span class="profile-locale-rank badge badge-sm badge-neutral">{idx + 1}</span>
            <span class="profile-locale-name font-semibold">
              {BaudrateWeb.Locale.locale_display_name(locale)}
            </span>
            <span class="profile-locale-code text-sm text-base-content/70">{locale}</span>
            <div class="ml-auto flex gap-1">
              <button
                :if={idx > 0}
                id={"profile-locale-up-#{locale}"}
                type="button"
                class="profile-locale-up btn btn-sm btn-ghost"
                phx-click="move_locale_up"
                phx-value-locale={locale}
                aria-label={gettext("Move %{locale} up", locale: locale)}
              >
                &uarr;
              </button>
              <button
                :if={idx < length(@preferred_locales) - 1}
                id={"profile-locale-down-#{locale}"}
                type="button"
                class="profile-locale-down btn btn-sm btn-ghost"
                phx-click="move_locale_down"
                phx-value-locale={locale}
                aria-label={gettext("Move %{locale} down", locale: locale)}
              >
                &darr;
              </button>
              <button
                id={"profile-locale-remove-#{locale}"}
                type="button"
                class="profile-locale-remove btn btn-sm btn-ghost btn-error"
                phx-click="remove_locale"
                phx-value-locale={locale}
                aria-label={gettext("Remove")}
              >
                &times;
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unselected =
      Enum.reject(@available_locales, fn {code, _} -> code in @preferred_locales end) %>
    <%= if unselected != [] do %>
      <div class="dropdown mt-2">
        <button
          id="profile-add-language"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          class="profile-add-language btn btn-sm btn-outline"
        >
          {gettext("Add Language")}
        </button>
        <ul
          id="profile-add-language-menu"
          class="profile-add-language-menu dropdown-content menu bg-base-200 rounded-box z-10 w-52 p-2 shadow-sm"
        >
          <%= for {code, name} <- unselected do %>
            <li>
              <button
                id={"profile-add-locale-#{code}"}
                class="profile-add-locale"
                type="button"
                phx-click="add_locale"
                phx-value-locale={code}
              >
                {name}
                <span class="text-sm text-base-content/70">{code}</span>
              </button>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%!-- The session write a LiveView cannot make. `SetLocale` reads a
    member's language out of `session[:preferred_locales]`, written only at
    login, so without this the next full page load renders its dead HTML —
    and `<html lang>` — in the old language. Submitted only when the
    effective locale actually moved (see `save_locales/2`). --%>
    <form
      id="locale-sync-form"
      method="post"
      action={~p"/locale"}
      class="hidden"
      phx-trigger-action={@trigger_locale_sync}
    >
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
      <input type="hidden" name="locale" value={@locale_sync_value} />
      <input type="hidden" name="return_to" value="/profile/account" />
    </form>
  </section>

  <section id="profile-time-zone" aria-labelledby="profile-time-zone-heading">
    <h2
      id="profile-time-zone-heading"
      class="profile-field-label profile-section-heading text-sm text-base-content/70 mb-2"
    >
      {gettext("Time Zone")}
    </h2>
    <p id="profile-time-zone-current" class="profile-field-hint text-sm text-base-content/70 mb-2">
      {gettext("Times on this site are shown to you in %{zone}.",
        zone:
          @current_user.time_zone || gettext("the site's time zone (%{zone})", zone: @site_zone)
      )}
    </p>
    <.form
      for={@time_zone_form}
      id="profile-time-zone-form"
      class="profile-time-zone-form flex flex-wrap items-end gap-2"
      phx-change="validate_time_zone"
      phx-submit="save_time_zone"
    >
      <div class="form-control">
        <label id="profile-time-zone-label" class="label" for="profile-time-zone-select">
          <span class="label-text">{gettext("Time zone")}</span>
        </label>
        <select
          id="profile-time-zone-select"
          name="time_zone[time_zone]"
          class="profile-time-zone-select select select-bordered select-sm w-full max-w-xs"
        >
          {Phoenix.HTML.Form.options_for_select(
            [{gettext("Site default (%{zone})", zone: @site_zone), ""} | @zones],
            @time_zone_form[:time_zone].value || ""
          )}
        </select>
      </div>
      <button
        id="profile-time-zone-save"
        type="submit"
        class="profile-time-zone-save btn btn-sm btn-primary"
        phx-disable-with={gettext("Saving...")}
      >
        {gettext("Save Time Zone")}
      </button>
      <button
        id="profile-time-zone-device"
        type="button"
        phx-hook="DeviceTimeZoneHook"
        class="profile-time-zone-device btn btn-sm btn-outline"
      >
        {gettext("Use this device's time zone")}
      </button>
    </.form>
  </section>

  <div id="profile-data-export">
    <div class="profile-field-label text-sm text-base-content/70">
      {gettext("Your Data")}
    </div>
    <div class="profile-field-value">
      <.link
        id="profile-data-export-link"
        navigate={~p"/profile/export"}
        class="profile-data-export-link btn btn-sm btn-outline"
      >
        {gettext("Export Your Data")}
      </.link>
    </div>
  </div>

  <div id="profile-account-migration">
    <div class="profile-field-label text-sm text-base-content/70">
      {gettext("Account Migration")}
    </div>
    <div class="profile-field-value">
      <.link
        id="profile-account-migration-link"
        navigate={~p"/profile/move"}
        class="profile-account-migration-link btn btn-sm btn-outline"
      >
        {gettext("Aliases and Moving")}
      </.link>
    </div>
  </div>

  <section
    id="profile-account-deletion"
    class="profile-account-deletion"
    aria-labelledby="profile-account-deletion-heading"
  >
    <h2
      id="profile-account-deletion-heading"
      class="profile-field-label profile-section-heading text-sm text-base-content/70 mb-2"
    >
      {gettext("Delete Your Account")}
    </h2>
    <%= if @deletion_eligibility == :ok do %>
      <div
        id="profile-account-deletion-explained"
        class="profile-account-deletion-explained text-sm space-y-2 mb-3"
      >
        <p>
          {gettext(
            "Your profile, security keys, sessions, drafts and the text of your direct messages are removed. Your username stays reserved and cannot be registered again."
          )}
        </p>
        <p>
          {gettext(
            "It happens 7 days after you ask, and signing in again before then cancels it."
          )}
        </p>
        <p>
          {gettext(
            "Your articles and comments stay, shown as \"deleted account\", unless you choose to withdraw them below. Your replies to posts from other servers stay either way."
          )}
        </p>
        <p>
          {gettext(
            "Other servers are told the account is gone, and most of them then remove everything it posted there."
          )}
        </p>
        <p :if={@can_export} id="profile-account-deletion-export">
          {gettext(
            "Want a copy first? Export your data and download it before you ask: asking cancels an export in progress."
          )}
          <.link
            id="profile-account-deletion-export-link"
            navigate={~p"/profile/export"}
            class="profile-account-deletion-export-link link"
          >
            {gettext("Export Your Data")}
          </.link>
        </p>
      </div>

      <%!-- No phx-change: a re-render would erase the typed password. --%>
      <.form
        for={@deletion_form}
        id="account-deletion-form"
        class="account-deletion-form space-y-3"
        phx-submit="request_deletion"
      >
        <div class="form-control">
          <label
            id="account-deletion-withdraw-label"
            class="account-deletion-withdraw-label label cursor-pointer justify-start gap-2"
            for="account-deletion-withdraw"
          >
            <input type="hidden" name="deletion[withdraw_content]" value="false" />
            <input
              type="checkbox"
              id="account-deletion-withdraw"
              name="deletion[withdraw_content]"
              value="true"
              checked={@deletion_form[:withdraw_content].value == "true"}
              class="account-deletion-withdraw checkbox checkbox-sm"
              aria-describedby="account-deletion-withdraw-hint"
            />
            <span class="label-text">{gettext("Also withdraw my articles and comments")}</span>
          </label>
          <p
            id="account-deletion-withdraw-hint"
            class="account-deletion-withdraw-hint text-xs text-base-content/70"
          >
            {gettext(
              "Withdrawing an article also hides every reply to it, including other members'. After 90 days they are deleted for good."
            )}
          </p>
        </div>
        <div class="form-control">
          <label
            id="account-deletion-password-label"
            class="account-deletion-label label"
            for="account-deletion-password"
          >
            <span class="label-text">{gettext("Password")}</span>
          </label>
          <input
            type="password"
            id="account-deletion-password"
            name="deletion[password]"
            class="account-deletion-password input input-bordered input-sm w-full max-w-xs"
            autocomplete="current-password"
            required
          />
        </div>
        <div :if={@current_user.totp_enabled} class="form-control">
          <label
            id="account-deletion-code-label"
            class="account-deletion-label label"
            for="account-deletion-code"
          >
            <span class="label-text">{gettext("Current TOTP Code")}</span>
          </label>
          <input
            type="text"
            id="account-deletion-code"
            name="deletion[code]"
            class="account-deletion-code input input-bordered input-sm w-full max-w-xs tracking-widest"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            required
            aria-describedby="account-deletion-code-hint"
          />
          <.totp_code_hint id="account-deletion-code-hint" />
        </div>
        <button
          id="account-deletion-submit"
          type="submit"
          class="account-deletion-submit btn btn-sm btn-error"
          data-confirm={
            gettext("Delete your account in 7 days? Signing in again before then cancels it.")
          }
          phx-disable-with={gettext("Requesting...")}
        >
          <.icon name="hero-trash" class="w-4 h-4 mr-1" />
          {gettext("Delete My Account")}
        </button>
      </.form>
    <% else %>
      <p
        id="profile-account-deletion-ineligible"
        class="profile-account-deletion-ineligible text-sm text-base-content/70"
      >
        {deletion_ineligible_message(elem(@deletion_eligibility, 1))}
      </p>
    <% end %>

    <%!-- A LiveView cannot clear its own cookie: once the request is made,
    this form signs the session out and lands on /login with the date. --%>
    <form
      id="account-deletion-signout-form"
      method="post"
      action={~p"/account/deletion-requested"}
      class="hidden"
      phx-trigger-action={@trigger_deletion_signout}
    >
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
    </form>
  </section>
</.profile_page>
