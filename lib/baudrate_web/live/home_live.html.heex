<div :if={@current_user} id="welcome-section" class="home-welcome text-center">
  <h1 id="home-welcome-heading" class="home-welcome-heading text-2xl font-bold mb-4">
    {gettext("Welcome, %{username}!", username: display_name(@current_user))}
  </h1>
  <p id="home-welcome-role" class="home-welcome-role text-base-content/70 mb-8">
    {gettext("You are signed in as %{role}.", role: translate_role(@current_user.role.name))}
  </p>
</div>

<div :if={!@current_user} id="welcome-section-guest" class="home-welcome-guest text-center">
  <h1 id="home-welcome-guest-heading" class="home-welcome-heading text-2xl font-bold mb-4">
    {gettext("Welcome to Baudrate")}
  </h1>
  <p id="home-welcome-guest-intro" class="home-welcome-intro text-base-content/70 mb-8">
    <span :if={@boards != []} id="home-welcome-browse-hint" class="home-welcome-browse-hint">
      {gettext("Browse the boards below, or")}
    </span>
    <span :if={@boards == []} id="home-welcome-nothing-hint" class="home-welcome-nothing-hint">
      {gettext("No boards are open to visitors yet —")}
    </span>
    <.link id="home-welcome-login-link" navigate="/login" class="link link-primary">
      {gettext("sign in")}
    </.link>
    /
    <.link id="home-welcome-register-link" navigate="/register" class="link link-primary">
      {gettext("register")}
    </.link>
    {gettext("to participate.")}
  </p>
</div>

<section id="boards-section" class="home-boards-section" aria-labelledby="boards-heading">
  <h2 id="boards-heading" class="home-boards-heading text-xl font-bold mb-4">
    {gettext("Boards")}
  </h2>
  <div
    :if={@boards == []}
    id="boards-empty"
    class="home-boards-empty text-center py-12 text-base-content/70"
  >
    <.icon name="hero-rectangle-stack" class="size-12 mx-auto mb-4 opacity-50" />
    <p id="boards-empty-message" class="home-boards-empty-message text-lg">
      {gettext("No boards to show.")}
    </p>
    <p
      :if={!@current_user}
      id="boards-empty-guest-hint"
      class="home-boards-empty-hint text-sm"
    >
      {gettext("Signing in may show more.")}
    </p>
  </div>
  <div
    :if={@boards != []}
    id="boards"
    class="grid grid-cols-1 md:grid-cols-2 gap-2"
    data-focus-target
  >
    <.link
      :for={board <- @boards}
      id={"board-#{board.slug}"}
      navigate={~p"/boards/#{board.slug}"}
      class="board tappable-card card bg-base-200 shadow-sm hover:bg-base-300 transition-colors"
    >
      <div class="card-body p-4">
        <h3 class="home-board-name card-title text-base">
          {board.name}
          <span
            :if={@current_user && MapSet.member?(@unread_board_ids, board.id)}
            class="inline-block w-2 h-2 flex-shrink-0 rounded-full bg-primary"
            role="img"
            aria-label={gettext("Unread")}
          >
            <span class="sr-only">{gettext("Unread")}</span>
          </span>
        </h3>
        <p :if={board.description} class="home-board-description text-sm text-base-content/70">
          {board.description}
        </p>
      </div>
    </.link>
  </div>
</section>
