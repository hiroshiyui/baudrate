<article id="policy-page" class="policy-page max-w-3xl mx-auto space-y-6">
  <header id="policy-header" class="policy-header">
    <h1 id="policy-heading" class="policy-title text-3xl font-bold break-words">
      {title(@policy)}
    </h1>
  </header>

  <div :if={@body} id="policy-body" class="policy-body prose max-w-none break-words">
    {BaudrateWeb.SafeHTML.markdown(@body)}
  </div>

  <%!-- Each rule keeps a stable anchor, so a moderator or a member can link to
  the one they mean rather than to the page. --%>
  <ol :if={@rules != []} id="policy-rules" class="policy-rules space-y-6 list-none pl-0">
    <li
      :for={{rule, number} <- Enum.with_index(@rules, 1)}
      id={"rule-#{number}"}
      class="policy-rule scroll-mt-20"
    >
      <h2 class="policy-rule-title text-lg font-semibold break-words">
        <.link
          navigate={"/rules#rule-#{number}"}
          class="policy-rule-anchor link link-hover no-underline"
        >
          {gettext("%{number}. %{title}", number: number, title: rule.title)}
        </.link>
      </h2>
      <div
        :if={rule.body}
        class="policy-rule-body prose max-w-none break-words mt-2"
      >
        {BaudrateWeb.SafeHTML.markdown(rule.body)}
      </div>
    </li>
  </ol>

  <p
    :if={is_nil(@body) && @rules == []}
    id="policy-empty"
    class="policy-empty text-center py-8 opacity-70"
    role="status"
  >
    {empty_message(@policy)}
  </p>

  <%!-- Accepting is offered only here, under the text itself, and only to a
  member who actually owes an acceptance (P1-D8). --%>
  <section
    :if={@policy == :terms && @body && assigns[:terms_pending]}
    id="terms-agreement"
    class="terms-agreement card bg-base-200 shadow-sm"
    aria-labelledby="terms-agreement-heading"
  >
    <div class="card-body">
      <h2 id="terms-agreement-heading" class="terms-agreement-heading card-title text-base">
        {gettext("These terms have changed since you accepted them")}
      </h2>
      <p id="terms-agreement-text" class="terms-agreement-text text-sm opacity-80">
        {gettext("Posting and interacting are paused until you accept. Reading is not.")}
      </p>
      <div class="card-actions">
        <.button
          id="terms-agreement-button"
          variant="primary"
          phx-click="accept_terms"
          phx-disable-with={gettext("Saving...")}
        >
          {gettext("I accept these terms")}
        </.button>
      </div>
    </div>
  </section>
</article>
