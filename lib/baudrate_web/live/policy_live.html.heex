<article id="policy-page" class="policy-page max-w-3xl mx-auto space-y-6">
  <header id="policy-header" class="policy-header">
    <h1 id="policy-heading" class="policy-title text-3xl font-bold break-words">
      {title(@policy)}
    </h1>
  </header>

  <div :if={@body} id="policy-body" class="policy-body prose max-w-none break-words">
    {raw(Baudrate.Content.Markdown.to_html(@body))}
  </div>

  <p
    :if={is_nil(@body)}
    id="policy-empty"
    class="policy-empty text-center py-8 opacity-70"
    role="status"
  >
    {empty_message(@policy)}
  </p>

  <%!-- Accepting is offered only here, under the text itself, and only to a
  member who actually owes an acceptance (P1-D8). --%>
  <section
    :if={@policy == :terms && @body && assigns[:terms_pending]}
    id="policy-accept"
    class="policy-accept card bg-base-200 shadow-sm"
    aria-labelledby="policy-accept-heading"
  >
    <div class="card-body">
      <h2 id="policy-accept-heading" class="policy-accept-heading card-title text-base">
        {gettext("These terms have changed since you accepted them")}
      </h2>
      <p id="policy-accept-text" class="policy-accept-text text-sm opacity-80">
        {gettext("Posting and interacting are paused until you accept. Reading is not.")}
      </p>
      <div class="card-actions">
        <.button
          id="policy-accept-button"
          variant="primary"
          phx-click="accept_terms"
          phx-disable-with={gettext("Saving...")}
        >
          {gettext("I accept these terms")}
        </.button>
      </div>
    </div>
  </section>
</article>
