<div id="profile-page" class="profile-page card bg-base-200 shadow-sm">
  <div class="card-body">
    <h1 id="profile-heading" class="card-title text-2xl mb-4">{gettext("Profile")}</h1>

    <div class="space-y-4">
      <%!-- Avatar section --%>
      <div id="profile-avatar-section" class="flex flex-wrap items-center gap-4">
        <.avatar user={@current_user} size={120} />
        <div :if={@can_upload_avatar} class="flex gap-2">
          <button
            id="profile-avatar-change"
            type="button"
            class="btn btn-sm btn-primary"
            phx-click={JS.dispatch("avatar:open-picker", to: "#avatar-crop-hook")}
          >
            {gettext("Change Avatar")}
          </button>
          <button
            :if={@current_user.avatar_id}
            id="profile-avatar-remove"
            type="button"
            class="btn btn-sm btn-outline btn-error"
            phx-click="remove_avatar"
            data-confirm={gettext("Are you sure you want to remove your avatar?")}
          >
            {gettext("Remove Avatar")}
          </button>
        </div>
        <span :if={!@is_active} class="profile-pending-notice text-sm text-base-content/70">
          {gettext("Your account is pending approval.")}
          {gettext("You can update your profile while you wait.")}
        </span>
      </div>

      <%!-- Hidden file input for avatar upload --%>
      <form
        :if={@can_upload_avatar}
        id="avatar-upload-form"
        phx-change="validate_avatar"
        class="hidden"
      >
        <.live_file_input upload={@uploads.avatar} />
      </form>

      <%!-- Upload errors --%>
      <%= for entry <- @uploads.avatar.entries do %>
        <%= for err <- upload_errors(@uploads.avatar, entry) do %>
          <p class="text-sm text-error">
            {upload_error_to_string(err)}
          </p>
        <% end %>
      <% end %>

      <%!-- Crop modal --%>
      <div id="avatar-crop-hook" phx-hook="AvatarCropHook">
        <dialog
          id="crop-modal"
          class="modal"
          aria-labelledby="crop-modal-title"
          aria-modal="true"
          phx-hook="FocusTrapHook"
          phx-window-keydown="cancel_crop"
          phx-key="Escape"
          {if @show_crop_modal, do: [open: true], else: []}
        >
          <div class="modal-box max-w-lg">
            <h3 id="crop-modal-title" class="text-lg font-bold mb-4">{gettext("Crop Avatar")}</h3>
            <div id="avatar-crop-container" data-avatar-crop-container phx-update="ignore">
              <div class="max-h-96 overflow-hidden">
                <img
                  data-avatar-preview
                  src=""
                  alt={gettext("Avatar preview")}
                  class="max-w-full"
                />
              </div>
              <div class="modal-action">
                <button type="button" class="btn btn-ghost" phx-click="cancel_crop">
                  {gettext("Cancel")}
                </button>
                <button
                  type="button"
                  class="btn btn-primary"
                  phx-click={JS.dispatch("avatar:save-crop", to: "#avatar-crop-hook")}
                >
                  {gettext("Save")}
                </button>
              </div>
            </div>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button phx-click="cancel_crop">{gettext("close")}</button>
          </form>
        </dialog>
      </div>

      <div id="profile-username">
        <div class="profile-field-label text-sm text-base-content/70">{gettext("Username")}</div>
        <div class="flex items-center gap-1">
          <a
            id="profile-username-link"
            href={~p"/users/#{@current_user.username}"}
            class="profile-field-value text-lg font-semibold link link-hover"
          >
            {@current_user.username}
          </a>
          <button
            id="copy-profile-url"
            phx-hook="CopyToClipboardHook"
            data-copy-text={BaudrateWeb.Endpoint.url() <> ~p"/users/#{@current_user.username}"}
            data-copied-label={gettext("Copied!")}
            title={gettext("Copy profile URL")}
            class="btn btn-ghost btn-xs"
            aria-label={gettext("Copy profile URL")}
          >
            <.icon name="hero-clipboard-document" class="size-4 text-base-content/50" />
          </button>
        </div>
      </div>

      <%!-- Display Name section --%>
      <div id="profile-display-name">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Display Name")}
        </div>
        <.form
          for={@display_name_form}
          id="profile-display-name-form"
          phx-change="validate_display_name"
          phx-submit="save_display_name"
          class="space-y-3"
        >
          <.input
            field={@display_name_form[:display_name]}
            type="text"
            maxlength="64"
            placeholder={gettext("Your display name (max 64 characters)")}
          />
          <button
            id="profile-display-name-save"
            type="submit"
            class="btn btn-sm btn-primary"
            phx-disable-with={gettext("Saving...")}
          >
            {gettext("Save Display Name")}
          </button>
        </.form>
      </div>

      <%!-- Bio section --%>
      <div id="profile-bio-section">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">{gettext("Bio")}</div>
        <.form
          for={@bio_form}
          id="profile-bio-form"
          phx-change="validate_bio"
          phx-submit="save_bio"
          class="space-y-3"
        >
          <.input
            field={@bio_form[:bio]}
            type="textarea"
            rows="4"
            maxlength="500"
            placeholder={gettext("Tell others about yourself (max 500 characters)")}
          />
          <button
            id="profile-bio-save"
            type="submit"
            class="btn btn-sm btn-primary"
            phx-disable-with={gettext("Saving...")}
          >
            {gettext("Save Bio")}
          </button>
        </.form>
      </div>

      <%!-- Profile Fields section --%>
      <div id="profile-fields-section">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Profile Fields")}
        </div>
        <p class="profile-field-hint text-sm text-base-content/70 mb-3">
          {gettext("Add up to 4 custom fields to your profile (e.g. website, location).")}
        </p>
        <form id="profile-fields-form" phx-submit="save_profile_fields" class="space-y-3">
          <div class="space-y-2">
            <div
              :for={{field, i} <- Enum.with_index(@profile_fields)}
              id={"profile-field-row-#{i}"}
              class="profile-field-row flex flex-wrap gap-2"
            >
              <input
                id={"profile-field-name-#{i}"}
                type="text"
                name={"profile_fields[#{i}][name]"}
                value={field["name"]}
                placeholder={gettext("Label")}
                maxlength="255"
                class="profile-field-name-input input input-bordered input-sm w-36"
                aria-label={gettext("Field %{n} label", n: i + 1)}
              />
              <input
                id={"profile-field-value-#{i}"}
                type="text"
                name={"profile_fields[#{i}][value]"}
                value={field["value"]}
                placeholder={gettext("Content")}
                maxlength="2048"
                class="profile-field-value-input input input-bordered input-sm flex-1"
                aria-label={gettext("Field %{n} content", n: i + 1)}
              />
            </div>
          </div>
          <button
            id="profile-fields-save"
            type="submit"
            class="btn btn-sm btn-primary"
            phx-disable-with={gettext("Saving...")}
          >
            {gettext("Save Fields")}
          </button>
        </form>
      </div>

      <%!-- Signature section --%>
      <div id="profile-signature-section">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Signature")}
        </div>
        <.form
          for={@signature_form}
          id="profile-signature-form"
          phx-change="validate_signature"
          phx-submit="save_signature"
          class="space-y-3"
        >
          <.input
            field={@signature_form[:signature]}
            type="textarea"
            rows="4"
            maxlength="500"
            toolbar
            placeholder={gettext("Your signature (Markdown supported, max 500 characters)")}
          />
          <div :if={@signature_preview != ""} id="profile-signature-preview" class="space-y-1">
            <p class="profile-field-label text-sm text-base-content/70">{gettext("Preview:")}</p>
            <div class="profile-signature-preview-body prose prose-sm max-w-none bg-base-200 rounded-lg p-3 text-base-content/70">
              {raw(@signature_preview)}
            </div>
          </div>
          <button
            id="profile-signature-save"
            type="submit"
            class="btn btn-sm btn-primary"
            phx-disable-with={gettext("Saving...")}
          >
            {gettext("Save Signature")}
          </button>
        </.form>
      </div>

      <div id="profile-role">
        <div class="profile-field-label text-sm text-base-content/70">{gettext("Role")}</div>
        <div class="profile-field-value text-lg font-semibold">
          {translate_role(@current_user.role.name)}
        </div>
        <div class="profile-role-description text-sm text-base-content/70">
          {@current_user.role.description}
        </div>
      </div>

      <div id="profile-2fa">
        <div class="profile-field-label text-sm text-base-content/70">
          {gettext("Two-Factor Authentication")}
        </div>
        <div class="profile-field-value text-lg font-semibold flex items-center gap-2">
          <%= if @current_user.totp_enabled do %>
            <span class="profile-2fa-status badge badge-success">{gettext("Enabled")}</span>
            <.link
              id="profile-2fa-reset"
              navigate="/profile/totp-reset"
              class="btn btn-sm btn-outline"
            >
              {gettext("Reset Authenticator")}
            </.link>
          <% else %>
            <span class="profile-2fa-status badge badge-warning">{gettext("Disabled")}</span>
            <%= if @totp_policy == :optional do %>
              <.link
                id="profile-2fa-enable"
                navigate="/profile/totp-reset"
                class="btn btn-sm btn-primary"
              >
                {gettext("Enable TOTP")}
              </.link>
            <% end %>
          <% end %>
        </div>
      </div>

      <%!-- Security Keys (WebAuthn) section --%>
      <section
        id="profile-security-keys"
        aria-labelledby="security-keys-heading"
        phx-hook="WebAuthnRegister"
      >
        <h2 id="security-keys-heading" class="text-sm text-base-content/70 mb-2">
          {gettext("Security Keys")}
        </h2>
        <p class="profile-field-hint text-sm text-base-content/70 mb-3">
          {gettext(
            "Register a hardware security key or platform authenticator (e.g. Touch ID, Windows Hello) as a second factor."
          )}
        </p>

        <div :if={@webauthn_credentials != []} class="space-y-2 mb-4">
          <article
            :for={cred <- @webauthn_credentials}
            id={"security-key-#{cred.id}"}
            class="security-key flex items-center gap-3 p-2 bg-base-200 rounded-lg"
          >
            <.icon name="hero-key" class="w-5 h-5 text-base-content/60 shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="security-key-label font-semibold text-sm truncate">
                {if cred.label != "", do: cred.label, else: gettext("Unnamed Key")}
              </div>
              <div class="security-key-meta text-xs text-base-content/60">
                {gettext("Added %{date}",
                  date: Calendar.strftime(cred.inserted_at, "%Y-%m-%d")
                )}
                <%= if cred.last_used_at do %>
                  &middot; {gettext("Last used %{date}",
                    date: Calendar.strftime(cred.last_used_at, "%Y-%m-%d")
                  )}
                <% end %>
              </div>
            </div>
            <button
              id={"security-key-remove-#{cred.id}"}
              type="button"
              class="security-key-remove btn btn-sm btn-ghost btn-error"
              phx-click="delete_webauthn_credential"
              phx-value-id={cred.id}
              data-confirm={gettext("Remove this security key?")}
              aria-label={gettext("Remove security key %{label}", label: cred.label)}
            >
              {gettext("Remove")}
            </button>
          </article>
        </div>

        <div
          :if={@webauthn_credentials == []}
          class="profile-security-keys-empty text-sm text-base-content/70 italic mb-4"
        >
          {gettext("No security keys registered.")}
        </div>

        <button
          id="profile-security-key-register"
          type="button"
          class="btn btn-sm btn-outline"
          phx-click="begin_registration"
          aria-label={gettext("Register a new security key")}
        >
          <.icon name="hero-plus" class="w-4 h-4 mr-1" />
          {gettext("Register New Key")}
        </button>

        <form
          id="webauthn-register-form"
          action="/auth/webauthn-register"
          method="post"
          class="hidden"
        >
          <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
          <input
            type="hidden"
            name="challenge_token"
            value={@webauthn_challenge_token}
          />
          <input type="hidden" id="attestation_object" name="attestation_object" />
          <input type="hidden" id="client_data_json" name="client_data_json" />
          <input type="hidden" name="label" value={gettext("Security Key")} />
        </form>
      </section>

      <div id="profile-member-since">
        <div class="profile-field-label text-sm text-base-content/70">
          {gettext("Member Since")}
        </div>
        <div class="profile-field-value text-lg font-semibold">
          <time datetime={format_date(@current_user.inserted_at)}>
            {format_date(@current_user.inserted_at)}
          </time>
        </div>
      </div>

      <%!-- Preferred Languages section --%>
      <div id="profile-languages">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Preferred Languages")}
        </div>
        <%= if @preferred_locales == [] do %>
          <div class="profile-languages-empty text-sm text-base-content/70 italic">
            {gettext("Using browser language settings.")}
          </div>
        <% else %>
          <div class="space-y-1">
            <%= for {locale, idx} <- Enum.with_index(@preferred_locales) do %>
              <div
                id={"profile-locale-#{locale}"}
                class="profile-locale-row flex items-center gap-2"
              >
                <span class="profile-locale-rank badge badge-sm badge-neutral">{idx + 1}</span>
                <span class="profile-locale-name font-semibold">
                  {BaudrateWeb.Locale.locale_display_name(locale)}
                </span>
                <span class="profile-locale-code text-sm text-base-content/70">{locale}</span>
                <div class="ml-auto flex gap-1">
                  <button
                    :if={idx > 0}
                    id={"profile-locale-up-#{locale}"}
                    type="button"
                    class="profile-locale-up btn btn-sm btn-ghost"
                    phx-click="move_locale_up"
                    phx-value-locale={locale}
                    aria-label={gettext("Move %{locale} up", locale: locale)}
                  >
                    &uarr;
                  </button>
                  <button
                    :if={idx < length(@preferred_locales) - 1}
                    id={"profile-locale-down-#{locale}"}
                    type="button"
                    class="profile-locale-down btn btn-sm btn-ghost"
                    phx-click="move_locale_down"
                    phx-value-locale={locale}
                    aria-label={gettext("Move %{locale} down", locale: locale)}
                  >
                    &darr;
                  </button>
                  <button
                    id={"profile-locale-remove-#{locale}"}
                    type="button"
                    class="profile-locale-remove btn btn-sm btn-ghost btn-error"
                    phx-click="remove_locale"
                    phx-value-locale={locale}
                    aria-label={gettext("Remove")}
                  >
                    &times;
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <% unselected =
          Enum.reject(@available_locales, fn {code, _} -> code in @preferred_locales end) %>
        <%= if unselected != [] do %>
          <div class="dropdown mt-2">
            <button
              id="profile-add-language"
              type="button"
              tabindex="0"
              aria-haspopup="true"
              aria-expanded="false"
              class="btn btn-sm btn-outline"
            >
              {gettext("Add Language")}
            </button>
            <ul
              tabindex="0"
              class="dropdown-content menu bg-base-200 rounded-box z-10 w-52 p-2 shadow-sm"
            >
              <%= for {code, name} <- unselected do %>
                <li>
                  <button
                    id={"profile-add-locale-#{code}"}
                    class="profile-add-locale"
                    type="button"
                    phx-click="add_locale"
                    phx-value-locale={code}
                  >
                    {name}
                    <span class="text-sm text-base-content/70">{code}</span>
                  </button>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <%!-- DM access setting --%>
      <div id="profile-dm-access">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Direct Messages")}
        </div>
        <select
          id="profile-dm-access-select"
          name="dm_access"
          class="select select-bordered w-full max-w-xs"
          phx-change="update_dm_access"
          aria-label={gettext("Who can send you direct messages")}
        >
          <option value="anyone" selected={@current_user.dm_access == "anyone"}>
            {gettext("Anyone")}
          </option>
          <option value="followers" selected={@current_user.dm_access == "followers"}>
            {gettext("Followers only")}
          </option>
          <option value="nobody" selected={@current_user.dm_access == "nobody"}>
            {gettext("Nobody")}
          </option>
        </select>
        <p class="profile-field-hint text-sm text-base-content/70 mt-1">
          {gettext("Controls who can send you direct messages.")}
        </p>
      </div>

      <%!-- Browser Push Notifications section --%>
      <div
        id="push-manager"
        phx-hook="PushManagerHook"
        role="region"
        aria-labelledby="push-notifications-heading"
      >
        <h3 id="push-notifications-heading" class="text-sm text-base-content/70 mb-2">
          {gettext("Browser Push Notifications")}
        </h3>
        <%= if @push_supported do %>
          <%= if @push_subscribed do %>
            <button
              id="profile-push-disable"
              type="button"
              class="btn btn-sm btn-outline btn-error"
              phx-click={JS.dispatch("push:unsubscribe", to: "#push-manager")}
            >
              {gettext("Disable Push")}
            </button>
          <% else %>
            <button
              id="profile-push-enable"
              type="button"
              class="btn btn-sm btn-primary"
              phx-click={JS.dispatch("push:subscribe", to: "#push-manager")}
            >
              {gettext("Enable Push")}
            </button>
          <% end %>
        <% else %>
          <p class="profile-push-unsupported text-sm text-base-content/70 italic">
            {gettext("Push notifications are not supported by this browser.")}
          </p>
        <% end %>
      </div>

      <%!-- Notification Preferences section --%>
      <div id="profile-notification-prefs">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Notification Preferences")}
        </div>
        <p class="profile-field-hint text-sm text-base-content/70 mb-3">
          {gettext("Choose which notifications you receive.")}
        </p>
        <div class="overflow-x-auto">
          <table id="profile-notification-prefs-table" class="table table-sm">
            <thead>
              <tr>
                <th>{gettext("Type")}</th>
                <th class="text-center">{gettext("In-App")}</th>
                <th :if={@push_subscribed} class="text-center">{gettext("Push")}</th>
              </tr>
            </thead>
            <tbody>
              <tr
                :for={
                  type <-
                    ~w(reply_to_article reply_to_comment mention new_follower article_liked comment_liked article_boosted comment_boosted article_forwarded moderation_report admin_announcement)
                }
                id={"profile-notification-pref-#{type}"}
                class="profile-notification-pref-row"
              >
                <td class="profile-notification-pref-type text-sm">
                  {BaudrateWeb.Helpers.notification_text(type)}
                </td>
                <td class="text-center">
                  <label>
                    <input
                      id={"profile-notification-in-app-#{type}"}
                      type="checkbox"
                      class="profile-notification-in-app-toggle toggle toggle-sm toggle-primary"
                      checked={get_in(@notification_preferences, [type, "in_app"]) != false}
                      phx-click="toggle_notification_pref"
                      phx-value-type={type}
                      aria-label={
                        gettext("In-App") <> ": " <> BaudrateWeb.Helpers.notification_text(type)
                      }
                    />
                  </label>
                </td>
                <td :if={@push_subscribed} class="text-center">
                  <label>
                    <input
                      id={"profile-notification-web-push-#{type}"}
                      type="checkbox"
                      class="profile-notification-web-push-toggle toggle toggle-sm toggle-secondary"
                      checked={get_in(@notification_preferences, [type, "web_push"]) != false}
                      phx-click="toggle_web_push_pref"
                      phx-value-type={type}
                      aria-label={
                        gettext("Push") <> ": " <> BaudrateWeb.Helpers.notification_text(type)
                      }
                    />
                  </label>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <%!-- Muted Users section --%>
      <div id="profile-muted-users">
        <div class="profile-field-label text-sm text-base-content/70 mb-2">
          {gettext("Muted Users")}
        </div>
        <div
          :if={@mutes == []}
          class="profile-muted-users-empty text-sm text-base-content/70 italic"
        >
          {gettext("No muted users.")}
        </div>
        <div :if={@mutes != []} class="space-y-2">
          <div
            :for={mute <- @mutes}
            id={"muted-user-#{mute.id}"}
            class="muted-user flex items-center gap-3"
          >
            <%= if mute.muted_user do %>
              <.avatar user={mute.muted_user} size={36} />
              <span class="muted-user-name font-semibold">{display_name(mute.muted_user)}</span>
            <% else %>
              <div class="avatar avatar-placeholder">
                <div
                  class="bg-neutral text-neutral-content rounded-full"
                  style="width: 36px; height: 36px"
                >
                  <span class="text-xs">@</span>
                </div>
              </div>
              <span class="muted-user-name text-sm text-base-content/70">{mute.muted_actor_ap_id}</span>
            <% end %>
            <button
              id={"muted-user-unmute-#{mute.id}"}
              type="button"
              class="muted-user-unmute btn btn-sm btn-ghost btn-error ml-auto"
              phx-click="unmute"
              phx-value-id={mute.id}
              aria-label={gettext("Unmute")}
            >
              {gettext("Unmute")}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
