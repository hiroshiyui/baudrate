<.profile_page current={:profile} id="profile-page" title={gettext("Profile")}>
  <div id="profile-avatar-section" class="flex flex-wrap items-center gap-4">
    <.avatar user={@current_user} size={120} />
    <div :if={@can_upload_avatar} class="flex gap-2">
      <button
        id="profile-avatar-change"
        type="button"
        class="btn btn-sm btn-primary"
        phx-click={JS.dispatch("avatar:open-picker", to: "#avatar-crop-hook")}
      >
        {gettext("Change Avatar")}
      </button>
      <button
        :if={@current_user.avatar_id}
        id="profile-avatar-remove"
        type="button"
        class="btn btn-sm btn-outline btn-error"
        phx-click="remove_avatar"
        data-confirm={gettext("Are you sure you want to remove your avatar?")}
      >
        {gettext("Remove Avatar")}
      </button>
    </div>
    <span :if={!@is_active} class="profile-pending-notice text-sm text-base-content/70">
      {gettext("Your account is pending approval.")}
      {gettext("You can update your profile while you wait.")}
    </span>
  </div>

  <%!-- Hidden file input for avatar upload --%>
  <form
    :if={@can_upload_avatar}
    id="avatar-upload-form"
    phx-change="validate_avatar"
    class="hidden"
  >
    <.live_file_input upload={@uploads.avatar} />
  </form>

  <%!-- Upload errors --%>
  <%= for entry <- @uploads.avatar.entries do %>
    <%= for err <- upload_errors(@uploads.avatar, entry) do %>
      <p
        id={"profile-avatar-error-#{entry.ref}"}
        class="profile-avatar-error text-sm text-error"
        role="alert"
      >
        {upload_error_to_string(err)}
      </p>
    <% end %>
  <% end %>

  <%!-- Crop modal --%>
  <div id="avatar-crop-hook" phx-hook="AvatarCropHook">
    <dialog
      id="crop-modal"
      class="modal"
      aria-labelledby="crop-modal-title"
      aria-modal="true"
      phx-hook="FocusTrapHook"
      phx-window-keydown="cancel_crop"
      phx-key="Escape"
      {if @show_crop_modal, do: [open: true], else: []}
    >
      <div class="modal-box max-w-lg">
        <h2 id="crop-modal-title" class="crop-modal-title text-lg font-bold mb-4">
          {gettext("Crop Avatar")}
        </h2>
        <div id="avatar-crop-container" data-avatar-crop-container phx-update="ignore">
          <div class="max-h-96 overflow-hidden">
            <img
              data-avatar-preview
              src=""
              alt={gettext("Avatar preview")}
              class="max-w-full"
            />
          </div>
          <div class="modal-action">
            <button type="button" class="btn btn-ghost" phx-click="cancel_crop">
              {gettext("Cancel")}
            </button>
            <button
              type="button"
              class="btn btn-primary"
              phx-click={JS.dispatch("avatar:save-crop", to: "#avatar-crop-hook")}
            >
              {gettext("Save")}
            </button>
          </div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button phx-click="cancel_crop">{gettext("close")}</button>
      </form>
    </dialog>
  </div>

  <div id="profile-username">
    <div class="profile-field-label text-sm text-base-content/70">{gettext("Username")}</div>
    <div class="flex items-center gap-1">
      <a
        id="profile-username-link"
        href={~p"/users/#{@current_user.username}"}
        class="profile-field-value text-lg font-semibold link link-hover"
      >
        {@current_user.username}
      </a>
      <button
        id="copy-profile-url"
        phx-hook="CopyToClipboardHook"
        data-copy-text={BaudrateWeb.Endpoint.url() <> ~p"/users/#{@current_user.username}"}
        data-copied-label={gettext("Copied!")}
        title={gettext("Copy profile URL")}
        class="btn btn-ghost btn-xs"
        aria-label={gettext("Copy profile URL")}
      >
        <.icon name="hero-clipboard-document" class="size-4 text-base-content/50" />
      </button>
    </div>
  </div>

  <%!-- Display Name section --%>
  <div id="profile-display-name">
    <.form
      for={@display_name_form}
      id="profile-display-name-form"
      phx-change="validate_display_name"
      phx-submit="save_display_name"
      class="space-y-3"
    >
      <.input
        field={@display_name_form[:display_name]}
        type="text"
        label={gettext("Display Name")}
        label_class="profile-field-label text-sm text-base-content/70"
        maxlength="64"
        placeholder={gettext("Your display name (max 64 characters)")}
      />
      <button
        id="profile-display-name-save"
        type="submit"
        class="btn btn-sm btn-primary"
        phx-disable-with={gettext("Saving...")}
      >
        {gettext("Save Display Name")}
      </button>
    </.form>
  </div>

  <%!-- Bio section --%>
  <div id="profile-bio-section">
    <.form
      for={@bio_form}
      id="profile-bio-form"
      phx-change="validate_bio"
      phx-submit="save_bio"
      class="space-y-3"
    >
      <.input
        field={@bio_form[:bio]}
        type="textarea"
        label={gettext("Bio")}
        label_class="profile-field-label text-sm text-base-content/70"
        rows="4"
        maxlength="500"
        placeholder={gettext("Tell others about yourself (max 500 characters)")}
      />
      <button
        id="profile-bio-save"
        type="submit"
        class="btn btn-sm btn-primary"
        phx-disable-with={gettext("Saving...")}
      >
        {gettext("Save Bio")}
      </button>
    </.form>
  </div>

  <%!-- Profile Fields section --%>
  <section id="profile-fields-section" aria-labelledby="profile-fields-heading">
    <h2
      id="profile-fields-heading"
      class="profile-field-label profile-section-heading text-sm text-base-content/70 mb-2"
    >
      {gettext("Profile Fields")}
    </h2>
    <p class="profile-field-hint text-sm text-base-content/70 mb-3">
      {gettext("Add up to 4 custom fields to your profile (e.g. website, location).")}
    </p>
    <form id="profile-fields-form" phx-submit="save_profile_fields" class="space-y-3">
      <div class="space-y-2">
        <div
          :for={{field, i} <- Enum.with_index(@profile_fields)}
          id={"profile-field-row-#{i}"}
          class="profile-field-row flex flex-wrap gap-2"
        >
          <input
            id={"profile-field-name-#{i}"}
            type="text"
            name={"profile_fields[#{i}][name]"}
            value={field["name"]}
            placeholder={gettext("Label")}
            maxlength="255"
            class="profile-field-name-input input input-bordered input-sm w-36"
            aria-label={gettext("Field %{n} label", n: i + 1)}
          />
          <input
            id={"profile-field-value-#{i}"}
            type="text"
            name={"profile_fields[#{i}][value]"}
            value={field["value"]}
            placeholder={gettext("Content")}
            maxlength="2048"
            class="profile-field-value-input input input-bordered input-sm flex-1"
            aria-label={gettext("Field %{n} content", n: i + 1)}
          />
        </div>
      </div>
      <button
        id="profile-fields-save"
        type="submit"
        class="btn btn-sm btn-primary"
        phx-disable-with={gettext("Saving...")}
      >
        {gettext("Save Fields")}
      </button>
    </form>
  </section>

  <%!-- Signature section --%>
  <div id="profile-signature-section">
    <.form
      for={@signature_form}
      id="profile-signature-form"
      phx-change="validate_signature"
      phx-submit="save_signature"
      class="space-y-3"
    >
      <.input
        field={@signature_form[:signature]}
        type="textarea"
        label={gettext("Signature")}
        label_class="profile-field-label text-sm text-base-content/70"
        rows="4"
        maxlength="500"
        toolbar
        placeholder={gettext("Your signature (Markdown supported, max 500 characters)")}
      />
      <div :if={@signature_preview != ""} id="profile-signature-preview" class="space-y-1">
        <p class="profile-field-label text-sm text-base-content/70">{gettext("Preview:")}</p>
        <div class="profile-signature-preview-body prose prose-sm max-w-none bg-base-200 rounded-lg p-3 text-base-content/70">
          {BaudrateWeb.SafeHTML.body_html(@signature_preview)}
        </div>
      </div>
      <button
        id="profile-signature-save"
        type="submit"
        class="btn btn-sm btn-primary"
        phx-disable-with={gettext("Saving...")}
      >
        {gettext("Save Signature")}
      </button>
    </.form>
  </div>

  <div id="profile-role">
    <div class="profile-field-label text-sm text-base-content/70">{gettext("Role")}</div>
    <div class="profile-field-value text-lg font-semibold">
      {translate_role(@current_user.role.name)}
    </div>
    <div class="profile-role-description text-sm text-base-content/70">
      {@current_user.role.description}
    </div>
  </div>

  <div id="profile-member-since">
    <div class="profile-field-label text-sm text-base-content/70">
      {gettext("Member Since")}
    </div>
    <div class="profile-field-value text-lg font-semibold">
      <time datetime={format_date(@current_user.inserted_at)}>
        {format_date(@current_user.inserted_at)}
      </time>
    </div>
  </div>
</.profile_page>
