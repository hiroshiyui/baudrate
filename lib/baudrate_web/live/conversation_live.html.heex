<div id="conversation-page" class="conversation-page space-y-4">
  <div id="conversation-header" class="conversation-header flex items-center gap-3">
    <.link
      id="conversation-back-link"
      navigate="/messages"
      class="conversation-back-link btn btn-ghost btn-sm"
      aria-label={gettext("Back to messages")}
    >
      <.icon name="hero-arrow-left" class="size-4" />
    </.link>
    <h1
      :if={@mode == :select_recipient}
      id="conversation-heading"
      class="conversation-heading text-xl font-bold"
    >
      {gettext("New Message")}
    </h1>
    <h1
      :if={@mode != :select_recipient}
      id="conversation-heading"
      class="conversation-heading text-xl font-bold break-words min-w-0"
    >
      {participant_name(@other_participant)}
    </h1>
    <div
      :if={
        @mode == :conversation and match?(%Baudrate.Federation.RemoteActor{}, @other_participant)
      }
      id="conversation-actions-menu"
      class="conversation-actions-menu dropdown dropdown-end ml-auto"
    >
      <button
        type="button"
        tabindex="0"
        id="conversation-actions-menu-toggle"
        class="conversation-actions-menu-toggle btn btn-ghost btn-sm btn-circle"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={gettext("More actions")}
      >
        <.icon name="hero-ellipsis-vertical" class="size-5" />
      </button>
      <ul
        tabindex="0"
        class="conversation-actions-menu-list dropdown-content menu bg-base-200 rounded-box z-10 w-56 p-2 shadow-sm"
      >
        <BaudrateWeb.SafetyComponents.remote_actor_safety_items
          actor={@other_participant}
          id_prefix="conversation"
          muted={@other_muted}
          blocked={@other_blocked}
        />
      </ul>
    </div>
  </div>

  <%= if @mode == :select_recipient do %>
    <div class="card bg-base-200 shadow-sm">
      <div class="card-body p-4 space-y-4">
        <.form
          for={%{}}
          as={:search}
          id="conversation-recipient-form"
          phx-change="search_recipient"
          phx-submit="search_recipient"
        >
          <input
            type="text"
            name="search[query]"
            id="conversation-recipient-search"
            value={@search_query}
            placeholder={gettext("Search by username...")}
            class="conversation-recipient-search input input-bordered w-full"
            autocomplete="off"
            phx-debounce="300"
            autofocus
            aria-label={gettext("Search users")}
          />
        </.form>

        <p
          id="conversation-search-results-status"
          class="conversation-search-results-status sr-only"
          role="status"
        >
          {if String.length(@search_query) >= 2,
            do:
              ngettext(
                "%{count} user found",
                "%{count} users found",
                length(@search_results),
                count: length(@search_results)
              ),
            else: ""}
        </p>

        <ul
          :if={@search_results != []}
          id="conversation-search-results"
          class="conversation-search-results space-y-1"
          aria-label={gettext("Matching users")}
        >
          <li
            :for={user <- @search_results}
            id={"conversation-search-result-item-#{user.id}"}
            class="conversation-search-result-item"
          >
            <button
              id={"conversation-search-result-#{user.id}"}
              type="button"
              class="conversation-search-result flex items-center gap-3 w-full p-2 rounded-lg hover:bg-base-300 transition-colors cursor-pointer"
              phx-click="select_recipient"
              phx-value-username={user.username}
            >
              <.avatar user={user} size={36} />
              <span class="conversation-search-result-name font-medium">{user.username}</span>
            </button>
          </li>
        </ul>

        <div
          :if={@search_results == [] && String.length(@search_query) >= 2}
          id="conversation-no-results"
          class="conversation-no-results text-center py-4 text-base-content/70"
        >
          {gettext("No users found.")}
        </div>

        <div
          :if={@search_query == ""}
          id="conversation-search-hint"
          class="conversation-search-hint text-center py-4 text-base-content/70"
        >
          {gettext("Type a username to search.")}
        </div>
      </div>
    </div>
  <% else %>
    <div
      id="conversation-encryption-notice"
      role="alert"
      class="conversation-encryption-notice alert alert-warning text-sm"
    >
      <.icon name="hero-shield-exclamation" class="size-4" />
      <span>
        {gettext(
          "Direct messages are not end-to-end encrypted. Do not share sensitive information."
        )}
      </span>
    </div>

    <div class="card bg-base-200 shadow-sm">
      <%!-- `role="log"` carries an implicit `aria-live="polite"` with
            `aria-relevant="additions"`, which is right for a message arriving
            — and wrong for "Load older messages", which prepends a whole page
            into the same region and had every one of them read out. The
            control and the empty state now sit outside the log, and the load
            is announced as a count instead. --%>
      <div
        class="message-list card-body p-4 space-y-3 max-h-[60vh] overflow-y-auto"
        id="message-list"
        phx-hook="ScrollBottomHook"
        aria-label={gettext("Messages")}
        tabindex="0"
      >
        <p
          id="conversation-history-status"
          class="conversation-history-status sr-only"
          role="status"
        >
          {@history_announcement}
        </p>

        <div
          :if={@has_older_messages}
          id="conversation-load-older"
          class="conversation-load-older text-center"
        >
          <button
            id="conversation-load-older-button"
            type="button"
            phx-click="load_older"
            class="conversation-load-older-button btn btn-ghost btn-sm"
            phx-disable-with={gettext("Loading...")}
          >
            {gettext("Load older messages")}
          </button>
        </div>

        <div
          :if={@messages == []}
          id="conversation-empty"
          class="conversation-empty text-center py-8 text-base-content/70"
        >
          {gettext("No messages yet. Send the first one!")}
        </div>

        <div id="message-log" class="message-log space-y-3" role="log">
          <div
            :for={msg <- @messages}
            :key={msg.id}
            id={"message-#{msg.id}"}
            class={[
              "message chat",
              if(msg.sender_user_id == @current_user.id, do: "chat-end", else: "chat-start"),
              msg.id == @found_message_id && "message-found"
            ]}
          >
            <div class="chat-header text-xs text-base-content/70 mb-1">
              <%= if msg.sender_user_id == @current_user.id do %>
                {gettext("You")}
              <% else %>
                {participant_name(@other_participant)}
              <% end %>
              <time datetime={datetime_attr(msg.inserted_at)} class="ml-1">
                {format_datetime(msg.inserted_at, "%H:%M")}
              </time>
            </div>
            <div class={[
              "chat-bubble",
              if(msg.sender_user_id == @current_user.id, do: "chat-bubble-primary", else: "")
            ]}>
              <%= if msg.body_html do %>
                <div class="prose prose-sm max-w-none">
                  {BaudrateWeb.SafeHTML.body_html(msg.body_html)}
                </div>
              <% else %>
                <p class="whitespace-pre-wrap break-words">{msg.body}</p>
              <% end %>
              <%!-- Private images (ADR 0071): each is served only after a
                   participant check; the link carries the description and the
                   image itself is alt="" so it is announced once (ADR 0061). --%>
              <div
                :if={msg.images != []}
                id={"message-#{msg.id}-images"}
                class="message-images flex flex-wrap gap-2 mt-2"
              >
                <a
                  :for={img <- msg.images}
                  id={"message-image-#{img.id}"}
                  href={~p"/messages/images/#{img.id}"}
                  target="_blank"
                  rel="noopener"
                  class="message-image-link"
                  aria-label={image_link_label(img, msg.images)}
                >
                  <img
                    src={~p"/messages/images/#{img.id}"}
                    alt=""
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                    class="message-image max-h-48 w-auto rounded"
                  />
                </a>
              </div>
              <.link_preview
                :if={msg.link_preview && msg.link_preview.status in ["fetched", "failed"]}
                id={"message-#{msg.id}-link-preview"}
                preview={msg.link_preview}
              />
            </div>
            <div :if={msg.sender_user_id != @current_user.id} class="chat-footer">
              <button
                id={"message-report-#{msg.id}"}
                type="button"
                class="message-report btn btn-ghost btn-xs"
                phx-click="open_report_modal"
                phx-value-type="message"
                phx-value-id={msg.id}
                phx-value-label={String.slice(msg.body || "", 0..100)}
                aria-label={gettext("Report this message")}
              >
                <.icon name="hero-flag" class="size-3" />
                {gettext("Report")}
              </button>
            </div>
            <div :if={msg.sender_user_id == @current_user.id} class="chat-footer">
              <button
                id={"message-delete-#{msg.id}"}
                type="button"
                class="message-delete btn btn-ghost btn-xs text-error"
                phx-click="delete_message"
                phx-value-id={msg.id}
                data-confirm={gettext("Delete this message?")}
              >
                {gettext("Delete")}
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="conversation-compose" class="conversation-compose border-t border-base-300 p-4">
        <%!-- Images: only between members here (ADR 0071). --%>
        <section
          :if={@images_allowed}
          id="conversation-images"
          class="conversation-images mb-3"
          aria-label={gettext("Attach images")}
        >
          <form
            id="conversation-images-form"
            phx-change="validate_dm_images"
            class="conversation-images-form"
          >
            <label
              for={@uploads.dm_images.ref}
              class="conversation-images-label btn btn-sm btn-ghost"
            >
              <.icon name="hero-photo" class="size-4" />
              {gettext("Attach images")}
            </label>
            <.live_file_input
              upload={@uploads.dm_images}
              class="conversation-images-input sr-only"
            />
          </form>

          <div
            :for={entry <- @uploads.dm_images.entries}
            id={"conversation-image-entry-#{entry.ref}"}
            class="conversation-image-entry flex items-center gap-2 text-sm mt-2"
          >
            <progress value={entry.progress} max="100" class="progress progress-primary w-32">
              {entry.progress}%
            </progress>
            <span :for={err <- upload_errors(@uploads.dm_images, entry)} class="text-error">
              {BaudrateWeb.Helpers.upload_error_to_string(err, max_size: "8 MB", max_files: 4)}
            </span>
            <button
              id={"conversation-image-cancel-#{entry.ref}"}
              type="button"
              phx-click="cancel_dm_image_upload"
              phx-value-ref={entry.ref}
              class="btn btn-ghost btn-xs"
              aria-label={gettext("Cancel upload")}
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          </div>
          <p
            :for={err <- upload_errors(@uploads.dm_images)}
            class="conversation-images-error text-error text-sm mt-1"
          >
            {BaudrateWeb.Helpers.upload_error_to_string(err, max_size: "8 MB", max_files: 4)}
          </p>

          <ul
            :if={@uploaded_dm_images != []}
            id="conversation-uploaded-images"
            class="space-y-2 mt-2"
          >
            <li
              :for={img <- @uploaded_dm_images}
              id={"conversation-uploaded-image-#{img.id}"}
              class="conversation-uploaded-image flex items-start gap-3"
            >
              <img
                src={~p"/messages/images/#{img.id}"}
                alt={img.alt || gettext("Uploaded image")}
                class="w-16 h-16 object-cover rounded"
              />
              <div class="flex-1 min-w-0">
                <.image_alt_input image={img} event="save_dm_image_alt" />
              </div>
              <button
                id={"conversation-uploaded-image-remove-#{img.id}"}
                type="button"
                phx-click="remove_dm_image"
                phx-value-id={img.id}
                class="btn btn-ghost btn-xs"
                aria-label={gettext("Remove image")}
              >
                <.icon name="hero-trash" class="size-4" />
              </button>
            </li>
          </ul>
        </section>

        <.form
          for={@message_form}
          id="conversation-compose-form"
          phx-change="update_message"
          phx-submit="send_message"
          class="conversation-compose-form flex gap-2"
        >
          <input
            type="text"
            name="message[body]"
            id="conversation-compose-input"
            value={@message_form[:body].value}
            placeholder={gettext("Type a message...")}
            class="conversation-compose-input input input-bordered flex-1"
            autocomplete="off"
            maxlength="65536"
            phx-debounce="300"
            aria-label={gettext("Message")}
          />
          <button
            id="conversation-compose-send"
            type="submit"
            class="conversation-compose-send btn btn-primary"
            aria-label={gettext("Send")}
          >
            <.icon name="hero-paper-airplane" class="size-5" />
          </button>
        </.form>
      </div>
    </div>
  <% end %>
</div>

<.report_modal
  :if={@mode == :conversation}
  show={@show_report_modal}
  target_type={@report_target_type}
  target_label={@report_target_label}
  on_close="close_report_modal"
  on_submit="submit_report"
/>
