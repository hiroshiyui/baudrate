<div id="article-page" class="article-page mx-auto max-w-4xl">
  <div id="article-back-links" class="article-back-links mb-4 flex flex-wrap gap-2">
    <.link
      :for={board <- @article.boards}
      id={"article-back-link-#{board.slug}"}
      navigate={~p"/boards/#{board.slug}"}
      class="article-back-link text-sm text-base-content/70 hover:text-base-content"
    >
      &larr; {gettext("Back to board")} ({board.name})
    </.link>
  </div>

  <article id="article" class="space-y-4" data-focus-target aria-labelledby="article-heading">
    <div class="flex items-center gap-2 flex-wrap">
      <h1 id="article-heading" class="article-heading text-2xl font-bold min-w-0 break-words">
        {@article.title}
      </h1>
      <span :if={@article.pinned} class="badge badge-primary badge-sm">
        {gettext("Pinned")}
      </span>
      <span :if={@article.locked} class="badge badge-warning badge-sm">
        {gettext("Locked")}
      </span>
    </div>

    <div class="article-meta flex flex-wrap items-center gap-2 text-sm text-base-content/70">
      <span :if={@article.user} class="inline-flex items-center gap-1">
        {gettext("by")}
        <.author_link
          user={@article.user}
          class="article-author inline-flex items-center gap-1 link link-hover font-semibold"
        >
          <.avatar user={@article.user} size={24} />
          {display_name(@article.user)}
        </.author_link>
        <span
          :if={@article.user.is_bot}
          class="badge badge-sm badge-ghost ml-1"
          role="img"
          aria-label={gettext("Bot account")}
        >
          {gettext("Bot")}
        </span>
      </span>
      <span :if={@article.remote_actor} class="inline-flex items-center gap-1">
        {gettext("by")}
        <a
          href={remote_actor_profile_url(@article.remote_actor)}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="article-remote-author inline-flex items-center gap-1 font-semibold link link-hover"
        >
          <span class="w-6 h-6 rounded-full bg-base-300 inline-flex items-center justify-center shrink-0">
            <img
              :if={@article.remote_actor.avatar_url}
              src={Baudrate.Media.Proxy.url(@article.remote_actor.avatar_url)}
              alt={display_name(@article.remote_actor)}
              class="w-6 h-6 rounded-full"
            />
            <.icon
              :if={!@article.remote_actor.avatar_url}
              name="hero-user-circle"
              class="size-5 opacity-50"
            />
          </span>
          {display_name(@article.remote_actor)}<span class="text-base-content/70">@{@article.remote_actor.domain}</span>
        </a>
      </span>
      <span :if={@article.user || @article.remote_actor}>&middot;</span>
      <a
        :if={@article.ap_id}
        href={@article.url || @article.ap_id}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="article-original-link link link-hover"
        title={gettext("View original")}
      >
        <time datetime={datetime_attr(article_datetime(@article))}>
          {format_datetime(article_datetime(@article))}
        </time>
      </a>
      <time :if={!@article.ap_id} datetime={datetime_attr(article_datetime(@article))}>
        {format_datetime(article_datetime(@article))}
      </time>
    </div>

    <div :if={@article.boards != []} class="article-boards flex items-center gap-2 text-sm">
      <span class="text-base-content/70">{gettext("Posted in")}</span>
      <.link
        :for={board <- @article.boards}
        id={"article-board-#{board.slug}"}
        navigate={~p"/boards/#{board.slug}"}
        class="article-board-link badge badge-outline"
      >
        {board.name}
      </.link>
    </div>

    <div class="divider"></div>

    <.muted_collapse
      id={"article-#{@article.id}-muted"}
      matchers={@muted_matchers}
      own={@current_user && @article.user_id == @current_user.id}
      texts={[
        @article.title,
        @article.summary,
        Baudrate.Moderation.PatternMatcher.text_of(@article.body)
      ]}
    >
      <.content_warning
        :if={Baudrate.Content.ContentWarning.warned?(@article)}
        id={"article-#{@article.id}-content-warning"}
        summary={@article.summary}
      >
        <div class="article-body prose max-w-none">
          {BaudrateWeb.SafeHTML.markdown(@article.body)}
        </div>
      </.content_warning>
      <div
        :if={!Baudrate.Content.ContentWarning.warned?(@article)}
        class="article-body prose max-w-none"
      >
        {BaudrateWeb.SafeHTML.markdown(@article.body)}
      </div>
    </.muted_collapse>

    <.link_preview
      :if={@article.link_preview && @article.link_preview.status in ["fetched", "failed"]}
      id={"article-#{@article.id}-link-preview"}
      preview={@article.link_preview}
    />

    <%!-- Poll Section --%>
    <section
      :if={@poll}
      id="article-poll"
      class="article-poll mt-6"
      aria-labelledby="poll-heading"
    >
      <div class="card bg-base-200 p-4">
        <h2 id="poll-heading" class="article-poll-heading text-base font-semibold mb-1">
          {gettext("Poll")}
          <span class="text-sm font-normal text-base-content/70">
            ({if @poll.mode == "single",
              do: gettext("Single choice"),
              else: gettext("Multiple choice")})
          </span>
        </h2>

        <div class="text-sm text-base-content/70 mb-3">
          <span :if={@poll_closed} class="badge badge-error badge-sm">{gettext("Closed")}</span>
          <span :if={@poll.closes_at && !@poll_closed}>
            {gettext("Closes %{time}", time: format_datetime(@poll.closes_at))}
          </span>
          <span class="ml-2">
            {ngettext("%{count} voter", "%{count} voters", @poll.voters_count)}
          </span>
        </div>

        <%!-- Vote form: shown when logged in (not moved), poll open, and not yet voted --%>
        <.form
          :if={@current_user && !moved_account?(@current_user) && !@poll_closed && !@has_voted}
          for={%{}}
          phx-submit="cast_vote"
          id="poll-vote-form"
          class="article-poll-vote-form space-y-2"
        >
          <fieldset id="article-poll-vote-options" class="article-poll-vote-options space-y-2">
            <legend class="article-poll-vote-options-legend sr-only">
              {gettext("Poll options")}
            </legend>
            <div
              :for={option <- @poll.options}
              id={"article-poll-option-#{option.id}"}
              class="article-poll-option form-control"
            >
              <label class="label cursor-pointer justify-start gap-3">
                <input
                  :if={@poll.mode == "single"}
                  id={"poll-option-#{option.id}"}
                  type="radio"
                  name="vote_option"
                  value={option.id}
                  class="article-poll-option-input radio radio-sm"
                />
                <input
                  :if={@poll.mode == "multiple"}
                  id={"poll-option-#{option.id}"}
                  type="checkbox"
                  name="vote_options[]"
                  value={option.id}
                  class="article-poll-option-input checkbox checkbox-sm"
                />
                <span class="label-text">{option.text}</span>
              </label>
            </div>
          </fieldset>
          <button
            id="poll-vote-submit"
            type="submit"
            class="article-poll-vote-submit btn btn-sm btn-primary"
            phx-disable-with={gettext("Voting...")}
          >
            {gettext("Vote")}
          </button>
        </.form>

        <%!-- Results: shown when voted, closed, guest, or moved (read-only) account --%>
        <div
          :if={
            @has_voted || @poll_closed || is_nil(@current_user) || moved_account?(@current_user)
          }
          class="article-poll-results space-y-2"
        >
          <div :for={option <- @poll.options} class="article-poll-result">
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="flex items-center gap-1">
                <.icon
                  :if={option.id in @user_votes}
                  name="hero-check-circle-solid"
                  class="size-4 text-success"
                />
                <span :if={option.id in @user_votes} class="article-poll-your-vote sr-only">
                  {gettext("Your vote")}
                </span>
                {option.text}
              </span>
              <span class="text-base-content/70">
                {poll_percentage(option.votes_count, total_votes(@poll))}% ({option.votes_count})
              </span>
            </div>
            <progress
              id={"article-poll-result-progress-#{option.id}"}
              class="article-poll-result-progress progress progress-primary w-full"
              aria-label={option.text}
              value={option.votes_count}
              max={max(total_votes(@poll), 1)}
            >
              {poll_percentage(option.votes_count, total_votes(@poll))}%
            </progress>
          </div>

          <button
            :if={@has_voted && !@poll_closed && !moved_account?(@current_user)}
            id="poll-change-vote"
            phx-click="change_vote"
            class="article-poll-change-vote btn btn-sm btn-ghost mt-2"
          >
            {gettext("Change vote")}
          </button>
        </div>
      </div>
    </section>

    <%!-- Article Images Gallery --%>
    <div :if={@article_images != []} id="article-images" class="mt-6">
      <div class={[
        "grid gap-2",
        length(@article_images) == 1 && "grid-cols-1",
        length(@article_images) == 2 && "grid-cols-2",
        length(@article_images) >= 3 && "grid-cols-2"
      ]}>
        <a
          :for={img <- @article_images}
          id={"article-image-#{img.id}"}
          href={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
          target="_blank"
          rel="noopener"
          class="article-image-link block overflow-hidden rounded-lg"
          aria-label={image_link_label(img, @article_images)}
        >
          <%!--
            alt="" on purpose: the link above already carries the description,
            and text in both announces the same image twice.
          --%>
          <img
            src={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
            width={img.width}
            height={img.height}
            loading="lazy"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-200 border border-base-300"
            alt=""
          />
        </a>
      </div>
    </div>

    <div
      :if={@article.user && @article.user.signature && @article.user.signature != ""}
      id="article-signature"
      class="article-signature mt-4"
    >
      <div class="divider text-sm text-base-content/70">{gettext("Signature")}</div>
      <div class="article-signature-body prose prose-sm max-w-none text-base-content/70">
        {BaudrateWeb.SafeHTML.markdown(@article.user.signature)}
      </div>
    </div>

    <div id="article-actions" class="article-actions flex gap-2 flex-wrap justify-end mt-4">
      <%!-- View original link for remote articles (ActivityPub / RSS feed) --%>
      <a
        :if={@article.url || @article.remote_actor}
        id="article-view-original"
        href={@article.url || @article.ap_id}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="article-action article-view-original btn btn-sm btn-ghost"
      >
        <.icon name="hero-link" class="size-4" />
        {gettext("View original")}
      </a>
      <%!-- Like count (visible to all) + toggle (for non-authors) --%>
      <span
        :if={!interaction_toggle?(@current_user, @article.user_id, @liked)}
        class="article-like-count btn btn-sm btn-ghost pointer-events-none"
      >
        <.icon name="hero-heart" class="size-4" />
        {ngettext("%{count} Like", "%{count} Likes", @like_count)}
      </span>
      <button
        :if={interaction_toggle?(@current_user, @article.user_id, @liked)}
        id="article-like-toggle"
        phx-click="toggle_like"
        class="article-action article-like-toggle btn btn-sm btn-ghost"
        aria-pressed={to_string(@liked)}
      >
        <.icon
          name={if @liked, do: "hero-heart-solid", else: "hero-heart"}
          class={["size-4", @liked && "text-error"]}
        />
        {ngettext("%{count} Like", "%{count} Likes", @like_count)}
      </button>
      <%!-- Boost count (visible to all) + toggle (for non-authors) --%>
      <span
        :if={!interaction_toggle?(@current_user, @article.user_id, @boosted)}
        class="article-boost-count btn btn-sm btn-ghost pointer-events-none"
      >
        <.icon name="hero-arrow-path-rounded-square" class="size-4" />
        {ngettext("%{count} Boost", "%{count} Boosts", @boost_count)}
      </span>
      <button
        :if={interaction_toggle?(@current_user, @article.user_id, @boosted)}
        id="article-boost-toggle"
        phx-click="toggle_boost"
        class="article-action article-boost-toggle btn btn-sm btn-ghost"
        aria-pressed={to_string(@boosted)}
      >
        <.icon
          name={
            if @boosted,
              do: "hero-arrow-path-rounded-square-solid",
              else: "hero-arrow-path-rounded-square"
          }
          class={["size-4", @boosted && "text-success"]}
        />
        {ngettext("%{count} Boost", "%{count} Boosts", @boost_count)}
      </button>
      <button
        :if={@current_user}
        id="article-watch-toggle"
        type="button"
        phx-click="toggle_watch"
        class="article-action article-watch-toggle btn btn-sm btn-ghost"
        aria-pressed={to_string(@watched)}
        title={gettext("Be notified of new comments in this thread")}
      >
        <.icon name={if @watched, do: "hero-eye-solid", else: "hero-eye"} class="size-4" />
        {if @watched, do: gettext("Watching"), else: gettext("Watch")}
      </button>
      <button
        :if={@current_user}
        id="article-bookmark-toggle"
        phx-click="toggle_bookmark"
        class="article-action article-bookmark-toggle btn btn-sm btn-ghost"
        aria-pressed={to_string(@bookmarked)}
      >
        <.icon
          name={if @bookmarked, do: "hero-bookmark-solid", else: "hero-bookmark"}
          class="size-4"
        />
        {if @bookmarked, do: gettext("Bookmarked"), else: gettext("Bookmark")}
      </button>
      <div
        :if={
          @can_edit || @can_delete || @can_pin || @can_lock || @revision_count > 0 ||
            (@can_forward && !@forward_search_open) || (@is_board_mod && @article.boards != []) ||
            (@current_user != nil && @article.user_id != @current_user.id)
        }
        class="article-menu dropdown dropdown-end"
      >
        <button
          id="article-menu-trigger"
          type="button"
          tabindex="0"
          class="article-menu-trigger btn btn-sm btn-ghost"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={gettext("More actions")}
        >
          <.icon name="hero-ellipsis-vertical" class="size-4" />
        </button>
        <ul
          id="article-menu"
          class="article-menu-list dropdown-content menu bg-base-200 rounded-box z-10 w-52 p-2 shadow-sm"
        >
          <li :if={@can_edit}>
            <.link id="article-menu-edit" navigate={~p"/articles/#{@article.slug}/edit"}>
              <.icon name="hero-pencil-square" class="size-4" />
              {gettext("Edit")}
            </.link>
          </li>
          <li :if={@revision_count > 0}>
            <.link id="article-menu-history" navigate={~p"/articles/#{@article.slug}/history"}>
              <.icon name="hero-clock" class="size-4" />
              {gettext("History")}
              <span class="badge badge-sm">{@revision_count}</span>
            </.link>
          </li>
          <li :if={@can_forward && !@forward_search_open}>
            <button id="article-menu-forward" phx-click="toggle_forward_search">
              <.icon name="hero-arrow-right-circle" class="size-4" />
              {gettext("Forward to Board")}
            </button>
          </li>
          <li :if={@can_pin}>
            <button id="article-menu-pin" phx-click="toggle_pin">
              <.icon
                name={if @article.pinned, do: "hero-bookmark-slash", else: "hero-bookmark"}
                class="size-4"
              />
              {if @article.pinned, do: gettext("Unpin"), else: gettext("Pin")}
            </button>
          </li>
          <li :if={@can_lock}>
            <button id="article-menu-lock" phx-click="toggle_lock">
              <.icon
                name={if @article.locked, do: "hero-lock-open", else: "hero-lock-closed"}
                class="size-4"
              />
              {if @article.locked, do: gettext("Unlock"), else: gettext("Lock")}
            </button>
          </li>
          <li
            :if={(@current_user != nil && @article.user_id != @current_user.id) || @can_delete}
            class="border-t border-base-300 my-1"
          >
          </li>
          <li :if={@current_user && @article.user_id != @current_user.id}>
            <button
              id="article-menu-report"
              phx-click="open_report_modal"
              phx-value-type="article"
              phx-value-id={@article.id}
              phx-value-label={@article.title}
            >
              <.icon name="hero-flag" class="size-4" />
              {gettext("Report")}
            </button>
          </li>
          <li :if={@is_board_mod && @article.boards != [] && !@move_open}>
            <button id="article-menu-move" phx-click="open_move" class="article-menu-move">
              <.icon name="hero-arrows-right-left" class="size-4" />
              {gettext("Move to another board")}
            </button>
          </li>
          <%= if @removable_board_ids != [] do %>
            <li :for={board <- @article.boards} :if={board.id in @removable_board_ids}>
              <button
                id={"article-menu-remove-board-#{board.id}"}
                phx-click="remove_from_board"
                phx-value-board-id={board.id}
                data-confirm={gettext("Remove this article from %{board}?", board: board.name)}
                class="article-menu-remove-board"
              >
                <.icon name="hero-minus-circle" class="size-4" />
                {gettext("Remove from %{board}", board: board.name)}
              </button>
            </li>
          <% end %>
          <li :if={@can_delete}>
            <button
              id="article-menu-delete"
              phx-click="delete_article"
              data-confirm={gettext("Are you sure you want to delete this article?")}
              class="article-menu-delete text-error"
            >
              <.icon name="hero-trash" class="size-4" />
              {gettext("Delete")}
            </button>
          </li>
        </ul>
      </div>
    </div>

    <section
      :if={@move_open}
      id="article-move-panel"
      class="article-move-panel card bg-base-200 mt-2"
      aria-labelledby="article-move-heading"
    >
      <div class="card-body py-3 gap-2">
        <h2 id="article-move-heading" class="article-move-heading font-semibold">
          {gettext("Move to another board")}
        </h2>
        <p
          :if={@move_targets == []}
          id="article-move-no-targets"
          class="article-move-no-targets text-sm"
        >
          {gettext("There is no other board you moderate to move it to.")}
        </p>
        <form
          :if={@move_targets != [] && @move_from_options != []}
          id="article-move-form"
          class="article-move-form flex flex-wrap items-end gap-2"
          phx-submit="move_article"
        >
          <label for="article-move-from" class="fieldset">
            <span class="label">{gettext("From")}</span>
            <select
              id="article-move-from"
              name="from_id"
              class="article-move-from select select-sm"
            >
              <option :for={board <- @move_from_options} value={board.id}>{board.name}</option>
            </select>
          </label>
          <label for="article-move-to" class="fieldset">
            <span class="label">{gettext("To")}</span>
            <select id="article-move-to" name="to_id" class="article-move-to select select-sm">
              <option :for={board <- @move_targets} value={board.id}>{board.name}</option>
            </select>
          </label>
          <button
            type="submit"
            id="article-move-submit"
            class="article-move-submit btn btn-sm btn-primary"
          >
            {gettext("Move")}
          </button>
        </form>
        <div>
          <button
            type="button"
            id="article-move-cancel"
            phx-click="close_move"
            class="article-move-cancel btn btn-sm btn-ghost"
          >
            {gettext("Cancel")}
          </button>
        </div>
      </div>
    </section>

    <div
      :if={@can_forward && @forward_search_open}
      id="forward-search-panel"
      class="article-forward-panel flex items-center gap-2 text-sm mt-2"
    >
      <div class="w-full max-w-md">
        <.form
          for={%{}}
          id="article-forward-form"
          phx-change="search_forward_board"
          class="article-forward-form flex items-center gap-2"
        >
          <input
            id="article-forward-input"
            type="text"
            name="query"
            value={@forward_search_query}
            placeholder={gettext("Search boards...")}
            phx-debounce="300"
            autocomplete="off"
            class="article-forward-input input input-sm input-bordered w-full"
            aria-label={gettext("Search boards")}
            aria-describedby="forward-board-results-status"
          />
          <button
            id="article-forward-cancel"
            type="button"
            phx-click="toggle_forward_search"
            class="article-forward-cancel btn btn-sm btn-ghost"
            aria-label={gettext("Cancel")}
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </.form>
        <p
          id="forward-board-results-status"
          class="article-forward-results-status sr-only"
          role="status"
        >
          {if String.length(String.trim(@forward_search_query)) >= 2,
            do:
              ngettext(
                "%{count} board found",
                "%{count} boards found",
                length(@forward_search_results),
                count: length(@forward_search_results)
              ),
            else: ""}
        </p>
        <ul
          :if={@forward_search_results != []}
          id="forward-board-results"
          aria-label={gettext("Matching boards")}
          class="article-forward-results menu bg-base-200 rounded-box mt-1 shadow-lg max-h-48 overflow-y-auto"
        >
          <li :for={board <- @forward_search_results}>
            <button
              id={"article-forward-result-#{board.id}"}
              phx-click="forward_to_board"
              phx-value-board-id={board.id}
              type="button"
              class="article-forward-result"
            >
              {board.name}
            </button>
          </li>
        </ul>
      </div>
    </div>
  </article>

  <%!-- Comments Section --%>
  <section
    id="comments-section"
    class="article-comments-section mt-8"
    aria-labelledby="comments-heading"
  >
    <h2 id="comments-heading" class="article-comments-heading text-lg font-semibold mb-4">
      {gettext("Comments")}
      <span
        id="comments-total"
        class="article-comments-total text-base-content/70 font-normal text-sm"
      >
        ({@comment_total})
      </span>
    </h2>

    <p
      :if={@first_new_comment_path}
      id="comments-new-since"
      class="article-comments-new-since mb-4"
    >
      <.link
        id="comments-first-new"
        patch={@first_new_comment_path}
        class="article-comments-first-new link link-primary"
      >
        {gettext("Jump to the first new comment")}
      </.link>
    </p>

    <%!-- Locked thread alert --%>
    <div
      :if={@article.locked}
      class="article-comments-locked alert alert-warning mb-4"
      role="alert"
    >
      <.icon name="hero-lock-closed" class="size-5" />
      <span>{gettext("This thread is locked. No new comments can be posted.")}</span>
    </div>

    <%!-- Comment form (top-level) --%>
    <div :if={@can_comment && is_nil(@replying_to)} class="article-comment-form-wrapper mb-6">
      <.form
        for={@comment_form}
        phx-change="validate_comment"
        phx-submit="submit_comment"
        id="comment-form"
        phx-hook="DraftSaveHook"
        data-draft-key={"draft:u#{@current_user.id}:comment:#{@article.id}"}
        data-draft-fields="comment[body]"
        data-draft-indicator="#draft-indicator-comment"
        data-draft-saved-text={gettext("Draft saved")}
        data-draft-restored-text={gettext("Draft restored")}
        class="article-comment-form space-y-3"
      >
        <.input
          field={@comment_form[:body]}
          type="textarea"
          placeholder={gettext("Write a comment...")}
          toolbar
          rows="6"
        />
        <.input
          id="comment-content-warning"
          field={@comment_form[:summary]}
          type="text"
          placeholder={gettext("Content warning (optional)")}
          maxlength="512"
          class="input-sm content-warning-input"
          aria-label={gettext("Content warning")}
        />
        <%!-- Image upload for new comment --%>
        <BaudrateWeb.CommentComponents.comment_image_upload_area
          uploads={@uploads}
          uploaded_images={@uploaded_comment_images}
        />
        <div class="flex flex-wrap items-center gap-3 [&>.fieldset]:mb-0 [&>.fieldset]:p-0 [&_.label]:py-0">
          <.input
            field={@comment_form[:visibility]}
            type="select"
            options={[
              {gettext("Public"), "public"},
              {gettext("Unlisted"), "unlisted"}
            ]}
            class="select select-sm"
            aria-label={gettext("Visibility")}
          />
          <button
            id="comment-submit"
            type="submit"
            class="article-comment-submit btn btn-sm btn-primary"
            phx-disable-with={gettext("Posting...")}
          >
            {gettext("Post Comment")}
          </button>
          <span
            id="draft-indicator-comment"
            class="text-sm text-base-content/70 transition-opacity duration-300 opacity-0"
            aria-live="polite"
            aria-atomic="true"
          ></span>
        </div>
      </.form>
    </div>

    <%!-- A guest is told how to join in, but only where a member could:
         never on a locked thread or in a board limited to staff. --%>
    <p
      :if={is_nil(@current_user) && @member_could_comment}
      id="comments-sign-in-prompt"
      class="article-comments-sign-in-prompt mb-6"
    >
      <.link
        id="comments-sign-in-link"
        navigate={~p"/login?#{[return_to: ~p"/articles/#{@article.slug}"]}"}
        class="article-comments-sign-in-link link link-primary"
      >
        {gettext("Sign in to comment")}
      </.link>
      <span :if={@guest_can_register} class="article-comments-register">
        {gettext("or")}
        <.link
          id="comments-register-link"
          navigate={~p"/register"}
          class="article-comments-register-link link link-primary"
        >
          {gettext("create an account")}
        </.link>
      </span>
    </p>

    <div
      :if={@comment_roots == [] && !@can_comment}
      class="article-comments-empty text-base-content/70 text-center py-4"
    >
      {gettext("No comments yet.")}
    </div>

    <%!-- Comment tree --%>
    <p id="comments-live-status" class="article-comments-live-status sr-only" role="status">
      {@comments_live_status}
    </p>

    <div
      id="comments"
      class="article-comments space-y-4"
      role="list"
      aria-label={gettext("Comments")}
    >
      <%= for comment <- @comment_roots do %>
        <.comment_node
          comment={comment}
          children_map={@children_map}
          depth={0}
          can_comment={@can_comment}
          can_delete={@is_board_mod}
          replying_to={@replying_to}
          comment_form={@comment_form}
          current_user={@current_user}
          muted_matchers={@muted_matchers}
          comment_liked_ids={@comment_liked_ids}
          comment_like_counts={@comment_like_counts}
          comment_boosted_ids={@comment_boosted_ids}
          comment_boost_counts={@comment_boost_counts}
          comment_bookmarked_ids={@comment_bookmarked_ids}
          forwarding_comment_id={@forwarding_comment_id}
          comment_forward_search_results={@comment_forward_search_results}
          comment_forward_search_query={@comment_forward_search_query}
          uploads={if @can_comment, do: @uploads, else: nil}
          uploaded_comment_images={@uploaded_comment_images}
          editing={@editing}
          comment_edit_form={@comment_edit_form}
          revision_counts={@revision_counts}
          new_comment_ids={@new_comment_ids}
        />
      <% end %>
    </div>

    <.pagination
      page={@comment_page}
      total_pages={@comment_total_pages}
      path={~p"/articles/#{@article.slug}"}
      scroll_target="comments-section"
    />
  </section>
</div>

<.report_modal
  show={@show_report_modal}
  target_type={@report_target_type}
  target_label={@report_target_label}
  on_close="close_report_modal"
  on_submit="submit_report"
/>
