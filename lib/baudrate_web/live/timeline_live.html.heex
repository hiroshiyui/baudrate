<div class="flex items-center justify-between mb-6">
  <h1 id="timeline-heading" class="timeline-heading text-2xl font-bold">
    {gettext("Timeline")}
    <span
      :if={@total > 0}
      class="timeline-count badge badge-neutral ml-2"
      aria-label={gettext("%{count} items", count: @total)}
    >
      {@total}
    </span>
  </h1>
</div>

<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-6 lg:items-start">
  <div class="space-y-6 min-w-0">
    <div :if={@can_post} id="quick-post" class="card bg-base-200 shadow-sm">
      <div class="card-body p-4">
        <div class="flex gap-3">
          <div class="hidden sm:block flex-shrink-0 pt-1">
            <.avatar user={@current_user} size={36} />
          </div>
          <.form
            for={@form}
            id="timeline-quick-post-form"
            phx-change="validate_post"
            phx-submit="submit_post"
            class="timeline-quick-post-form flex-1 space-y-3"
          >
            <.input
              field={@form[:title]}
              placeholder={gettext("Title")}
              aria-label={gettext("Title")}
              autocomplete="off"
            />
            <.input
              field={@form[:body]}
              type="textarea"
              placeholder={gettext("Oh! I just had a thought!")}
              aria-label={gettext("Oh! I just had a thought!")}
              rows={6}
              toolbar
            />

            <%!-- Attachments toolbar --%>
            <div class="flex items-center gap-1">
              <.live_file_input upload={@uploads.article_images} class="hidden" />
              <label
                :if={length(@uploaded_images) < 4}
                id="timeline-add-images-label"
                for={@uploads.article_images.ref}
                class="timeline-add-images btn btn-sm btn-ghost gap-1 cursor-pointer"
                aria-label={gettext("Add Images")}
              >
                <.icon name="hero-photo" class="size-5" />
                {gettext("Add Images")}
              </label>
              <button
                type="button"
                id="timeline-toggle-poll"
                phx-click="toggle_poll"
                class={[
                  "timeline-toggle-poll btn btn-sm",
                  (@poll_enabled && "btn-error btn-outline") || "btn-ghost"
                ]}
              >
                <.icon name="hero-chart-bar" class="size-4" />
                {if @poll_enabled, do: gettext("Remove Poll"), else: gettext("Add Poll")}
              </button>
            </div>

            <%!-- Image Upload Section --%>
            <div id="timeline-images-section">
              <%!-- Uploaded image thumbnails --%>
              <div
                :if={@uploaded_images != []}
                class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2"
              >
                <div
                  :for={img <- @uploaded_images}
                  id={"timeline-post-image-#{img.id}"}
                  class="timeline-post-image"
                >
                  <div class="relative group aspect-square">
                    <img
                      src={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
                      class="w-full h-full object-cover rounded-lg border border-base-300"
                      loading="lazy"
                      alt={img.alt || gettext("Uploaded image")}
                    />
                    <button
                      type="button"
                      phx-click="remove_image"
                      phx-value-id={img.id}
                      class="timeline-remove-image absolute top-1 right-1 btn btn-circle btn-error min-h-[44px] min-w-[44px] opacity-80 sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100 sm:focus-visible:opacity-100 transition-opacity"
                      aria-label={gettext("Remove image")}
                    >
                      <.icon name="hero-x-mark" class="size-4" />
                    </button>
                  </div>
                  <.image_alt_input image={img} />
                </div>
              </div>

              <%!-- Upload progress & errors --%>
              <div
                :for={entry <- @uploads.article_images.entries}
                class="flex items-center gap-2 text-sm"
              >
                <span class="truncate max-w-48">{entry.client_name}</span>
                <progress
                  value={entry.progress}
                  max="100"
                  class="progress progress-primary w-24"
                  aria-label={gettext("Upload progress: %{percent}%", percent: entry.progress)}
                  aria-valuenow={entry.progress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                >
                  {entry.progress}%
                </progress>
                <button
                  type="button"
                  phx-click="cancel_image_upload"
                  phx-value-ref={entry.ref}
                  class="btn btn-sm btn-ghost text-error"
                  aria-label={gettext("Cancel upload")}
                >
                  &times;
                </button>
              </div>

              <div
                :for={err <- upload_errors(@uploads.article_images)}
                class="text-sm text-error"
                role="alert"
              >
                {upload_error_to_string(err)}
              </div>

              <div
                :for={entry <- @uploads.article_images.entries}
                :if={upload_errors(@uploads.article_images, entry) != []}
              >
                <div
                  :for={err <- upload_errors(@uploads.article_images, entry)}
                  class="text-sm text-error"
                  role="alert"
                >
                  {upload_error_to_string(err)}
                </div>
              </div>
            </div>

            <%!-- Poll Section --%>
            <div id="timeline-poll-section">
              <fieldset :if={@poll_enabled} class="space-y-3">
                <legend class="sr-only">{gettext("Poll")}</legend>

                <div role="group" aria-label={gettext("Poll options")} class="space-y-2">
                  <div
                    :for={{opt, idx} <- Enum.with_index(@poll_options)}
                    class="flex items-center gap-2"
                  >
                    <input
                      id={"timeline-poll-option-#{idx}"}
                      type="text"
                      name={"poll_options[#{idx}]"}
                      value={opt}
                      placeholder={gettext("Option %{number}", number: idx + 1)}
                      class="timeline-poll-option-input input input-bordered input-sm w-full"
                      aria-label={gettext("Option %{number}", number: idx + 1)}
                      maxlength="200"
                    />
                    <button
                      :if={length(@poll_options) > 2}
                      type="button"
                      phx-click="remove_poll_option"
                      phx-value-index={idx}
                      class="btn btn-sm btn-ghost text-error"
                      aria-label={gettext("Remove option %{number}", number: idx + 1)}
                    >
                      <.icon name="hero-x-mark" class="size-4" />
                    </button>
                  </div>
                </div>

                <button
                  :if={length(@poll_options) < 4}
                  type="button"
                  phx-click="add_poll_option"
                  class="btn btn-sm btn-ghost"
                >
                  <.icon name="hero-plus" class="size-4" />
                  {gettext("Add option")}
                </button>

                <div
                  class="flex flex-wrap gap-4"
                  role="radiogroup"
                  aria-label={gettext("Poll voting mode")}
                >
                  <div class="form-control">
                    <label class="label cursor-pointer gap-2">
                      <input
                        type="radio"
                        name="poll_mode"
                        value="single"
                        checked={@poll_mode == "single"}
                        class="radio radio-sm"
                      />
                      <span class="label-text">{gettext("Single choice")}</span>
                    </label>
                  </div>
                  <div class="form-control">
                    <label class="label cursor-pointer gap-2">
                      <input
                        type="radio"
                        name="poll_mode"
                        value="multiple"
                        checked={@poll_mode == "multiple"}
                        class="radio radio-sm"
                      />
                      <span class="label-text">{gettext("Multiple choice")}</span>
                    </label>
                  </div>
                </div>

                <div class="form-control w-full max-w-xs">
                  <label class="label" for="timeline-poll-expires">
                    <span class="label-text">{gettext("Expires (optional)")}</span>
                  </label>
                  <select
                    id="timeline-poll-expires"
                    name="poll_expires"
                    class="select select-bordered select-sm"
                  >
                    <option value="" selected={@poll_expires == ""}>
                      {gettext("No expiry")}
                    </option>
                    <option value="1h" selected={@poll_expires == "1h"}>
                      {gettext("1 hour")}
                    </option>
                    <option value="6h" selected={@poll_expires == "6h"}>
                      {gettext("6 hours")}
                    </option>
                    <option value="1d" selected={@poll_expires == "1d"}>
                      {gettext("1 day")}
                    </option>
                    <option value="3d" selected={@poll_expires == "3d"}>
                      {gettext("3 days")}
                    </option>
                    <option value="7d" selected={@poll_expires == "7d"}>
                      {gettext("7 days")}
                    </option>
                  </select>
                </div>
              </fieldset>
            </div>

            <%!-- Board selection (search-based) --%>
            <div id="quick-post-boards" class="fieldset">
              <span class="label label-text text-sm">{gettext("Board (optional)")}</span>

              <ul
                :if={@selected_post_boards != []}
                id="selected-post-boards"
                class="flex flex-wrap gap-2 mb-2"
                aria-label={gettext("Selected boards")}
              >
                <li
                  :for={board <- @selected_post_boards}
                  class="selected-post-board badge badge-primary badge-sm gap-1"
                >
                  <span>{board.name}</span>
                  <button
                    type="button"
                    phx-click="remove_post_board"
                    phx-value-board-id={board.id}
                    class="btn btn-ghost btn-xs btn-circle"
                    aria-label={gettext("Remove %{name}", name: board.name)}
                  >
                    <.icon name="hero-x-mark" class="size-3" />
                  </button>
                </li>
              </ul>

              <div class="w-full">
                <input
                  type="text"
                  name="post_board_search_query"
                  value={@post_board_search_query}
                  placeholder={gettext("Search boards...")}
                  phx-keyup="search_post_boards"
                  phx-debounce="300"
                  autocomplete="off"
                  class="input input-sm input-bordered w-full"
                  id="post-board-search-input"
                  aria-label={gettext("Search boards")}
                  aria-describedby="post-board-search-status"
                />
                <p
                  id="post-board-search-status"
                  class="post-board-search-status sr-only"
                  role="status"
                >
                  {if String.length(String.trim(@post_board_search_query)) >= 2,
                    do:
                      ngettext(
                        "%{count} board found",
                        "%{count} boards found",
                        length(@post_board_search_results),
                        count: length(@post_board_search_results)
                      ),
                    else: ""}
                </p>
                <ul
                  :if={@post_board_search_results != []}
                  id="post-board-search-results"
                  aria-label={gettext("Matching boards")}
                  class="post-board-search-results menu bg-base-200 rounded-box mt-1 shadow-lg max-h-48 overflow-y-auto"
                >
                  <li :for={board <- @post_board_search_results}>
                    <button
                      type="button"
                      id={"post-board-search-result-#{board.id}"}
                      class="post-board-search-result"
                      phx-click="add_post_board"
                      phx-value-board-id={board.id}
                    >
                      {board.name}
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 [&>.fieldset]:mb-0 [&>.fieldset]:p-0 [&_.label]:py-0">
              <.input
                field={@form[:visibility]}
                type="select"
                options={[
                  {gettext("Public"), "public"},
                  {gettext("Unlisted"), "unlisted"}
                ]}
                class="select select-sm"
                aria-label={gettext("Visibility")}
              />
              <button
                type="submit"
                id="timeline-post-submit"
                class="timeline-post-submit btn btn-primary btn-sm"
                phx-disable-with={gettext("Posting...")}
              >
                {gettext("Post")}
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>

    <p id="timeline-live-status" class="timeline-live-status sr-only" role="status">
      {@timeline_live_status}
    </p>

    <div
      :if={@items == []}
      id="timeline-empty"
      class="timeline-empty text-base-content/70 text-center py-8"
    >
      {gettext("Your timeline is empty.")}
      <div class="mt-2">
        <.link id="timeline-empty-search-link" navigate="/search" class="link link-primary">
          {gettext("Search for users or remote actors to follow")}
        </.link>
      </div>
    </div>

    <div
      :if={@items != []}
      id="timeline-items"
      class="space-y-4"
      role="feed"
      aria-labelledby="timeline-heading"
      data-focus-target
    >
      <article
        :for={{item, idx} <- Enum.with_index(@items)}
        aria-posinset={(@page - 1) * @per_page + idx + 1}
        aria-setsize={@total}
        id={
          "timeline-item-" <>
            case item.source do
              :remote -> "fi-#{item.timeline_item.id}"
              :local -> "a-#{item.article.id}"
              :local_comment -> "c-#{item.comment.id}"
            end
        }
        class="timeline-item card bg-base-200 shadow-sm"
        aria-label={timeline_item_label(item)}
      >
        <%!-- Remote timeline item --%>
        <div :if={item.source == :remote} class="card-body p-4">
          <%!-- Boost attribution --%>
          <div
            :if={
              item.timeline_item.activity_type == "Announce" &&
                item.timeline_item.boosted_by_actor
            }
            class="flex items-center gap-1.5 text-xs text-base-content/60 mb-2"
          >
            <.icon name="hero-arrow-path-rounded-square" class="size-3.5" />
            <a
              href={remote_actor_profile_url(item.timeline_item.boosted_by_actor)}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="link link-hover font-semibold break-words"
            >
              {item.timeline_item.boosted_by_actor.display_name ||
                item.timeline_item.boosted_by_actor.username}
            </a>
            {gettext("boosted")}
          </div>

          <div class="flex items-center gap-3 mb-2">
            <div
              class="avatar"
              role="img"
              aria-label={
                item.timeline_item.remote_actor.display_name ||
                  item.timeline_item.remote_actor.username
              }
            >
              <div class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center">
                <img
                  :if={item.timeline_item.remote_actor.avatar_url}
                  src={Baudrate.Media.Proxy.url(item.timeline_item.remote_actor.avatar_url)}
                  alt=""
                  class="rounded-full"
                />
                <.icon
                  :if={!item.timeline_item.remote_actor.avatar_url}
                  name="hero-user-circle"
                  class="size-7 opacity-50"
                />
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <a
                href={remote_actor_profile_url(item.timeline_item.remote_actor)}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="link link-hover"
              >
                <div class="font-bold text-sm truncate">
                  {item.timeline_item.remote_actor.display_name ||
                    item.timeline_item.remote_actor.username}
                </div>
                <div class="text-xs text-base-content/60 truncate">
                  @{item.timeline_item.remote_actor.username}@{item.timeline_item.remote_actor.domain}
                </div>
              </a>
            </div>
            <div class="flex flex-col items-end flex-shrink-0">
              <time
                class="text-xs text-base-content/70"
                datetime={DateTime.to_iso8601(item.timeline_item.published_at)}
              >
                {format_datetime(item.timeline_item.published_at)}
              </time>
              <span class={[
                "badge badge-xs",
                item.timeline_item.object_type == "Note" && "badge-info",
                item.timeline_item.object_type in ["Article", "Page"] && "badge-accent"
              ]}>
                {translate_object_type(item.timeline_item.object_type)}
              </span>
            </div>
          </div>

          <h2
            :if={item.timeline_item.title}
            class="timeline-item-title font-semibold text-lg mb-1 break-words"
          >
            {item.timeline_item.title}
          </h2>

          <.content_warning
            :if={Baudrate.Content.ContentWarning.warned?(item.timeline_item)}
            id={"timeline-item-#{item.timeline_item.id}-content-warning"}
            summary={item.timeline_item.summary}
          >
            <p class="timeline-item-body text-sm text-base-content/80 break-words">
              {digest(item.timeline_item.body_html)}
            </p>
          </.content_warning>
          <p
            :if={!Baudrate.Content.ContentWarning.warned?(item.timeline_item)}
            class="timeline-item-body text-sm text-base-content/80 line-clamp-3 break-words"
          >
            {digest(item.timeline_item.body_html)}
          </p>

          <div
            :if={timeline_images(item.timeline_item) != []}
            class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2"
          >
            <a
              :for={att <- timeline_images(item.timeline_item)}
              href={att["url"]}
              target="_blank"
              rel="nofollow noopener noreferrer"
            >
              <img
                src={Baudrate.Media.Proxy.url(att["url"])}
                alt={att["name"] || gettext("Image attachment")}
                class="w-full aspect-square object-cover rounded-lg border border-base-300"
                loading="lazy"
              />
            </a>
          </div>

          <%!-- Video and audio are links, never players: proxying arbitrarily
          large files is not what the media proxy is for, and embedding them
          would be the hotlink it exists to prevent (ADR 0052). --%>
          <div :if={timeline_media(item.timeline_item) != []} class="flex flex-col gap-1 mt-2">
            <a
              :for={att <- timeline_media(item.timeline_item)}
              href={att["url"]}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="timeline-item-media-link btn btn-ghost btn-xs justify-start gap-2"
            >
              <.icon name="hero-play-circle" class="size-4 shrink-0" />
              <span class="truncate">{att["name"] || gettext("Media attachment")}</span>
            </a>
          </div>

          <div class="flex items-center gap-1 mt-2">
            <a
              :if={item.timeline_item.source_url}
              href={item.timeline_item.source_url}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="timeline-item-source-link btn btn-ghost btn-xs"
              title={gettext("View original")}
              aria-label={gettext("View original")}
            >
              <.icon name="hero-link" class="size-4" />
            </a>
            <button
              phx-click="toggle_reply"
              phx-value-id={item.timeline_item.id}
              class="timeline-item-reply btn btn-ghost btn-xs"
            >
              <.icon name="hero-chat-bubble-left" class="size-4" />
              {gettext("Reply")}
              <span
                :if={reply_count(assigns, item.timeline_item.id) > 0}
                class="badge badge-xs"
              >
                {reply_count(assigns, item.timeline_item.id)}
              </span>
            </button>
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  nil,
                  MapSet.member?(@timeline_item_liked_ids, item.timeline_item.id)
                )
              }
              phx-click="toggle_timeline_item_like"
              phx-value-id={item.timeline_item.id}
              class="timeline-item-like btn btn-ghost btn-xs"
              aria-label={gettext("Like")}
              aria-pressed={
                to_string(MapSet.member?(@timeline_item_liked_ids, item.timeline_item.id))
              }
            >
              <.icon
                name={
                  if MapSet.member?(@timeline_item_liked_ids, item.timeline_item.id),
                    do: "hero-heart-solid",
                    else: "hero-heart"
                }
                class={[
                  "size-4",
                  MapSet.member?(@timeline_item_liked_ids, item.timeline_item.id) && "text-error"
                ]}
              />
            </button>
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  nil,
                  MapSet.member?(@timeline_item_boosted_ids, item.timeline_item.id)
                )
              }
              phx-click="toggle_timeline_item_boost"
              phx-value-id={item.timeline_item.id}
              class="timeline-item-boost btn btn-ghost btn-xs"
              aria-label={gettext("Boost")}
              aria-pressed={
                to_string(MapSet.member?(@timeline_item_boosted_ids, item.timeline_item.id))
              }
            >
              <.icon
                name={
                  if MapSet.member?(@timeline_item_boosted_ids, item.timeline_item.id),
                    do: "hero-arrow-path-rounded-square-solid",
                    else: "hero-arrow-path-rounded-square"
                }
                class={[
                  "size-4",
                  MapSet.member?(@timeline_item_boosted_ids, item.timeline_item.id) &&
                    "text-success"
                ]}
              />
            </button>
            <button
              :if={
                !moved_account?(@current_user) and
                  item.timeline_item.visibility in ["public", "unlisted"]
              }
              phx-click="toggle_forward_search"
              phx-value-id={item.timeline_item.id}
              phx-value-type="timeline_item"
              class="timeline-item-forward btn btn-ghost btn-xs"
              aria-label={gettext("Forward to Board")}
              title={gettext("Forward to Board")}
            >
              <.icon name="hero-arrow-uturn-right" class="size-4" />
            </button>
            <div
              id={"timeline-item-actions-menu-#{item.timeline_item.id}"}
              class="timeline-item-actions-menu dropdown dropdown-end ml-auto"
            >
              <button
                type="button"
                tabindex="0"
                id={"timeline-item-actions-menu-toggle-#{item.timeline_item.id}"}
                class="timeline-item-actions-menu-toggle btn btn-ghost btn-xs btn-circle"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={gettext("More actions")}
              >
                <.icon name="hero-ellipsis-vertical" class="size-4" />
              </button>
              <ul
                tabindex="0"
                class="timeline-item-actions-menu-list dropdown-content menu bg-base-200 rounded-box z-10 w-56 p-2 shadow-sm"
              >
                <li>
                  <button
                    type="button"
                    id={"timeline-item-report-#{item.timeline_item.id}"}
                    class="timeline-item-report"
                    phx-click="open_report_modal"
                    phx-value-type="timeline_item"
                    phx-value-id={item.timeline_item.id}
                    phx-value-label={
                      String.slice(
                        item.timeline_item.title || item.timeline_item.body || "",
                        0..100
                      )
                    }
                  >
                    <.icon name="hero-flag" class="size-4" />
                    {gettext("Report post")}
                  </button>
                </li>
                <BaudrateWeb.SafetyComponents.remote_actor_safety_items
                  actor={item.timeline_item.remote_actor}
                  id_prefix={"timeline-item-#{item.timeline_item.id}"}
                />
              </ul>
            </div>
          </div>

          <%!-- Forward search panel --%>
          <div
            :if={
              @forwarding_item_id == item.timeline_item.id and
                @forwarding_item_type == "timeline_item"
            }
            id={"forward-search-#{item.timeline_item.id}"}
            class="flex items-center gap-2 text-sm mt-2"
          >
            <div class="w-full max-w-md">
              <.form
                for={%{}}
                id={"timeline-forward-form-#{item.timeline_item.id}"}
                phx-change="search_forward_board"
                class="flex items-center gap-2"
              >
                <input
                  type="text"
                  name="query"
                  value={@forward_search_query}
                  placeholder={gettext("Search boards...")}
                  phx-debounce="300"
                  autocomplete="off"
                  class="input input-sm input-bordered w-full"
                  aria-label={gettext("Search boards")}
                />
                <button
                  type="button"
                  phx-click="cancel_forward_search"
                  class="btn btn-sm btn-ghost"
                  aria-label={gettext("Cancel")}
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </.form>
              <p
                id={"forward-board-results-status-#{item.timeline_item.id}"}
                class="timeline-forward-results-status sr-only"
                role="status"
              >
                {if String.length(String.trim(@forward_search_query)) >= 2,
                  do:
                    ngettext(
                      "%{count} board found",
                      "%{count} boards found",
                      length(@forward_search_results),
                      count: length(@forward_search_results)
                    ),
                  else: ""}
              </p>
              <ul
                :if={@forward_search_results != []}
                id={"forward-board-results-#{item.timeline_item.id}"}
                aria-label={gettext("Matching boards")}
                class="timeline-forward-results menu bg-base-200 rounded-box mt-1 shadow-lg max-h-48 overflow-y-auto"
              >
                <li :for={board <- @forward_search_results}>
                  <button
                    type="button"
                    class="timeline-forward-result"
                    phx-click="forward_to_board"
                    phx-value-board-id={board.id}
                  >
                    {board.name}
                  </button>
                </li>
              </ul>
            </div>
          </div>

          <%!-- Inline reply form --%>
          <div
            :if={@replying_to == item.timeline_item.id}
            class="mt-3 border-t border-base-300 pt-3"
          >
            <%!-- Existing replies --%>
            <div
              :if={Map.get(@replies, item.timeline_item.id, []) != []}
              class="space-y-2 mb-3"
            >
              <div
                :for={reply <- Map.get(@replies, item.timeline_item.id, [])}
                class="flex gap-2 items-start"
              >
                <.avatar user={reply.user} size={24} />
                <div class="flex-1 min-w-0">
                  <span class="font-semibold text-xs">{display_name(reply.user)}</span>
                  <span class="text-xs text-base-content/60 ml-1">
                    {format_datetime(reply.inserted_at)}
                  </span>
                  <.content_warning
                    :if={Baudrate.Content.ContentWarning.warned?(reply)}
                    id={"timeline-reply-#{reply.id}-content-warning"}
                    class="mt-0.5"
                    summary={reply.summary}
                  >
                    <p class="text-sm text-base-content/80">{digest(reply.body_html)}</p>
                  </.content_warning>
                  <p
                    :if={!Baudrate.Content.ContentWarning.warned?(reply)}
                    class="text-sm text-base-content/80 mt-0.5"
                  >
                    {digest(reply.body_html)}
                  </p>
                  <%!-- Reply image gallery --%>
                  <div
                    :if={is_list(reply.images) && reply.images != []}
                    class={[
                      "grid gap-1 mt-1",
                      length(reply.images) == 1 && "grid-cols-1",
                      length(reply.images) >= 2 && "grid-cols-2"
                    ]}
                  >
                    <a
                      :for={img <- reply.images}
                      href={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
                      target="_blank"
                      rel="noopener"
                      class="block overflow-hidden rounded-md"
                      aria-label={image_link_label(img, reply.images)}
                    >
                      <%!-- alt="" — the link carries the description. --%>
                      <img
                        src={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
                        width={img.width}
                        height={img.height}
                        loading="lazy"
                        class="w-full h-auto rounded-md border border-base-300"
                        alt=""
                      />
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <.form
              :if={!moved_account?(@current_user)}
              for={@reply_form}
              id={"timeline-reply-form-#{item.timeline_item.id}"}
              phx-change="validate_reply"
              phx-submit="submit_reply"
              class="timeline-reply-form space-y-2"
            >
              <input type="hidden" name="timeline_item_id" value={item.timeline_item.id} />
              <.input
                field={@reply_form[:body]}
                type="textarea"
                rows={6}
                placeholder={gettext("Write a reply...")}
                aria-label={gettext("Write a reply...")}
              />
              <.input
                id={"timeline-reply-content-warning-#{item.timeline_item.id}"}
                field={@reply_form[:summary]}
                type="text"
                placeholder={gettext("Content warning (optional)")}
                maxlength="512"
                class="input-sm content-warning-input"
                aria-label={gettext("Content warning")}
              />
              <%!-- Image upload for reply --%>
              <BaudrateWeb.CommentComponents.reply_image_upload_area
                uploads={@uploads}
                uploaded_images={@uploaded_reply_images}
              />
              <div class="flex justify-end gap-2 mt-2">
                <button
                  type="button"
                  class="timeline-reply-cancel btn btn-ghost btn-sm"
                  phx-click="cancel_reply"
                >
                  {gettext("Cancel")}
                </button>
                <button
                  type="submit"
                  class="timeline-reply-submit btn btn-primary btn-sm"
                  phx-disable-with={gettext("Sending...")}
                >
                  {gettext("Reply")}
                </button>
              </div>
            </.form>
          </div>
        </div>

        <%!-- Local article from followed user --%>
        <div :if={item.source == :local} class="card-body p-4">
          <div class="flex items-center gap-3 mb-2">
            <.avatar user={item.article.user} size={36} />
            <div class="flex-1 min-w-0">
              <.author_link
                user={item.article.user}
                class="font-bold text-sm truncate link link-hover"
              >
                {display_name(item.article.user)}
              </.author_link>
              <div class="text-xs text-base-content/60">
                <.icon
                  name="hero-home-solid"
                  class="size-3.5 text-gray-400"
                  title={gettext("Local")}
                />
              </div>
            </div>
            <div class="flex flex-col items-end flex-shrink-0">
              <time
                class="text-xs text-base-content/70"
                datetime={datetime_attr(article_datetime(item.article))}
              >
                {format_datetime(article_datetime(item.article))}
              </time>
              <span class="badge badge-xs badge-accent">{gettext("Article")}</span>
            </div>
          </div>

          <.link
            navigate={~p"/articles/#{item.article.slug}"}
            class="timeline-item-title font-semibold text-lg mb-1 link link-hover break-words"
          >
            {item.article.title}
          </.link>

          <p class="timeline-item-body text-sm text-base-content/80 line-clamp-3 break-words">
            {digest(item.article.body)}
          </p>

          <div
            :if={item.article.article_images != []}
            class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2"
          >
            <img
              :for={img <- item.article.article_images}
              src={Baudrate.Content.ArticleImageStorage.image_url(img.filename)}
              width={img.width}
              height={img.height}
              class="w-full aspect-square object-cover rounded-lg border border-base-300"
              loading="lazy"
              alt={item.article.title}
            />
          </div>

          <div class="flex items-center gap-3 mt-2">
            <div :if={item.article.boards != []} class="flex gap-1">
              <span :for={board <- item.article.boards} class="badge badge-outline badge-sm">
                {board.name}
              </span>
            </div>
            <.link
              :if={item.comment_count > 0}
              navigate={~p"/articles/#{item.article.slug}"}
              class="timeline-item-comments inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-base-content"
              aria-label={ngettext("1 comment", "%{count} comments", item.comment_count)}
            >
              <.icon name="hero-chat-bubble-left-ellipsis" class="size-4" />
              {item.comment_count}
            </.link>
            <%!-- Like button (not own) --%>
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  item.article.user_id,
                  MapSet.member?(@article_liked_ids, item.article.id)
                )
              }
              phx-click="toggle_article_like"
              phx-value-id={item.article.id}
              class="timeline-item-like inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-error cursor-pointer"
              aria-pressed={to_string(MapSet.member?(@article_liked_ids, item.article.id))}
              aria-label={
                ngettext(
                  "Like, %{count} like",
                  "Like, %{count} likes",
                  Map.get(@article_like_counts, item.article.id, 0),
                  count: Map.get(@article_like_counts, item.article.id, 0)
                )
              }
            >
              <.icon
                name={
                  if MapSet.member?(@article_liked_ids, item.article.id),
                    do: "hero-heart-solid",
                    else: "hero-heart"
                }
                class={[
                  "size-4",
                  MapSet.member?(@article_liked_ids, item.article.id) && "text-error"
                ]}
              />
              <span :if={Map.get(@article_like_counts, item.article.id, 0) > 0}>
                {Map.get(@article_like_counts, item.article.id, 0)}
              </span>
            </button>
            <%!-- Boost button (not own) --%>
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  item.article.user_id,
                  MapSet.member?(@article_boosted_ids, item.article.id)
                )
              }
              phx-click="toggle_article_boost"
              phx-value-id={item.article.id}
              class="timeline-item-boost inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-success cursor-pointer"
              aria-pressed={to_string(MapSet.member?(@article_boosted_ids, item.article.id))}
              aria-label={
                ngettext(
                  "Boost, %{count} boost",
                  "Boost, %{count} boosts",
                  Map.get(@article_boost_counts, item.article.id, 0),
                  count: Map.get(@article_boost_counts, item.article.id, 0)
                )
              }
            >
              <.icon
                name={
                  if MapSet.member?(@article_boosted_ids, item.article.id),
                    do: "hero-arrow-path-rounded-square-solid",
                    else: "hero-arrow-path-rounded-square"
                }
                class={[
                  "size-4",
                  MapSet.member?(@article_boosted_ids, item.article.id) && "text-success"
                ]}
              />
              <span :if={Map.get(@article_boost_counts, item.article.id, 0) > 0}>
                {Map.get(@article_boost_counts, item.article.id, 0)}
              </span>
            </button>
          </div>
        </div>

        <%!-- Comment on user's article or participated thread (local user) --%>
        <div :if={item.source == :local_comment && item.comment.user} class="card-body p-4">
          <div class="flex items-center gap-3 mb-2">
            <.avatar user={item.comment.user} size={36} />
            <div class="flex-1 min-w-0">
              <.author_link
                user={item.comment.user}
                class="font-bold text-sm truncate link link-hover"
              >
                {display_name(item.comment.user)}
              </.author_link>
              <div class="text-xs text-base-content/60">
                <.icon
                  name="hero-home-solid"
                  class="size-3.5 text-gray-400"
                  title={gettext("Local")}
                />
              </div>
            </div>
            <div class="flex flex-col items-end flex-shrink-0">
              <time
                class="text-xs text-base-content/70"
                datetime={datetime_attr(item.comment.inserted_at)}
              >
                {format_datetime(item.comment.inserted_at)}
              </time>
              <span class="badge badge-xs badge-secondary">{gettext("Comment")}</span>
            </div>
          </div>

          <div class="text-sm text-base-content/60 mb-1">
            {gettext("commented on")}
            <.link
              navigate={~p"/articles/#{item.comment.article.slug}"}
              class="timeline-item-comment-article link link-hover font-semibold break-words"
            >
              {item.comment.article.title}
            </.link>
          </div>

          <p class="timeline-item-body text-sm text-base-content/80 line-clamp-3 break-words">
            {digest(item.comment.body)}
          </p>

          <div
            :if={item.comment.user_id != @current_user.id}
            class="flex items-center gap-3 mt-2"
          >
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  item.comment.user_id,
                  MapSet.member?(@comment_liked_ids, item.comment.id)
                )
              }
              phx-click="toggle_comment_like"
              phx-value-id={item.comment.id}
              class="timeline-item-like inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-error cursor-pointer"
              aria-pressed={to_string(MapSet.member?(@comment_liked_ids, item.comment.id))}
              aria-label={
                ngettext(
                  "Like, %{count} like",
                  "Like, %{count} likes",
                  Map.get(@comment_like_counts, item.comment.id, 0),
                  count: Map.get(@comment_like_counts, item.comment.id, 0)
                )
              }
            >
              <.icon
                name={
                  if MapSet.member?(@comment_liked_ids, item.comment.id),
                    do: "hero-heart-solid",
                    else: "hero-heart"
                }
                class={[
                  "size-4",
                  MapSet.member?(@comment_liked_ids, item.comment.id) && "text-error"
                ]}
              />
              <span :if={Map.get(@comment_like_counts, item.comment.id, 0) > 0}>
                {Map.get(@comment_like_counts, item.comment.id, 0)}
              </span>
            </button>
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  item.comment.user_id,
                  MapSet.member?(@comment_boosted_ids, item.comment.id)
                )
              }
              phx-click="toggle_comment_boost"
              phx-value-id={item.comment.id}
              class="timeline-item-boost inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-success cursor-pointer"
              aria-pressed={to_string(MapSet.member?(@comment_boosted_ids, item.comment.id))}
              aria-label={
                ngettext(
                  "Boost, %{count} boost",
                  "Boost, %{count} boosts",
                  Map.get(@comment_boost_counts, item.comment.id, 0),
                  count: Map.get(@comment_boost_counts, item.comment.id, 0)
                )
              }
            >
              <.icon
                name={
                  if MapSet.member?(@comment_boosted_ids, item.comment.id),
                    do: "hero-arrow-path-rounded-square-solid",
                    else: "hero-arrow-path-rounded-square"
                }
                class={[
                  "size-4",
                  MapSet.member?(@comment_boosted_ids, item.comment.id) && "text-success"
                ]}
              />
              <span :if={Map.get(@comment_boost_counts, item.comment.id, 0) > 0}>
                {Map.get(@comment_boost_counts, item.comment.id, 0)}
              </span>
            </button>
            <button
              :if={
                !moved_account?(@current_user) and
                  item.comment.visibility in ["public", "unlisted"]
              }
              phx-click="toggle_forward_search"
              phx-value-id={item.comment.id}
              phx-value-type="comment"
              class="timeline-item-forward inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-primary cursor-pointer"
              aria-label={gettext("Forward to Board")}
              title={gettext("Forward to Board")}
            >
              <.icon name="hero-arrow-uturn-right" class="size-4" />
            </button>
          </div>

          <%!-- Comment forward search panel --%>
          <div
            :if={@forwarding_item_id == item.comment.id and @forwarding_item_type == "comment"}
            id={"forward-search-comment-#{item.comment.id}"}
            class="flex items-center gap-2 text-sm mt-2"
          >
            <div class="w-full max-w-md">
              <.form
                for={%{}}
                id={"timeline-comment-forward-form-#{item.comment.id}"}
                phx-change="search_forward_board"
                class="flex items-center gap-2"
              >
                <input
                  type="text"
                  name="query"
                  value={@forward_search_query}
                  placeholder={gettext("Search boards...")}
                  phx-debounce="300"
                  autocomplete="off"
                  class="input input-sm input-bordered w-full"
                  aria-label={gettext("Search boards")}
                />
                <button
                  type="button"
                  phx-click="cancel_forward_search"
                  class="btn btn-sm btn-ghost"
                  aria-label={gettext("Cancel")}
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </.form>
              <p
                id={"forward-board-results-status-comment-#{item.comment.id}"}
                class="timeline-forward-results-status sr-only"
                role="status"
              >
                {if String.length(String.trim(@forward_search_query)) >= 2,
                  do:
                    ngettext(
                      "%{count} board found",
                      "%{count} boards found",
                      length(@forward_search_results),
                      count: length(@forward_search_results)
                    ),
                  else: ""}
              </p>
              <ul
                :if={@forward_search_results != []}
                id={"forward-board-results-comment-#{item.comment.id}"}
                aria-label={gettext("Matching boards")}
                class="timeline-forward-results menu bg-base-200 rounded-box mt-1 shadow-lg max-h-48 overflow-y-auto"
              >
                <li :for={board <- @forward_search_results}>
                  <button
                    type="button"
                    class="timeline-forward-result"
                    phx-click="forward_to_board"
                    phx-value-board-id={board.id}
                  >
                    {board.name}
                  </button>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <%!-- Comment on user's article or participated thread (remote actor) --%>
        <div
          :if={item.source == :local_comment && !item.comment.user && item.comment.remote_actor}
          class="card-body p-4"
        >
          <div class="flex items-center gap-3 mb-2">
            <div
              class="avatar"
              role="img"
              aria-label={
                item.comment.remote_actor.display_name ||
                  item.comment.remote_actor.username
              }
            >
              <div class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center">
                <img
                  :if={item.comment.remote_actor.avatar_url}
                  src={Baudrate.Media.Proxy.url(item.comment.remote_actor.avatar_url)}
                  alt=""
                  class="rounded-full"
                />
                <.icon
                  :if={!item.comment.remote_actor.avatar_url}
                  name="hero-user-circle"
                  class="size-7 opacity-50"
                />
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <a
                href={remote_actor_profile_url(item.comment.remote_actor)}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="link link-hover"
              >
                <div class="font-bold text-sm truncate">
                  {item.comment.remote_actor.display_name || item.comment.remote_actor.username}
                </div>
                <div class="text-xs text-base-content/60 truncate">
                  @{item.comment.remote_actor.username}@{item.comment.remote_actor.domain}
                </div>
              </a>
            </div>
            <div class="flex flex-col items-end flex-shrink-0">
              <time
                class="text-xs text-base-content/70"
                datetime={datetime_attr(item.comment.inserted_at)}
              >
                {format_datetime(item.comment.inserted_at)}
              </time>
              <div class="flex gap-1">
                <span class="badge badge-xs badge-secondary">{gettext("Comment")}</span>
                <span class="badge badge-xs badge-accent">{gettext("Fediverse")}</span>
              </div>
            </div>
          </div>

          <div class="text-sm text-base-content/60 mb-1">
            {gettext("commented on")}
            <.link
              navigate={~p"/articles/#{item.comment.article.slug}"}
              class="timeline-item-comment-article link link-hover font-semibold break-words"
            >
              {item.comment.article.title}
            </.link>
          </div>

          <p class="timeline-item-body text-sm text-base-content/80 line-clamp-3 break-words">
            {digest(item.comment.body)}
          </p>

          <div class="flex items-center gap-3 mt-2">
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  item.comment.user_id,
                  MapSet.member?(@comment_liked_ids, item.comment.id)
                )
              }
              phx-click="toggle_comment_like"
              phx-value-id={item.comment.id}
              class="timeline-item-like inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-error cursor-pointer"
              aria-pressed={to_string(MapSet.member?(@comment_liked_ids, item.comment.id))}
              aria-label={
                ngettext(
                  "Like, %{count} like",
                  "Like, %{count} likes",
                  Map.get(@comment_like_counts, item.comment.id, 0),
                  count: Map.get(@comment_like_counts, item.comment.id, 0)
                )
              }
            >
              <.icon
                name={
                  if MapSet.member?(@comment_liked_ids, item.comment.id),
                    do: "hero-heart-solid",
                    else: "hero-heart"
                }
                class={[
                  "size-4",
                  MapSet.member?(@comment_liked_ids, item.comment.id) && "text-error"
                ]}
              />
              <span :if={Map.get(@comment_like_counts, item.comment.id, 0) > 0}>
                {Map.get(@comment_like_counts, item.comment.id, 0)}
              </span>
            </button>
            <button
              :if={
                interaction_toggle?(
                  @current_user,
                  item.comment.user_id,
                  MapSet.member?(@comment_boosted_ids, item.comment.id)
                )
              }
              phx-click="toggle_comment_boost"
              phx-value-id={item.comment.id}
              class="timeline-item-boost inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-success cursor-pointer"
              aria-pressed={to_string(MapSet.member?(@comment_boosted_ids, item.comment.id))}
              aria-label={
                ngettext(
                  "Boost, %{count} boost",
                  "Boost, %{count} boosts",
                  Map.get(@comment_boost_counts, item.comment.id, 0),
                  count: Map.get(@comment_boost_counts, item.comment.id, 0)
                )
              }
            >
              <.icon
                name={
                  if MapSet.member?(@comment_boosted_ids, item.comment.id),
                    do: "hero-arrow-path-rounded-square-solid",
                    else: "hero-arrow-path-rounded-square"
                }
                class={[
                  "size-4",
                  MapSet.member?(@comment_boosted_ids, item.comment.id) && "text-success"
                ]}
              />
              <span :if={Map.get(@comment_boost_counts, item.comment.id, 0) > 0}>
                {Map.get(@comment_boost_counts, item.comment.id, 0)}
              </span>
            </button>
            <button
              :if={
                !moved_account?(@current_user) and
                  item.comment.visibility in ["public", "unlisted"]
              }
              phx-click="toggle_forward_search"
              phx-value-id={item.comment.id}
              phx-value-type="comment"
              class="timeline-item-forward inline-flex items-center gap-1 text-xs text-base-content/60 hover:text-primary cursor-pointer"
              aria-label={gettext("Forward to Board")}
              title={gettext("Forward to Board")}
            >
              <.icon name="hero-arrow-uturn-right" class="size-4" />
            </button>
          </div>

          <%!-- Comment forward search panel (remote) --%>
          <div
            :if={@forwarding_item_id == item.comment.id and @forwarding_item_type == "comment"}
            id={"forward-search-rcomment-#{item.comment.id}"}
            class="flex items-center gap-2 text-sm mt-2"
          >
            <div class="w-full max-w-md">
              <.form
                for={%{}}
                id={"timeline-rcomment-forward-form-#{item.comment.id}"}
                phx-change="search_forward_board"
                class="flex items-center gap-2"
              >
                <input
                  type="text"
                  name="query"
                  value={@forward_search_query}
                  placeholder={gettext("Search boards...")}
                  phx-debounce="300"
                  autocomplete="off"
                  class="input input-sm input-bordered w-full"
                  aria-label={gettext("Search boards")}
                />
                <button
                  type="button"
                  phx-click="cancel_forward_search"
                  class="btn btn-sm btn-ghost"
                  aria-label={gettext("Cancel")}
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </.form>
              <p
                id={"forward-board-results-status-rcomment-#{item.comment.id}"}
                class="timeline-forward-results-status sr-only"
                role="status"
              >
                {if String.length(String.trim(@forward_search_query)) >= 2,
                  do:
                    ngettext(
                      "%{count} board found",
                      "%{count} boards found",
                      length(@forward_search_results),
                      count: length(@forward_search_results)
                    ),
                  else: ""}
              </p>
              <ul
                :if={@forward_search_results != []}
                id={"forward-board-results-rcomment-#{item.comment.id}"}
                aria-label={gettext("Matching boards")}
                class="timeline-forward-results menu bg-base-200 rounded-box mt-1 shadow-lg max-h-48 overflow-y-auto"
              >
                <li :for={board <- @forward_search_results}>
                  <button
                    type="button"
                    class="timeline-forward-result"
                    phx-click="forward_to_board"
                    phx-value-board-id={board.id}
                  >
                    {board.name}
                  </button>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </article>
    </div>

    <.pagination
      :if={@items != []}
      page={@page}
      total_pages={@total_pages}
      path={~p"/timeline"}
    />
  </div>

  <aside
    id="profile-sidebar"
    class="timeline-profile-sidebar hidden lg:block"
    aria-label={gettext("Profile")}
  >
    <div class="card bg-base-200 shadow-sm sticky top-24">
      <div class="card-body p-4 items-center text-center">
        <.avatar user={@current_user} size={48} />
        <h2 id="timeline-profile-name" class="timeline-profile-name font-bold truncate max-w-full">
          {display_name(@current_user)}
        </h2>
        <div
          :if={@current_user.display_name}
          class="text-sm text-base-content/70 truncate max-w-full"
        >
          @{@current_user.username}
        </div>
        <span class="badge badge-outline">{translate_role(@current_user.role.name)}</span>
        <p class="text-sm text-base-content/70">
          {gettext("Member since")}
          <time datetime={format_date(@current_user.inserted_at)}>
            {format_date(@current_user.inserted_at)}
          </time>
        </p>

        <div id="timeline-profile-stats" class="stats stats-vertical shadow w-full mt-2">
          <.link
            id="timeline-profile-articles-link"
            navigate={~p"/users/#{@current_user.username}/articles"}
            class="timeline-profile-stat stat py-2 hover:bg-base-200 transition-colors cursor-pointer"
          >
            <div class="stat-title">{gettext("Articles")}</div>
            <div class="timeline-profile-article-count stat-value text-lg">{@article_count}</div>
          </.link>
          <.link
            id="timeline-profile-comments-link"
            navigate={~p"/users/#{@current_user.username}/comments"}
            class="timeline-profile-stat stat py-2 hover:bg-base-200 transition-colors cursor-pointer"
          >
            <div class="stat-title">{gettext("Comments")}</div>
            <div class="timeline-profile-comment-count stat-value text-lg">{@comment_count}</div>
          </.link>
        </div>

        <.link
          id="timeline-profile-link"
          navigate={~p"/profile"}
          class="timeline-profile-link btn btn-sm btn-outline w-full mt-2"
        >
          <.icon name="hero-user-circle" class="size-4" />
          {gettext("Profile")}
        </.link>
      </div>
    </div>
  </aside>
</div>

<.report_modal
  :if={@show_report_modal}
  show={@show_report_modal}
  target_type={@report_target_type}
  target_label={@report_target_label}
  on_close="close_report_modal"
  on_submit="submit_report"
/>
