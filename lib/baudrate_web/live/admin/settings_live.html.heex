<div id="admin-settings-page" class="admin-settings-page space-y-6">
  <h1 id="admin-settings-heading" class="admin-settings-heading text-2xl font-bold">
    {gettext("Admin Settings")}
  </h1>

  <section
    id="admin-system-info"
    class="admin-system-info card bg-base-200 shadow-sm"
    aria-labelledby="admin-system-info-heading"
  >
    <div class="card-body">
      <h2 id="admin-system-info-heading" class="admin-system-info-heading card-title text-lg">
        {gettext("System Information")}
      </h2>
      <dl class="admin-system-info-list grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 gap-y-1 text-sm">
        <dt class="admin-system-info-label opacity-70">{gettext("Baudrate version")}</dt>
        <dd id="admin-system-info-baudrate" class="admin-system-info-value font-mono break-all">
          v{@system_info.baudrate}
        </dd>
        <dt class="admin-system-info-label opacity-70">{gettext("Elixir version")}</dt>
        <dd id="admin-system-info-elixir" class="admin-system-info-value font-mono break-all">
          {@system_info.elixir}
        </dd>
        <dt class="admin-system-info-label opacity-70">{gettext("Erlang/OTP version")}</dt>
        <dd id="admin-system-info-otp" class="admin-system-info-value font-mono break-all">
          {gettext("OTP %{release} (ERTS %{erts})",
            release: @system_info.otp,
            erts: @system_info.erts
          )}
        </dd>
      </dl>
    </div>
  </section>

  <div id="settings-card" class="admin-settings-card card bg-base-200 shadow-sm">
    <div class="card-body">
      <.form for={@form} id="settings-form" phx-change="validate" phx-submit="save">
        <.input field={@form[:site_name]} type="text" label={gettext("Site Name")} required />
        <.input
          field={@form[:timezone]}
          type="select"
          label={gettext("Timezone")}
          options={@timezone_options}
        />
        <.input
          field={@form[:registration_mode]}
          type="select"
          label={gettext("Registration Mode")}
          options={[
            {gettext("Open"), "open"},
            {gettext("Approval Required"), "approval_required"},
            {gettext("Invite Only"), "invite_only"}
          ]}
        />
        <.input
          field={@form[:ap_federation_enabled]}
          type="select"
          label={gettext("Federation")}
          options={[
            {gettext("Enabled"), "true"},
            {gettext("Disabled"), "false"}
          ]}
        />
        <.input
          field={@form[:ap_federation_mode]}
          type="select"
          label={gettext("Federation Mode")}
          options={[
            {gettext("Blocklist (block specific domains)"), "blocklist"},
            {gettext("Allowlist (allow only specific domains)"), "allowlist"}
          ]}
        />
        <p id="settings-domain-blocks-hint" class="settings-hint text-sm opacity-70">
          {gettext("Blocked domains are managed on the Federation page, with a reason.")}
          <.link
            id="settings-domain-blocks-link"
            navigate={~p"/admin/federation"}
            class="settings-hint-link link link-primary"
          >
            {gettext("Go to Federation")}
          </.link>
        </p>
        <.input
          field={@form[:ap_domain_allowlist]}
          type="textarea"
          label={gettext("Allowed Domains (federation)")}
          placeholder={gettext("trusted.example, friend.example")}
        />
        <p class="text-sm opacity-70">
          {gettext(
            "Comma-separated list of domains to allow. Only used in allowlist mode. When empty, all domains are blocked."
          )}
        </p>
        <.input
          field={@form[:ap_authorized_fetch]}
          type="select"
          label={gettext("Authorized Fetch (Secure Mode)")}
          options={[
            {gettext("Disabled (public GETs allowed)"), "false"},
            {gettext("Enabled (require HTTP signatures on GETs)"), "true"}
          ]}
        />
        <p class="text-sm opacity-70">
          {gettext(
            "When enabled, unsigned GET requests to ActivityPub endpoints return 401. WebFinger and NodeInfo remain public."
          )}
        </p>
        <.input
          field={@form[:ap_blocklist_audit_url]}
          type="text"
          label={gettext("Blocklist Audit URL")}
          placeholder={gettext("https://example.com/blocklist.csv")}
        />
        <p class="text-sm opacity-70">
          {gettext(
            "URL to an external domain blocklist (CSV or JSON). Used by the federation dashboard audit feature."
          )}
        </p>
        <h2 id="admin-settings-theme-heading" class="admin-settings-theme-heading card-title mt-6">
          {gettext("Theme")}
        </h2>
        <.input
          field={@form[:theme_light]}
          type="select"
          label={gettext("Light Theme")}
          options={@light_theme_options}
        />
        <.input
          field={@form[:theme_dark]}
          type="select"
          label={gettext("Dark Theme")}
          options={@dark_theme_options}
        />
        <div class="mt-4">
          <.button variant="primary" type="submit" phx-disable-with={gettext("Saving...")}>
            {gettext("Save")}
          </.button>
        </div>
      </.form>
    </div>
  </div>

  <div id="vapid-card" class="admin-settings-card card bg-base-200 shadow-sm">
    <div class="card-body">
      <h2 id="admin-settings-vapid-heading" class="admin-settings-vapid-heading card-title">
        {gettext("Web Push Notifications (VAPID)")}
      </h2>
      <p class="text-sm text-base-content/70">
        {gettext("VAPID keys are required for sending browser push notifications.")}
      </p>
      <%= if @vapid_configured do %>
        <div id="admin-settings-vapid-status" class="admin-settings-vapid-status space-y-2">
          <div class="flex items-center gap-2">
            <span class="badge badge-success">{gettext("Configured")}</span>
          </div>
          <div>
            <div class="text-sm text-base-content/70">{gettext("Public Key")}</div>
            <code
              id="admin-settings-vapid-public-key"
              class="admin-settings-vapid-public-key text-xs break-all"
            >{@vapid_public_key}</code>
          </div>
        </div>
      <% else %>
        <button
          id="admin-settings-generate-vapid"
          class="admin-settings-generate-vapid btn btn-primary"
          type="button"
          phx-click="generate_vapid_keys"
          data-confirm={
            gettext(
              "This will generate new VAPID keys. Existing push subscriptions will stop working. Continue?"
            )
          }
        >
          {gettext("Generate VAPID Keys")}
        </button>
      <% end %>
    </div>
  </div>

  <div id="eua-card" class="admin-settings-card card bg-base-200 shadow-sm">
    <div class="card-body">
      <h2 id="admin-settings-eua-heading" class="admin-settings-eua-heading card-title">
        {gettext("End User Agreement")}
      </h2>
      <p class="text-sm text-base-content/70">
        {gettext(
          "Optional site-specific terms shown during registration. Supports Markdown formatting."
        )}
      </p>
      <.form for={@eua_form} id="eua-form" phx-change="validate_eua" phx-submit="save_eua">
        <.input
          field={@eua_form[:eua]}
          type="textarea"
          label={gettext("End User Agreement (Markdown)")}
          toolbar
          rows="8"
          placeholder={gettext("Enter your site-specific terms here...")}
        />
        <%!-- Must go through `.input`, not a bare <input>: the form re-renders on
        every phx-change, and a checkbox with no `checked` bound to the form is
        patched straight back to unchecked. Its hidden "false" companion is also
        what makes an unchecked box submit anything at all. --%>
        <.input
          field={@eua_form[:republish]}
          type="checkbox"
          id="eua-republish"
          label={
            gettext(
              "Require every member to accept again. Leave this off for a typo or a reworded sentence."
            )
          }
        />
        <p id="eua-version-note" class="eua-version-note text-sm opacity-70">
          {gettext("Members are currently being asked to accept version %{version}.",
            version: @terms_version
          )}
        </p>
        <div class="mt-4">
          <.button variant="primary" type="submit" phx-disable-with={gettext("Saving...")}>
            {gettext("Save Agreement")}
          </.button>
        </div>
      </.form>
    </div>
  </div>

  <section
    id="rules-card"
    class="admin-settings-card card bg-base-200 shadow-sm"
    aria-labelledby="admin-settings-rules-heading"
  >
    <div class="card-body">
      <h2 id="admin-settings-rules-heading" class="admin-settings-rules-heading card-title">
        {gettext("Site Rules")}
      </h2>
      <p class="admin-settings-rules-hint text-sm text-base-content/70">
        {gettext(
          "The rules are a numbered list rather than one document, so a report can point at the rule it says was broken."
        )}
      </p>
      <div class="card-actions">
        <.link
          id="admin-settings-rules-link"
          navigate={~p"/admin/rules"}
          class="admin-settings-rules-link btn btn-sm"
        >
          {gettext("Edit Site Rules")}
        </.link>
      </div>
    </div>
  </section>

  <div id="privacy-card" class="admin-settings-card card bg-base-200 shadow-sm">
    <div class="card-body">
      <h2 id="admin-settings-privacy-heading" class="admin-settings-privacy-heading card-title">
        {gettext("Privacy Policy")}
      </h2>
      <p class="admin-settings-privacy-hint text-sm text-base-content/70">
        {gettext(
          "What this site records about its visitors and what happens to it, published at /privacy and linked from the footer. Supports Markdown formatting."
        )}
      </p>
      <.form
        for={@privacy_form}
        id="privacy-form"
        phx-change="validate_privacy"
        phx-submit="save_privacy"
      >
        <.input
          field={@privacy_form[:text]}
          type="textarea"
          label={gettext("Privacy Policy (Markdown)")}
          toolbar
          rows="8"
          placeholder={gettext("Describe what your site records and why...")}
        />
        <div class="mt-4">
          <.button variant="primary" type="submit" phx-disable-with={gettext("Saving...")}>
            {gettext("Save Privacy Policy")}
          </.button>
        </div>
      </.form>
    </div>
  </div>
</div>
