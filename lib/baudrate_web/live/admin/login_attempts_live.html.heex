<div id="admin-login-attempts-page" class="admin-login-attempts-page space-y-6">
  <h1 id="admin-login-attempts-heading" class="admin-login-attempts-heading text-2xl font-bold">
    {gettext("Login Attempts")}
  </h1>

  <form
    id="admin-login-attempts-search-form"
    class="admin-login-attempts-search-form flex gap-2"
    phx-submit="search"
  >
    <input
      id="admin-login-attempts-username-input"
      class="admin-login-attempts-username-input input input-bordered input-sm w-64"
      type="text"
      name="username"
      value={@username_filter}
      placeholder={gettext("Filter by username...")}
      aria-label={gettext("Filter by username")}
    />
    <button
      id="admin-login-attempts-search-submit"
      class="admin-login-attempts-search-submit btn btn-sm btn-primary"
      type="submit"
      phx-disable-with={gettext("Searching...")}
    >
      {gettext("Search")}
    </button>
    <.link
      :if={@username_filter != ""}
      id="admin-login-attempts-clear-link"
      class="admin-login-attempts-clear-link btn btn-sm btn-ghost"
      patch={~p"/admin/login-attempts"}
    >
      {gettext("Clear")}
    </.link>
  </form>

  <div
    :if={@attempts == []}
    id="admin-login-attempts-empty"
    class="admin-login-attempts-empty text-base-content/70 text-center py-8"
  >
    {gettext("No login attempts recorded.")}
  </div>

  <div
    :if={@attempts != []}
    id="admin-login-attempts-table-container"
    class="admin-login-attempts-table-container overflow-x-auto"
    data-focus-target
  >
    <table
      id="admin-login-attempts-table"
      class="admin-login-attempts-table table table-zebra w-full"
      aria-labelledby="admin-login-attempts-heading"
    >
      <thead>
        <tr>
          <th scope="col">{gettext("Date")}</th>
          <th scope="col">{gettext("Username")}</th>
          <th scope="col">{gettext("IP Address")}</th>
          <th scope="col">{gettext("Check")}</th>
          <th scope="col">{gettext("Result")}</th>
        </tr>
      </thead>
      <tbody>
        <tr
          :for={attempt <- @attempts}
          id={"admin-login-attempts-row-#{attempt.id}"}
          class="admin-login-attempts-row"
        >
          <td class="whitespace-nowrap text-sm">
            <time datetime={datetime_attr(attempt.inserted_at)}>
              {format_datetime(attempt.inserted_at, "%Y-%m-%d %H:%M:%S")}
            </time>
          </td>
          <td>{attempt.username}</td>
          <td class="text-sm font-mono">{attempt.ip_address || "—"}</td>
          <td class="admin-login-attempts-factor text-sm">{factor_label(attempt.factor)}</td>
          <td>
            <span :if={attempt.success} class="badge badge-success badge-sm">
              {gettext("Success")}
            </span>
            <span :if={!attempt.success} class="badge badge-error badge-sm">
              {gettext("Failed")}
            </span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <.pagination
    :if={@attempts != []}
    page={@page}
    total_pages={@total_pages}
    path={~p"/admin/login-attempts"}
    params={if @username_filter != "", do: %{"username" => @username_filter}, else: %{}}
  />
</div>
