<div id="admin-bots-page" class="admin-bots-page space-y-6">
  <div class="flex items-center justify-between">
    <h1 id="bots-heading" class="admin-bots-title text-2xl font-bold">
      {gettext("Manage Bots")}
    </h1>
    <button
      :if={!@show_form}
      id="admin-bots-new-btn"
      phx-click="new"
      class="admin-bots-new-btn btn btn-primary btn-sm"
    >
      {gettext("New Bot")}
    </button>
  </div>

  <%!-- Bot form (create / edit) --%>
  <div :if={@show_form} id="bot-form-card" class="admin-bots-form-card card bg-base-200 shadow-md">
    <div class="card-body">
      <h2 id="admin-bots-form-title" class="admin-bots-form-title card-title">
        {if @editing_bot, do: gettext("Edit Bot"), else: gettext("New Bot")}
      </h2>

      <.form id="admin-bots-form" for={@form} phx-change="validate" phx-submit="save">
        <%= if @editing_bot do %>
          <div class="fieldset mb-2">
            <label>
              <span class="label mb-1">{gettext("Username")}</span>
              <input
                id="admin-bots-username-display"
                type="text"
                value={@editing_bot.user.username}
                class="admin-bots-username-display w-full input"
                disabled
              />
            </label>
            <p class="text-sm opacity-70 mt-1">
              {gettext("Username cannot be changed after creation.")}
            </p>
          </div>
        <% else %>
          <.input field={@form[:username]} type="text" label={gettext("Username")} required />
          <.input field={@form[:display_name]} type="text" label={gettext("Display Name")} />
        <% end %>

        <%!-- Bio --%>
        <div class="fieldset mb-2">
          <label>
            <span class="label mb-1">{gettext("Bio")}</span>
            <textarea
              id="admin-bots-bio-input"
              name="bot[bio]"
              class="admin-bots-bio-input textarea textarea-bordered w-full"
              rows="3"
              maxlength="500"
              placeholder={gettext("Bot description or disclaimer (max 500 characters)")}
              aria-label={gettext("Bio")}
            >{bio_value(@form, @editing_bot)}</textarea>
          </label>
          <p class="text-sm opacity-70 mt-1">
            {gettext("Defaults to the feed URL if left empty.")}
          </p>
        </div>

        <%!-- Profile Fields (edit only) --%>
        <%= if @editing_bot do %>
          <div class="fieldset mb-2">
            <span class="label mb-1">{gettext("Profile Fields")}</span>
            <p class="text-sm opacity-70 mb-2">
              {gettext("Add up to 4 custom fields (e.g. disclaimer, website).")}
            </p>
            <div id="bot-profile-fields" class="space-y-2" phx-update="ignore">
              <div
                :for={{field, i} <- Enum.with_index(@editing_bot_profile_fields)}
                id={"admin-bots-profile-field-#{i}"}
                class="admin-bots-profile-field flex flex-wrap gap-2"
              >
                <input
                  id={"admin-bots-profile-field-name-#{i}"}
                  type="text"
                  name={"bot[profile_fields][#{i}][name]"}
                  value={field["name"]}
                  placeholder={gettext("Label")}
                  maxlength="255"
                  class="admin-bots-profile-field-name input input-bordered input-sm w-36"
                  aria-label={gettext("Field %{n} label", n: i + 1)}
                />
                <input
                  id={"admin-bots-profile-field-value-#{i}"}
                  type="text"
                  name={"bot[profile_fields][#{i}][value]"}
                  value={field["value"]}
                  placeholder={gettext("Content")}
                  maxlength="2048"
                  class="admin-bots-profile-field-value input input-bordered input-sm flex-1"
                  aria-label={gettext("Field %{n} content", n: i + 1)}
                />
              </div>
            </div>
          </div>
        <% end %>

        <.input
          field={@form[:feed_url]}
          type="url"
          label={gettext("Feed URL")}
          placeholder={gettext("https://example.com/feed.xml")}
          required
        />

        <fieldset id="admin-bots-target-boards" class="admin-bots-target-boards fieldset mb-2">
          <legend
            id="admin-bots-target-boards-legend"
            class="admin-bots-target-boards-legend label mb-1"
          >
            {gettext("Target Boards")}
          </legend>
          <div class="flex flex-wrap gap-2">
            <%= for board <- @boards do %>
              <label class="admin-bots-board-option flex items-center gap-2 cursor-pointer">
                <input
                  id={"admin-bots-board-checkbox-#{board.id}"}
                  type="checkbox"
                  name="bot[board_ids][]"
                  value={board.id}
                  checked={board.id in (@form[:board_ids].value || [])}
                  class="admin-bots-board-checkbox checkbox checkbox-sm"
                />
                <span class="text-sm">{board.name}</span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <.input
          field={@form[:fetch_interval_minutes]}
          type="number"
          label={gettext("Fetch Interval (minutes)")}
          min="1"
          max="1440"
        />

        <fieldset id="admin-bots-what-posts" class="admin-bots-what-posts fieldset mb-2">
          <legend
            id="admin-bots-what-posts-legend"
            class="admin-bots-what-posts-legend label mb-1"
          >
            {gettext("What this bot posts")}
          </legend>
          <p
            id="admin-bots-patterns-help"
            class="admin-bots-patterns-help text-sm opacity-70 mb-2"
          >
            {gettext(
              "One pattern per line, matched against each entry's title and text. A line is a whole word or phrase; put * in it to match part of a word (*rust* also matches “trusted”)."
            )}
          </p>
          <.input
            field={@form[:include_text]}
            type="textarea"
            rows="3"
            label={gettext("Post only entries matching one of")}
            placeholder={gettext("Leave empty to post every entry")}
          />
          <.input
            field={@form[:exclude_text]}
            type="textarea"
            rows="3"
            label={gettext("Never post entries matching")}
          />
          <.input
            field={@form[:first_fetch_limit]}
            type="number"
            label={gettext("Entries to post on the first fetch")}
            min="0"
            max={Bot.max_first_fetch_limit()}
          />
          <p
            id="admin-bots-first-fetch-help"
            class="admin-bots-first-fetch-help text-sm opacity-70"
          >
            {gettext(
              "The first fetch posts only this many of the newest entries; the rest of the feed's backlog is never posted. Changing the feed URL starts over."
            )}
          </p>
        </fieldset>

        <div class="flex gap-2 mt-4">
          <button
            id="admin-bots-form-save"
            type="submit"
            class="admin-bots-form-save btn btn-primary btn-sm"
          >
            {if @editing_bot, do: gettext("Save Changes"), else: gettext("Create Bot")}
          </button>
          <button
            id="admin-bots-form-cancel"
            type="button"
            phx-click="cancel"
            class="admin-bots-form-cancel btn btn-ghost btn-sm"
          >
            {gettext("Cancel")}
          </button>
        </div>
      </.form>
    </div>
  </div>

  <%!-- Bots table --%>
  <section id="bots-section" aria-labelledby="bots-heading">
    <div :if={@bots == []} class="admin-bots-empty text-base-content/70 text-sm">
      {gettext("No bots configured yet.")}
    </div>

    <div
      :if={@bots != []}
      id="admin-bots-table-container"
      class="admin-bots-table-container overflow-x-auto"
      data-focus-target
    >
      <table id="admin-bots-table" class="admin-bots-table table table-zebra w-full">
        <thead>
          <tr>
            <th scope="col">{gettext("Bot")}</th>
            <th scope="col">{gettext("Feed URL")}</th>
            <th scope="col">{gettext("Boards")}</th>
            <th scope="col">{gettext("Status")}</th>
            <th scope="col">{gettext("Last Fetched")}</th>
            <th scope="col">{gettext("Next Fetch")}</th>
            <th scope="col">{gettext("Posts")}</th>
            <th scope="col">{gettext("Errors")}</th>
            <th scope="col">{gettext("Actions")}</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={bot <- @bots} id={"bot-#{bot.id}"} class="bot-row">
            <th scope="row" class="admin-bots-row-bot font-normal">
              <div class="flex items-center gap-2">
                <.avatar user={bot.user} size={36} decorative />
                <div>
                  <div class="admin-bots-row-display-name font-semibold">
                    {display_name(bot.user)}
                  </div>
                  <div class="admin-bots-row-username text-xs text-base-content/60">
                    @{bot.user.username}
                  </div>
                  <span class="badge badge-sm badge-ghost">{gettext("Bot")}</span>
                </div>
              </div>
            </th>
            <td>
              <a
                id={"admin-bots-feed-url-#{bot.id}"}
                href={bot.feed_url}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="admin-bots-feed-url link link-hover text-sm truncate max-w-xs block"
                title={bot.feed_url}
              >
                {String.slice(bot.feed_url, 0, 60)}{if String.length(bot.feed_url) > 60,
                  do: "…",
                  else: ""}
                <span class="sr-only">{gettext("(opens in new tab)")}</span>
              </a>
            </td>
            <td>
              <div class="flex flex-wrap gap-1">
                <%= for board <- Enum.filter(@boards, &(&1.id in bot.board_ids)) do %>
                  <span class="badge badge-sm badge-outline">{board.name}</span>
                <% end %>
              </div>
            </td>
            <td>
              <span
                id={"admin-bots-status-#{bot.id}"}
                class={[
                  "admin-bots-status badge badge-sm",
                  if(bot.active, do: "badge-success", else: "badge-warning")
                ]}
              >
                {cond do
                  bot.active -> gettext("Active")
                  stopped_by_failures?(bot) -> gettext("Stopped after failures")
                  true -> gettext("Inactive")
                end}
              </span>
            </td>
            <td class="text-sm text-base-content/70">
              <%= if bot.last_fetched_at do %>
                <time datetime={DateTime.to_iso8601(bot.last_fetched_at)}>
                  {format_datetime(bot.last_fetched_at)}
                </time>
              <% else %>
                {gettext("Never")}
              <% end %>
            </td>
            <td
              id={"admin-bots-next-fetch-#{bot.id}"}
              class="admin-bots-next-fetch text-sm text-base-content/70"
            >
              <%= cond do %>
                <% not bot.active -> %>
                  <span class="text-base-content/40">—</span>
                <% bot.next_fetch_at -> %>
                  <time datetime={datetime_attr(bot.next_fetch_at)}>
                    {format_datetime(bot.next_fetch_at)}
                  </time>
                <% true -> %>
                  {gettext("Soon")}
              <% end %>
            </td>
            <td id={"admin-bots-post-count-#{bot.id}"} class="admin-bots-post-count text-sm">
              {Map.get(@post_counts, bot.id, 0)}
            </td>
            <td>
              <%= if bot.error_count > 0 do %>
                <span
                  id={"admin-bots-error-count-#{bot.id}"}
                  class="admin-bots-error-count badge badge-sm badge-error"
                >
                  {ngettext("%{count} error", "%{count} errors", bot.error_count,
                    count: bot.error_count
                  )}
                </span>
                <p
                  :if={bot.last_error}
                  id={"admin-bots-last-error-#{bot.id}"}
                  class="admin-bots-last-error text-xs text-base-content/70 mt-1 max-w-xs break-words"
                >
                  {bot.last_error}
                </p>
              <% else %>
                <span class="text-base-content/40">—</span>
              <% end %>
            </td>
            <td>
              <div class="admin-bots-row-actions flex gap-1">
                <button
                  id={"admin-bots-edit-#{bot.id}"}
                  phx-click="edit"
                  phx-value-id={bot.id}
                  class="admin-bots-edit-btn btn btn-xs btn-ghost"
                  aria-label={gettext("Edit bot %{username}", username: bot.user.username)}
                >
                  {gettext("Edit")}
                </button>
                <button
                  id={"admin-bots-toggle-active-#{bot.id}"}
                  phx-click="toggle_active"
                  phx-value-id={bot.id}
                  class="admin-bots-toggle-active-btn btn btn-xs btn-ghost"
                  aria-label={
                    if bot.active,
                      do: gettext("Deactivate bot %{username}", username: bot.user.username),
                      else: gettext("Activate bot %{username}", username: bot.user.username)
                  }
                >
                  {if bot.active, do: gettext("Deactivate"), else: gettext("Activate")}
                </button>
                <button
                  :if={bot.active}
                  id={"admin-bots-fetch-now-#{bot.id}"}
                  phx-click="fetch_now"
                  phx-value-id={bot.id}
                  class="admin-bots-fetch-now-btn btn btn-xs btn-ghost"
                  aria-label={
                    gettext("Fetch now for bot %{username}", username: bot.user.username)
                  }
                >
                  {gettext("Fetch now")}
                </button>
                <button
                  id={"admin-bots-preview-#{bot.id}"}
                  phx-click="preview"
                  phx-value-id={bot.id}
                  class="admin-bots-preview-btn btn btn-xs btn-ghost"
                  aria-label={gettext("Dry run for bot %{username}", username: bot.user.username)}
                  title={gettext("Show what the next fetch would post, without posting anything")}
                >
                  {gettext("Dry run")}
                </button>
                <button
                  :if={bot.error_count > 0}
                  id={"admin-bots-reset-errors-#{bot.id}"}
                  phx-click="reset_errors"
                  phx-value-id={bot.id}
                  class="admin-bots-reset-errors-btn btn btn-xs btn-warning btn-outline"
                  aria-label={
                    gettext("Reset & Retry bot %{username}", username: bot.user.username)
                  }
                  title={gettext("Reset error count and trigger an immediate re-fetch")}
                >
                  {gettext("Reset & Retry")}
                </button>
                <button
                  id={"admin-bots-refresh-favicon-#{bot.id}"}
                  phx-click="refresh_favicon"
                  phx-value-id={bot.id}
                  class="admin-bots-refresh-favicon-btn btn btn-xs btn-ghost"
                  aria-label={
                    gettext("Refresh Favicon for bot %{username}", username: bot.user.username)
                  }
                  title={
                    gettext("Re-fetch favicon from the feed site and set it as the bot avatar")
                  }
                >
                  {gettext("Refresh Favicon")}
                </button>
                <button
                  id={"admin-bots-delete-#{bot.id}"}
                  phx-click="delete"
                  phx-value-id={bot.id}
                  data-confirm={
                    gettext("Delete this bot and its user account? This cannot be undone.")
                  }
                  class="admin-bots-delete-btn btn btn-xs btn-error btn-outline"
                  aria-label={gettext("Delete bot %{username}", username: bot.user.username)}
                >
                  {gettext("Delete")}
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <%!-- Dry run of the next fetch (Phase 7D): nothing is posted or recorded --%>
  <section
    :if={@preview}
    id="admin-bots-preview"
    class="admin-bots-preview card bg-base-200 shadow-md"
    aria-labelledby="admin-bots-preview-heading"
  >
    <div class="card-body">
      <div class="flex items-center justify-between gap-2">
        <h2
          id="admin-bots-preview-heading"
          class="admin-bots-preview-heading card-title"
          tabindex="-1"
        >
          {gettext("Dry run for @%{username}", username: @preview.bot.user.username)}
        </h2>
        <button
          id="admin-bots-preview-close"
          type="button"
          phx-click="close_preview"
          class="admin-bots-preview-close btn btn-ghost btn-sm"
        >
          {gettext("Close dry run")}
        </button>
      </div>
      <p id="admin-bots-preview-note" class="admin-bots-preview-note text-sm opacity-70">
        {gettext(
          "What the next fetch would do with each entry the feed lists now. Nothing is posted or recorded."
        )}
      </p>
      <p
        id="admin-bots-preview-status"
        class="admin-bots-preview-status text-sm"
        role="status"
      >
        <%= case @preview.result do %>
          <% :loading -> %>
            {gettext("Fetching the feed…")}
          <% {:ok, rows} -> %>
            {ngettext(
              "%{count} entry; %{post} would be posted.",
              "%{count} entries; %{post} would be posted.",
              length(rows),
              count: length(rows),
              post: Enum.count(rows, fn {_, d} -> d == :post end)
            )}
          <% {:error, :preview_failed} -> %>
            {gettext("The dry run did not finish.")}
          <% {:error, reason} -> %>
            {gettext("The feed could not be fetched: %{reason}", reason: preview_error(reason))}
        <% end %>
      </p>
      <ol
        :if={match?({:ok, [_ | _]}, @preview.result)}
        id="admin-bots-preview-list"
        class="admin-bots-preview-list space-y-2"
      >
        <li
          :for={{{entry, decision}, i} <- Enum.with_index(elem(@preview.result, 1))}
          id={"admin-bots-preview-entry-#{i}"}
          class={[
            "admin-bots-preview-entry flex flex-wrap items-baseline gap-2",
            "decision-#{decision}"
          ]}
        >
          <span class={[
            "admin-bots-preview-decision badge badge-sm",
            if(decision == :post, do: "badge-success", else: "badge-ghost")
          ]}>
            {decision_label(decision)}
          </span>
          <a
            :if={http_url?(entry.link)}
            href={entry.link}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="admin-bots-preview-title link link-hover min-w-0 break-words"
          >
            {entry.title}<span class="sr-only">{gettext("(opens in new tab)")}</span>
          </a>
          <span
            :if={!http_url?(entry.link)}
            class="admin-bots-preview-title min-w-0 break-words"
          >
            {entry.title}
          </span>
          <time
            :if={entry.published_at}
            datetime={datetime_attr(entry.published_at)}
            class="admin-bots-preview-date text-xs text-base-content/60"
          >
            {format_datetime(entry.published_at)}
          </time>
        </li>
      </ol>
    </div>
  </section>
</div>
