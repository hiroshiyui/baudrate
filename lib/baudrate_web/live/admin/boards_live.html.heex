<div id="admin-boards-page" class="admin-boards-page space-y-6">
  <div class="flex items-center justify-between">
    <h1 id="boards-heading" class="admin-boards-title text-2xl font-bold">
      {gettext("Board Management")}
    </h1>
    <button
      :if={!@show_form}
      id="admin-boards-new-btn"
      phx-click="new"
      class="admin-boards-new-btn btn btn-primary btn-sm"
    >
      {gettext("New Board")}
    </button>
  </div>

  <%!-- Board form (create / edit) --%>
  <div
    :if={@show_form}
    id="board-form-card"
    class="admin-boards-form-card card bg-base-200 shadow-md"
  >
    <div class="card-body">
      <h2 id="admin-boards-form-title" class="admin-boards-form-title card-title">
        {if @editing_board, do: gettext("Edit Board"), else: gettext("New Board")}
      </h2>

      <.form id="admin-boards-form" for={@form} phx-change="validate" phx-submit="save">
        <.input field={@form[:name]} type="text" label={gettext("Name")} required />

        <%= if @editing_board do %>
          <div class="fieldset mb-2">
            <label>
              <span class="label mb-1">{gettext("Slug")}</span>
              <input
                id="admin-boards-slug-display"
                type="text"
                value={@editing_board.slug}
                class="admin-boards-slug-display w-full input"
                disabled
              />
            </label>
            <p class="text-sm opacity-70 mt-1">
              {gettext("Slug cannot be changed after creation.")}
            </p>
          </div>
        <% else %>
          <.input field={@form[:slug]} type="text" label={gettext("Slug")} required />
        <% end %>

        <.input
          field={@form[:description]}
          type="textarea"
          label={gettext("Description")}
          rows="3"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <.input
            field={@form[:min_role_to_view]}
            type="select"
            label={gettext("Minimum role to view")}
            options={[
              {gettext("Guest (public)"), "guest"},
              {gettext("User"), "user"},
              {gettext("Moderator"), "moderator"},
              {gettext("Admin"), "admin"}
            ]}
          />

          <.input
            field={@form[:min_role_to_post]}
            type="select"
            label={gettext("Minimum role to post")}
            options={[
              {gettext("User"), "user"},
              {gettext("Moderator"), "moderator"},
              {gettext("Admin"), "admin"}
            ]}
          />

          <.input
            field={@form[:parent_id]}
            type="select"
            label={gettext("Parent Board")}
            prompt={gettext("None")}
            options={
              for board <- @boards,
                  !@editing_board || board.id != @editing_board.id,
                  do: {board.name, board.id}
            }
          />
        </div>

        <.input
          field={@form[:ap_enabled]}
          type="select"
          label={gettext("Federation")}
          options={[{gettext("Enabled"), true}, {gettext("Disabled"), false}]}
        />

        <.input
          field={@form[:ap_accept_policy]}
          type="select"
          label={gettext("Accept Policy")}
          options={[
            {gettext("Followers only"), "followers_only"},
            {gettext("Open"), "open"}
          ]}
        />

        <div class="flex justify-end gap-2 mt-4">
          <button
            id="admin-boards-form-cancel"
            type="button"
            phx-click="cancel"
            class="admin-boards-form-cancel btn"
          >
            {gettext("Cancel")}
          </button>
          <button
            id="admin-boards-form-save"
            type="submit"
            class="admin-boards-form-save btn btn-primary"
            phx-disable-with={gettext("Saving...")}
          >
            {gettext("Save")}
          </button>
        </div>
      </.form>
    </div>
  </div>

  <%!-- Board moderator management panel --%>
  <div
    :if={@managing_moderators_board}
    id="board-moderators-panel"
    class="admin-boards-moderators-panel card bg-base-200 shadow-md"
  >
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h2 id="admin-boards-moderators-title" class="admin-boards-moderators-title card-title">
          {gettext("Board Moderators")} &mdash; {@managing_moderators_board.name}
        </h2>
        <button
          id="admin-boards-moderators-close"
          phx-click="close_moderators"
          class="admin-boards-moderators-close btn btn-sm btn-ghost"
          aria-label={gettext("Close")}
        >
          <.icon name="hero-x-mark" class="size-4" />
        </button>
      </div>

      <%!-- Current moderators --%>
      <div
        :if={@board_moderators == []}
        class="admin-boards-moderators-empty text-base-content/70 py-2"
      >
        {gettext("No moderators assigned.")}
      </div>

      <div :if={@board_moderators != []} class="space-y-2">
        <div
          :for={bm <- @board_moderators}
          id={"admin-boards-moderator-#{bm.user.id}"}
          class="admin-boards-moderator flex items-center justify-between bg-base-100 rounded-lg p-3"
        >
          <div class="flex items-center gap-2">
            <span class="admin-boards-moderator-name font-medium">{bm.user.username}</span>
            <span class="badge badge-sm badge-ghost">{translate_role(bm.user.role.name)}</span>
          </div>
          <button
            id={"admin-boards-moderator-remove-#{bm.user.id}"}
            phx-click="remove_moderator"
            phx-value-user-id={bm.user.id}
            data-confirm={gettext("Remove this moderator?")}
            class="admin-boards-moderator-remove btn btn-sm btn-error btn-outline"
            aria-label={gettext("Remove moderator %{username}", username: bm.user.username)}
          >
            {gettext("Remove")}
          </button>
        </div>
      </div>

      <%!-- Add moderator --%>
      <div class="mt-4">
        <h3
          id="admin-boards-add-moderator-title"
          class="admin-boards-add-moderator-title text-sm font-semibold mb-2"
        >
          {gettext("Add Moderator")}
        </h3>
        <form id="admin-boards-mod-search-form" phx-change="search_mod_users" class="mb-2">
          <input
            id="admin-boards-mod-search-input"
            type="text"
            name="search[query]"
            value={@mod_search_query}
            placeholder={gettext("Search users...")}
            class="admin-boards-mod-search-input input input-bordered input-sm w-full"
            autocomplete="off"
            aria-label={gettext("Search users to add as moderator")}
            phx-debounce="300"
          />
        </form>
        <form
          :if={@active_users != []}
          id="admin-boards-add-moderator-form"
          phx-submit="add_moderator"
          class="flex gap-2"
        >
          <select
            id="admin-boards-add-moderator-select"
            name="user_id"
            class="admin-boards-add-moderator-select select select-bordered select-sm flex-1"
            required
            aria-label={gettext("Select moderator")}
          >
            <option value="">{gettext("Select a user...")}</option>
            <%= for user <- @active_users,
                    not Enum.any?(@board_moderators, &(&1.user.id == user.id)) do %>
              <option value={user.id}>{user.username} ({translate_role(user.role.name)})</option>
            <% end %>
          </select>
          <button
            id="admin-boards-add-moderator-submit"
            type="submit"
            class="admin-boards-add-moderator-submit btn btn-sm btn-primary"
            phx-disable-with={gettext("Adding...")}
          >
            {gettext("Add")}
          </button>
        </form>
      </div>
    </div>
  </div>

  <%!-- Moving a board's articles, so it can be deleted (7C) --%>
  <section
    :if={@moving_articles_board}
    id="admin-boards-move-articles"
    class="admin-boards-move-articles card bg-base-200 shadow-sm"
    aria-labelledby="admin-boards-move-articles-heading"
  >
    <div class="card-body">
      <h2
        id="admin-boards-move-articles-heading"
        class="admin-boards-move-articles-heading card-title"
      >
        {gettext("Move the articles of %{name}", name: @moving_articles_board.name)}
      </h2>
      <p class="admin-boards-move-articles-help text-sm text-base-content/70">
        {gettext(
          "Every article in this board moves to the board you choose, one at a time, as a moderator's move: into a board that federates it is announced there, and an article that stops being public is withdrawn from other servers. Then the board can be deleted."
        )}
      </p>
      <form
        id="admin-boards-move-articles-form"
        class="admin-boards-move-articles-form flex flex-wrap items-end gap-2"
        phx-submit="move_articles"
      >
        <label for="admin-boards-move-articles-target" class="fieldset">
          <span class="label">{gettext("Move to")}</span>
          <select
            id="admin-boards-move-articles-target"
            name="target_id"
            class="admin-boards-move-articles-target select select-sm"
            required
          >
            <option
              :for={board <- @boards}
              :if={board.id != @moving_articles_board.id}
              value={board.id}
            >
              {board.name}
            </option>
          </select>
        </label>
        <button
          type="submit"
          id="admin-boards-move-articles-submit"
          class="admin-boards-move-articles-submit btn btn-sm btn-primary"
          data-confirm={gettext("Move every article of this board?")}
        >
          {gettext("Move articles")}
        </button>
        <button
          type="button"
          id="admin-boards-move-articles-cancel"
          phx-click="move_articles_cancel"
          class="admin-boards-move-articles-cancel btn btn-sm btn-ghost"
        >
          {gettext("Cancel")}
        </button>
      </form>
    </div>
  </section>

  <%!-- Boards table --%>
  <div :if={@boards == []} class="admin-boards-empty text-base-content/70 text-center py-8">
    {gettext("No boards yet.")}
  </div>

  <div
    :if={@boards != []}
    id="admin-boards-table-container"
    class="admin-boards-table-container overflow-x-auto"
    data-focus-target
  >
    <table id="boards-table" class="admin-boards-table table" aria-labelledby="boards-heading">
      <thead>
        <tr>
          <th scope="col">{gettext("Name")}</th>
          <th scope="col">{gettext("Slug")}</th>
          <th scope="col">{gettext("Parent")}</th>
          <th scope="col">{gettext("View / Post")}</th>
          <th scope="col">{gettext("Order")}</th>
          <th scope="col">{gettext("Federation")}</th>
          <th scope="col">{gettext("Actions")}</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={board <- @boards} id={"board-#{board.id}"} class="admin-boards-row">
          <th scope="row" class="admin-boards-row-name font-medium">{board.name}</th>
          <td class="admin-boards-row-slug font-mono text-sm">{board.slug}</td>
          <td>{if board.parent, do: board.parent.name, else: gettext("None")}</td>
          <td>
            <span class={[
              "badge badge-sm",
              Board.public?(board) && "badge-success",
              !Board.public?(board) && "badge-warning"
            ]}>
              {translate_role(board.min_role_to_view)}
            </span>
            <span class="text-base-content/70 mx-1">/</span>
            <span class="badge badge-sm badge-info">
              {translate_role(board.min_role_to_post)}
            </span>
          </td>
          <td class="admin-boards-row-order">
            <div class="flex gap-1">
              <button
                :if={List.first(siblings_of(@boards, board.id)) != board.id}
                type="button"
                id={"admin-boards-move-up-#{board.id}"}
                phx-click="move"
                phx-value-id={board.id}
                phx-value-direction="up"
                class="admin-boards-move-up btn btn-xs btn-ghost"
                aria-label={gettext("Move %{name} up", name: board.name)}
              >
                <.icon name="hero-arrow-up" class="size-4" />
              </button>
              <button
                :if={List.last(siblings_of(@boards, board.id)) != board.id}
                type="button"
                id={"admin-boards-move-down-#{board.id}"}
                phx-click="move"
                phx-value-id={board.id}
                phx-value-direction="down"
                class="admin-boards-move-down btn btn-xs btn-ghost"
                aria-label={gettext("Move %{name} down", name: board.name)}
              >
                <.icon name="hero-arrow-down" class="size-4" />
              </button>
            </div>
          </td>
          <td>
            <span class={[
              "badge badge-sm",
              board.ap_enabled && "badge-info",
              !board.ap_enabled && "badge-ghost"
            ]}>
              {if board.ap_enabled, do: gettext("On"), else: gettext("Off")}
            </span>
          </td>
          <td class="admin-boards-row-actions">
            <div class="flex gap-1 flex-wrap">
              <button
                id={"admin-boards-edit-#{board.id}"}
                phx-click="edit"
                phx-value-id={board.id}
                class="admin-boards-edit-btn btn btn-sm btn-ghost"
                aria-label={gettext("Edit board %{name}", name: board.name)}
              >
                {gettext("Edit")}
              </button>
              <button
                id={"admin-boards-moderators-#{board.id}"}
                phx-click="manage_moderators"
                phx-value-id={board.id}
                class="admin-boards-moderators-btn btn btn-sm btn-ghost"
                aria-label={gettext("Moderators of board %{name}", name: board.name)}
                aria-expanded={
                  to_string(
                    @managing_moderators_board && @managing_moderators_board.id == board.id
                  )
                }
              >
                {gettext("Moderators")}
              </button>
              <.link
                :if={Board.federated?(board)}
                id={"admin-boards-follows-#{board.id}"}
                navigate={~p"/boards/#{board.slug}/follows"}
                class="admin-boards-follows-link btn btn-sm btn-ghost"
                aria-label={gettext("Follows of board %{name}", name: board.name)}
              >
                {gettext("Follows")}
              </.link>
              <button
                id={"admin-boards-move-articles-#{board.id}"}
                phx-click="move_articles_prompt"
                phx-value-id={board.id}
                class="admin-boards-move-articles-btn btn btn-sm btn-ghost"
                aria-label={gettext("Move articles of %{name}", name: board.name)}
              >
                {gettext("Move articles")}
              </button>
              <button
                id={"admin-boards-delete-#{board.id}"}
                phx-click="delete"
                phx-value-id={board.id}
                data-confirm={gettext("Are you sure you want to delete this board?")}
                class="admin-boards-delete-btn btn btn-sm btn-error btn-outline"
                aria-label={gettext("Delete board %{name}", name: board.name)}
              >
                {gettext("Delete")}
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
