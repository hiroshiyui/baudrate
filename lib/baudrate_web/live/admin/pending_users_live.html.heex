<div id="admin-pending-users-page" class="admin-pending-users-page space-y-6">
  <h1 id="admin-pending-users-heading" class="admin-pending-users-heading text-2xl font-bold">
    {gettext("Pending Users")}
  </h1>

  <div
    :if={@pending_users == []}
    id="admin-pending-users-empty"
    class="admin-pending-users-empty text-base-content/70 text-center py-8"
  >
    {gettext("No pending users.")}
  </div>

  <div
    :if={@pending_users != []}
    id="admin-pending-users-table-container"
    class="admin-pending-users-table-container overflow-x-auto"
    data-focus-target
  >
    <table
      id="admin-pending-users-table"
      class="admin-pending-users-table table"
      aria-labelledby="admin-pending-users-heading"
    >
      <thead>
        <tr>
          <th scope="col">{gettext("Username")}</th>
          <th scope="col">{gettext("Registered")}</th>
          <th scope="col"><span class="sr-only">{gettext("Actions")}</span></th>
        </tr>
      </thead>
      <tbody>
        <tr
          :for={user <- @pending_users}
          id={"admin-pending-users-row-#{user.id}"}
          class="admin-pending-users-row"
        >
          <th scope="row" class="admin-pending-users-row-username font-medium">
            {user.username}
          </th>
          <td>
            <time datetime={datetime_attr(user.inserted_at)}>
              {format_datetime(user.inserted_at)}
            </time>
          </td>
          <td class="admin-pending-users-row-actions">
            <div :if={@refusing != user.id} class="flex gap-2 justify-end">
              <button
                :if={@can_approve?}
                id={"admin-pending-users-approve-#{user.id}"}
                class="admin-pending-users-approve btn btn-sm btn-primary"
                phx-click="approve"
                phx-value-id={user.id}
                aria-label={gettext("Approve %{username}", username: user.username)}
              >
                {gettext("Approve")}
              </button>
              <button
                :if={@can_refuse?}
                id={"admin-pending-users-refuse-#{user.id}"}
                class="admin-pending-users-refuse btn btn-sm btn-ghost"
                phx-click="refuse_prompt"
                phx-value-id={user.id}
                aria-label={gettext("Refuse %{username}", username: user.username)}
              >
                {gettext("Refuse")}
              </button>
            </div>

            <form
              :if={@refusing == user.id}
              id={"admin-pending-users-refuse-form-#{user.id}"}
              class="admin-pending-users-refuse-form flex flex-wrap gap-2 items-center justify-end"
              phx-submit="refuse"
            >
              <label
                for={"admin-pending-users-refuse-reason-#{user.id}"}
                class="admin-pending-users-refuse-reason-label sr-only"
              >
                {gettext("Reason for refusing %{username}", username: user.username)}
              </label>
              <input
                type="text"
                id={"admin-pending-users-refuse-reason-#{user.id}"}
                name="reason"
                maxlength="500"
                autofocus
                class="admin-pending-users-refuse-reason input input-sm input-bordered min-w-0 w-48"
                placeholder={gettext("Reason (recorded in the log)")}
              />
              <button
                type="submit"
                id={"admin-pending-users-refuse-confirm-#{user.id}"}
                class="admin-pending-users-refuse-confirm btn btn-sm btn-error"
              >
                {gettext("Refuse")}
              </button>
              <button
                type="button"
                id={"admin-pending-users-refuse-cancel-#{user.id}"}
                class="admin-pending-users-refuse-cancel btn btn-sm btn-ghost"
                phx-click="refuse_cancel"
              >
                {gettext("Cancel")}
              </button>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
