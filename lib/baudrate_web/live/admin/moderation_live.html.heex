<div id="admin-moderation-page" class="admin-moderation-page space-y-6">
  <h1 id="admin-moderation-heading" class="admin-moderation-heading text-2xl font-bold">
    {gettext("Moderation Queue")}
  </h1>

  <%!-- Status Filter Toggle Buttons --%>
  <div
    id="admin-moderation-status-tabs"
    class="admin-moderation-status-tabs tabs tabs-boxed"
    role="toolbar"
    aria-label={gettext("Report status")}
  >
    <button
      id="admin-moderation-tab-open"
      class={["admin-moderation-status-tab tab", @status_filter == "open" && "tab-active"]}
      phx-click="filter"
      phx-value-status="open"
      aria-pressed={to_string(@status_filter == "open")}
    >
      {gettext("Open")}
    </button>
    <button
      id="admin-moderation-tab-resolved"
      class={["admin-moderation-status-tab tab", @status_filter == "resolved" && "tab-active"]}
      phx-click="filter"
      phx-value-status="resolved"
      aria-pressed={to_string(@status_filter == "resolved")}
    >
      {gettext("Resolved")}
    </button>
    <button
      id="admin-moderation-tab-dismissed"
      class={["admin-moderation-status-tab tab", @status_filter == "dismissed" && "tab-active"]}
      phx-click="filter"
      phx-value-status="dismissed"
      aria-pressed={to_string(@status_filter == "dismissed")}
    >
      {gettext("Dismissed")}
    </button>
  </div>

  <%!-- Bulk action bar (open reports only) --%>
  <div
    :if={@status_filter == "open" and @reports != []}
    id="admin-moderation-bulk-bar"
    class="admin-moderation-bulk-bar flex items-center gap-3 p-3 bg-base-200 rounded-lg"
  >
    <label>
      <input
        id="admin-moderation-select-all"
        class="admin-moderation-select-all checkbox checkbox-sm"
        type="checkbox"
        phx-click="toggle_select_all_reports"
        checked={
          MapSet.size(@selected_report_ids) > 0 and
            MapSet.subset?(MapSet.new(@reports, & &1.id), @selected_report_ids)
        }
        aria-label={gettext("Select all reports")}
      />
    </label>
    <span
      :if={MapSet.size(@selected_report_ids) > 0}
      id="admin-moderation-selected-count"
      class="admin-moderation-selected-count font-medium"
    >
      {ngettext(
        "%{count} report selected",
        "%{count} reports selected",
        MapSet.size(@selected_report_ids),
        count: MapSet.size(@selected_report_ids)
      )}
    </span>
    <button
      :if={MapSet.size(@selected_report_ids) > 0}
      id="admin-moderation-bulk-resolve"
      class="admin-moderation-bulk-resolve btn btn-sm btn-success"
      phx-click="show_bulk_resolve_modal"
    >
      {gettext("Resolve Selected")}
    </button>
    <button
      :if={MapSet.size(@selected_report_ids) > 0}
      id="admin-moderation-bulk-dismiss"
      class="admin-moderation-bulk-dismiss btn btn-sm btn-ghost"
      phx-click="bulk_dismiss"
      data-confirm={gettext("Dismiss all selected reports?")}
    >
      {gettext("Dismiss Selected")}
    </button>
  </div>

  <%!-- Reports --%>
  <div
    id="admin-moderation-reports"
    class="admin-moderation-reports space-y-4"
    data-focus-target
  >
    <div
      :if={@reports == []}
      id="admin-moderation-empty"
      class="admin-moderation-empty text-center py-8 opacity-70"
    >
      {gettext("No reports with status \"%{status}\".",
        status: translate_report_status(@status_filter)
      )}
    </div>

    <div
      :for={report <- @reports}
      id={"admin-moderation-report-#{report.id}"}
      class={[
        "admin-moderation-report report card bg-base-200 shadow-sm",
        @status_filter == "open" && "relative pl-12"
      ]}
    >
      <div :if={@status_filter == "open"} class="absolute top-4 left-4">
        <label>
          <input
            id={"admin-moderation-report-select-#{report.id}"}
            class="admin-moderation-report-select checkbox checkbox-sm"
            type="checkbox"
            phx-click="toggle_select_report"
            phx-value-id={report.id}
            checked={MapSet.member?(@selected_report_ids, report.id)}
            aria-label={gettext("Select report #%{id}", id: report.id)}
          />
        </label>
      </div>
      <div class="card-body">
        <div class="flex justify-between items-start">
          <div>
            <span class={[
              "badge badge-sm",
              report.status == "open" && "badge-warning",
              report.status == "resolved" && "badge-success",
              report.status == "dismissed" && "badge-ghost"
            ]}>
              {translate_report_status(report.status)}
            </span>
            <span class="text-sm opacity-70 ml-2">
              <time datetime={datetime_attr(report.inserted_at)}>
                {format_datetime(report.inserted_at)}
              </time>
            </span>
          </div>
          <div
            :if={report.reporter}
            id={"admin-moderation-report-reporter-#{report.id}"}
            class="admin-moderation-report-reporter text-sm opacity-70"
          >
            {gettext("Reported by %{name}", name: display_name(report.reporter))}
          </div>
          <div
            :if={report.reporter_remote_actor}
            id={"admin-moderation-report-remote-reporter-#{report.id}"}
            class="admin-moderation-report-remote-reporter text-sm opacity-70"
          >
            {gettext("Reported from %{domain} by %{name}",
              domain: report.reporter_remote_actor.domain,
              name: display_name(report.reporter_remote_actor)
            )}
          </div>
        </div>

        <div class="admin-moderation-report-reason mt-2">
          <p class="font-semibold">{gettext("Reason:")}</p>
          <p :if={report.reason != ""} class="whitespace-pre-wrap break-words">{report.reason}</p>
          <p
            :if={report.reason == ""}
            id={"admin-moderation-report-no-reason-#{report.id}"}
            class="admin-moderation-report-no-reason italic opacity-70"
          >
            {gettext("No reason given.")}
          </p>
        </div>

        <%!-- Reported Content --%>
        <div
          :if={report.article}
          class="admin-moderation-report-article mt-2 p-3 bg-base-300 rounded-lg"
        >
          <p class="text-sm font-semibold">{gettext("Reported Article:")}</p>
          <p>{report.article.title}</p>
          <button
            :if={report.status == "open" and is_nil(report.article.deleted_at)}
            id={"admin-moderation-delete-article-#{report.id}"}
            class="admin-moderation-delete-article btn btn-error btn-sm mt-1"
            phx-click="delete_content"
            phx-value-type="article"
            phx-value-id={report.article.id}
            data-confirm={gettext("Delete this article?")}
            aria-label={gettext("Delete Article: %{title}", title: report.article.title)}
          >
            {gettext("Delete Article")}
          </button>
        </div>

        <div
          :if={report.comment}
          class="admin-moderation-report-comment mt-2 p-3 bg-base-300 rounded-lg"
        >
          <p class="text-sm font-semibold">{gettext("Reported Comment:")}</p>
          <p class="text-sm">{String.slice(report.comment.body || "", 0..200)}</p>
          <button
            :if={report.status == "open" and is_nil(report.comment.deleted_at)}
            id={"admin-moderation-delete-comment-#{report.id}"}
            class="admin-moderation-delete-comment btn btn-error btn-sm mt-1"
            phx-click="delete_content"
            phx-value-type="comment"
            phx-value-id={report.comment.id}
            data-confirm={gettext("Delete this comment?")}
            aria-label={gettext("Delete Comment from report #%{id}", id: report.id)}
          >
            {gettext("Delete Comment")}
          </button>
        </div>

        <div
          :if={report.remote_actor}
          class="admin-moderation-report-actor mt-2 p-3 bg-base-300 rounded-lg"
        >
          <p class="text-sm font-semibold">{gettext("Reported Actor:")}</p>
          <p class="font-mono text-sm">{report.remote_actor.ap_id}</p>
          <p class="text-sm opacity-70">
            {display_name(report.remote_actor)}@{report.remote_actor.domain}
          </p>
        </div>

        <div
          :if={report.reported_user}
          class="admin-moderation-report-user mt-2 p-3 bg-base-300 rounded-lg"
        >
          <p class="text-sm font-semibold">{gettext("Reported User:")}</p>
          <p>
            {display_name(report.reported_user)}
            <span class="text-sm opacity-70">(@{report.reported_user.username})</span>
          </p>
        </div>

        <%!-- Resolution Info --%>
        <div
          :if={report.status in ["resolved", "dismissed"] and report.resolved_by}
          id={"admin-moderation-report-handled-by-#{report.id}"}
          class="admin-moderation-report-handled-by mt-2 text-sm opacity-70"
        >
          {if report.resolution_note,
            do:
              gettext("Handled by %{name} — %{note}",
                name: display_name(report.resolved_by),
                note: report.resolution_note
              ),
            else: gettext("Handled by %{name}", name: display_name(report.resolved_by))}
        </div>

        <%!-- Send Flag to Remote --%>
        <div :if={report.status == "open" and report.remote_actor} class="mt-2">
          <button
            id={"admin-moderation-send-flag-#{report.id}"}
            class="admin-moderation-send-flag btn btn-warning btn-sm"
            phx-click="send_flag"
            phx-value-id={report.id}
            data-confirm={
              gettext("Send a Flag report to %{domain}?", domain: report.remote_actor.domain)
            }
          >
            {gettext("Send Flag to %{domain}", domain: report.remote_actor.domain)}
          </button>
        </div>

        <%!-- Actions --%>
        <div :if={report.status == "open"} class="card-actions justify-end mt-4">
          <form
            id={"admin-moderation-resolve-form-#{report.id}"}
            class="admin-moderation-resolve-form flex gap-2 items-end"
            phx-submit="resolve"
          >
            <input type="hidden" name="report_id" value={report.id} />
            <input
              id={"admin-moderation-resolve-note-#{report.id}"}
              class="admin-moderation-resolve-note input input-bordered input-sm w-64"
              type="text"
              name="note"
              placeholder={gettext("Resolution note (optional)")}
              aria-label={gettext("Resolution note for report #%{id}", id: report.id)}
            />
            <button
              id={"admin-moderation-resolve-submit-#{report.id}"}
              class="admin-moderation-resolve-submit btn btn-success btn-sm"
              type="submit"
              phx-disable-with={gettext("Resolving...")}
              aria-label={gettext("Resolve report #%{id}", id: report.id)}
            >
              {gettext("Resolve")}
            </button>
          </form>
          <button
            id={"admin-moderation-dismiss-#{report.id}"}
            class="admin-moderation-dismiss btn btn-ghost btn-sm"
            phx-click="dismiss"
            phx-value-id={report.id}
            aria-label={gettext("Dismiss report #%{id}", id: report.id)}
          >
            {gettext("Dismiss")}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%!-- Bulk resolve modal --%>
<div
  :if={@show_bulk_resolve_modal}
  id="bulk-resolve-modal"
  class="admin-moderation-bulk-modal modal modal-open"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bulk-resolve-modal-title"
  phx-hook="FocusTrapHook"
  phx-window-keydown="cancel_bulk_resolve"
  phx-key="Escape"
>
  <div class="modal-box">
    <h3 id="bulk-resolve-modal-title" class="font-bold text-lg">
      {ngettext(
        "Resolve %{count} Report",
        "Resolve %{count} Reports",
        MapSet.size(@selected_report_ids),
        count: MapSet.size(@selected_report_ids)
      )}
    </h3>
    <div class="py-4">
      <form
        id="admin-moderation-bulk-note-form"
        class="admin-moderation-bulk-note-form"
        phx-change="update_bulk_resolve_note"
      >
        <label for="bulk-resolve-note" class="label">
          <span class="label-text">{gettext("Resolution note (optional)")}</span>
        </label>
        <textarea
          id="bulk-resolve-note"
          class="admin-moderation-bulk-note textarea textarea-bordered w-full"
          rows="3"
          name="note"
          phx-debounce="300"
        >{@bulk_resolve_note}</textarea>
      </form>
    </div>
    <div class="modal-action">
      <button
        id="admin-moderation-bulk-cancel"
        phx-click="cancel_bulk_resolve"
        class="admin-moderation-bulk-cancel btn"
      >{gettext("Cancel")}</button>
      <button
        id="admin-moderation-bulk-confirm"
        phx-click="confirm_bulk_resolve"
        class="admin-moderation-bulk-confirm btn btn-success"
        phx-disable-with={gettext("Resolving...")}
      >
        {gettext("Confirm Resolve")}
      </button>
    </div>
  </div>
  <div class="modal-backdrop" phx-click="cancel_bulk_resolve"></div>
</div>
