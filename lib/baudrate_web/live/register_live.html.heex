<div id="register-page" class="register-page mx-auto max-w-lg mt-10">
  <%!-- Recovery codes display (after successful registration) --%>
  <div :if={@recovery_codes} id="recovery-codes-section" class="space-y-4">
    <h1 id="recovery-codes-heading" class="text-2xl font-bold text-center mb-2">
      {gettext("Recovery Codes")}
    </h1>

    <div class="alert alert-warning">
      <.icon name="hero-exclamation-triangle" class="size-5" />
      <div>
        <p class="font-semibold">{gettext("Save these recovery codes now!")}</p>
        <p class="text-sm">
          {gettext(
            "These codes are the only way to recover your account if you lose your password. Each code can only be used once. Store them in a safe place."
          )}
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <ol
          id="recovery-codes-grid"
          class="recovery-codes-grid grid grid-cols-2 gap-2 font-mono text-sm"
          aria-label={gettext("Recovery Codes")}
        >
          <li
            :for={code <- @recovery_codes}
            id={"register-recovery-code-#{code}"}
            class="register-recovery-code bg-base-300 rounded px-3 py-1.5 text-center"
          >
            {code}
          </li>
        </ol>
      </div>
    </div>

    <button
      id="register-ack-codes"
      phx-click="ack_codes"
      class="register-ack-codes btn btn-primary w-full"
      phx-disable-with={gettext("Signing in...")}
    >
      {gettext("I have saved my recovery codes")}
    </button>

    <%!--
      Acknowledging the codes signs the new member in (P4-D2), through the
      same POST `LoginLive` uses. The token is minted on the click, not at
      registration: it is good for 60 seconds and writing down ten codes
      takes longer than that.
    --%>
    <form
      id="session-form"
      action="/auth/session"
      method="post"
      phx-trigger-action={@trigger_action}
    >
      <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
      <input type="hidden" name="token" value={@token} />
    </form>
  </div>

  <%!-- Registration form --%>
  <div :if={!@recovery_codes}>
    <h1 id="register-heading" class="text-2xl font-bold text-center mb-2">
      {gettext("Sign Up")}
    </h1>
    <p id="register-subtitle" class="register-subtitle text-center text-base-content/70 mb-8">
      {gettext("Create an account")}
    </p>

    <.form
      for={@form}
      id="register-form"
      phx-change="validate"
      phx-submit="submit"
      class="space-y-4"
    >
      <.input
        field={@form[:username]}
        label={gettext("Username")}
        required
        autocomplete="username"
      />

      <.input
        field={@form[:password]}
        type="password"
        label={gettext("Password")}
        required
        autocomplete="new-password"
      />

      <.input
        field={@form[:password_confirmation]}
        type="password"
        label={gettext("Confirm Password")}
        required
        autocomplete="new-password"
      />

      <.input
        :if={@registration_mode == "invite_only"}
        name="user[invite_code]"
        value={@invite_code_value}
        label={gettext("Invite Code")}
        required
        autocomplete="off"
      />

      <%!-- Password strength checklist --%>
      <.password_requirements id="password-strength" strength={@password_strength} />

      <p :if={@registration_mode == "approval_required"} class="text-sm text-base-content/70">
        {gettext("Your account is pending admin approval.")}
      </p>

      <p :if={@registration_mode == "invite_only"} class="text-sm text-base-content/70">
        {gettext("Registration requires an invite code.")}
      </p>

      <%!-- Terms notice --%>
      <div class="space-y-3">
        <div class="text-sm text-base-content/70 bg-base-200 rounded-lg p-3">
          {gettext(
            "I acknowledge that my activities (including IP address, user-agent, and operation history) are recorded, and I agree to comply with the laws of the country/region where this instance operates."
          )}
        </div>

        <div :if={@eua} id="register-eua" class="register-eua space-y-2">
          <p class="register-eua-label text-sm font-medium">{gettext("End User Agreement")}</p>
          <div class="register-eua-body bg-base-200 rounded-lg p-3 max-h-48 overflow-y-auto prose prose-sm max-w-none break-words">
            {BaudrateWeb.SafeHTML.markdown(@eua)}
          </div>
          <%!-- The scroll box is easy to skim past and impossible to find again
          after registering, so the full page is one click away from both. --%>
          <p class="register-eua-link-text text-sm">
            <.link id="register-eua-link" navigate={~p"/terms"} class="register-eua-link link">
              {gettext("Read the full terms of service")}
            </.link>
          </p>
        </div>

        <.input
          field={@form[:terms_accepted]}
          type="checkbox"
          label={gettext("I accept the above terms")}
        />
      </div>

      <button
        id="register-submit"
        type="submit"
        class="register-submit btn btn-primary w-full"
        phx-disable-with={gettext("Signing up...")}
      >
        {gettext("Sign Up")}
      </button>
    </.form>

    <nav id="register-help-nav" aria-label={gettext("Registration help")}>
      <p class="text-center text-sm mt-4">
        {gettext("Already have an account?")}
        <.link
          id="register-login-link"
          navigate="/login"
          class="register-login-link link link-primary"
        >
          {gettext("Sign In")}
        </.link>
      </p>
    </nav>
  </div>
</div>
