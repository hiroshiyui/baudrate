# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# ExDoc generated output (HTML, EPUB, etc.)
/doc/dist/
/doc/*.html
/doc/*.epub

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
baudrate-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/
# The service worker is an esbuild bundle of assets/js/service_worker.js, not
# a source file. It was tracked from the commit that introduced it, so the
# built copy — the one browsers actually run — could drift from its source
# with nothing to catch it. `mix assets.build` and `mix assets.deploy` produce
# it; the deploy runs the latter on the server.
/priv/static/service_worker.js
# Likewise an esbuild bundle, of assets/js/challenge_worker.js (P5-D1).
/priv/static/challenge_worker.js

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# Uploaded files (keep the uploads directory itself via .gitkeep)
/priv/static/uploads/avatars/
/priv/static/uploads/article_images/
/priv/static/uploads/link_preview_images/
/priv/static/uploads/media_cache/
/priv/static/uploads/media_cache_test*/

# TLS certificates
/priv/cert/

# Rust NIF build artifacts
/native/*/target/
/priv/native/

# Backup files
/backups/

# Ansible
ansible/*.retry

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Claude Code session-local state (e.g., scheduled-task lock).
/.claude/scheduled_tasks.lock

